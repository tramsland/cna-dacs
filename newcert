#Requires -Version 5.1
# Configure-TomcatSSL.ps1
# Generates a self-signed JKS certificate and configures Tomcat 10.1.x for HTTPS on port 443
# Targets remote Windows servers via WinRM. Run as administrator.
# Compatible with Windows PowerShell 5.1+

#region Parameters
param(
    # servers.txt in the same folder as this script is the default.
    # Each line: one server FQDN or hostname. Lines starting with # are comments.
    [string]$ServerList    = (Join-Path $PSScriptRoot "servers.txt"),

    [string]$TomcatHome    = "",          # Auto-detected if left blank
    [string]$KeystorePass  = "changeit",  # Password for the JKS keystore
    [string]$CertAlias     = "tomcat",    # Alias for the cert entry in the keystore
    [string]$CertOU        = "IT",
    [string]$CertO         = "MyOrg",
    [string]$CertL         = "Atlanta",
    [string]$CertST        = "GA",
    [string]$CertC         = "US",
    [int]   $CertValidDays = 3650,        # 10 years
    [int]   $HttpsPort     = 443,
    [switch]$RestartTomcat,               # Restart Tomcat service after configuring
    [switch]$Cluster,                     # Pause between servers for cluster-safe rollout

    # ── Rollback mode ────────────────────────────────────────────────────────
    [switch]$Rollback,                    # Restore files from a previous backup
    [string]$RollbackDir   = "",          # Path to _backup_<timestamp> folder; auto-selects latest if blank

    [System.Management.Automation.PSCredential]$Credential
)
#endregion

#region Helpers
function Write-Status {
    param([string]$Msg, [string]$Color = "White")
    $ts = Get-Date -Format "HH:mm:ss"
    Write-Host ("[$ts] $Msg") -ForegroundColor $Color
}

function Exit-Error {
    param([string]$Msg)
    Write-Status ("ERROR: $Msg") -Color Red
    exit 1
}
#endregion

#region Load server list
if (-not (Test-Path $ServerList)) {
    Write-Host "ERROR: Server list not found: $ServerList" -ForegroundColor Red
    Write-Host "Create a servers.txt file in the same directory as this script," -ForegroundColor Yellow
    Write-Host "with one server FQDN or hostname per line. Lines starting with # are comments." -ForegroundColor Yellow
    exit 1
}

$servers = @(
    Get-Content $ServerList |
    Where-Object { ($_ -notmatch '^\s*$') -and ($_ -notmatch '^\s*#') -and ($_ -notmatch '^\s*\[') } |
    ForEach-Object { $_.Trim() }
)

if ($servers.Count -eq 0) {
    Write-Host "ERROR: No servers found in $ServerList" -ForegroundColor Red
    exit 1
}

$modeLabel = if ($Rollback) { 'ROLLBACK' } else { 'CONFIGURE' }
Write-Status "=== Tomcat 10.1 SSL Configurator ===" -Color Cyan
Write-Status "Mode        : $modeLabel" -Color Cyan
Write-Status "Server list : $ServerList ($($servers.Count) server(s))" -Color Cyan
Write-Status "Port        : $HttpsPort" -Color Cyan
Write-Status ""
#endregion

#region Session params (credentials only; ComputerName added per-server)
$sessionParams = @{ ErrorAction = "Stop" }
if ($Credential) { $sessionParams["Credential"] = $Credential }
#endregion

# ── Per-server summary table ─────────────────────────────────────────────────
$summary = New-Object 'System.Collections.Generic.List[System.Management.Automation.PSObject]'

# ============================================================================
# SCRIPTBLOCKS — defined once outside the loop, reused per server
# ============================================================================

#region Rollback scriptblock
$rollbackScript = {
    param(
        [string]$TomcatHome,
        [string]$RollbackDir,
        [bool]  $DoRestart
    )

    $log = New-Object 'System.Collections.Generic.List[string]'
    function Log { param([string]$m) $log.Add($m); Write-Host $m }

    # ── Locate Tomcat home ───────────────────────────────────────────────────
    if (-not $TomcatHome) {

        # Method 1: derive from the Tomcat service PathName (most reliable)
        $tomcatWmiSvc = Get-WmiObject Win32_Service -Filter "Description LIKE '%Tomcat%' OR DisplayName LIKE '%Tomcat%' OR Name LIKE '%Tomcat%'" -ErrorAction SilentlyContinue |
                        Select-Object -First 1
        if ($tomcatWmiSvc -and $tomcatWmiSvc.PathName) {
            # PathName may be:  "C:\Tomcat\bin\Tomcat10.exe" //RS//ServiceName
            # or quoted:        "C:\Program Files\...\bin\Tomcat10.exe"
            $exePath = $tomcatWmiSvc.PathName -replace '^"?([^"]+\.exe).*$', '$1'
            $exePath = $exePath.Trim('"')
            $candidate = Split-Path $exePath -Parent   # \bin
            $candidate = Split-Path $candidate -Parent # Tomcat root
            if (Test-Path (Join-Path $candidate "conf\server.xml")) {
                $TomcatHome = $candidate
                Log "Tomcat home (from service PathName): $TomcatHome"
            }
        }

        # Method 2: Procrun registry Classpath
        if (-not $TomcatHome) {
            $regBases = @(
                "HKLM:\SOFTWARE\Apache Software Foundation\Procrun 2.0",
                "HKLM:\SOFTWARE\WOW6432Node\Apache Software Foundation\Procrun 2.0"
            )
            foreach ($base in $regBases) {
                if (Test-Path $base) {
                    $svcKeys = Get-ChildItem $base -ErrorAction SilentlyContinue |
                               Where-Object { $_.PSChildName -like "*Tomcat*" }
                    foreach ($key in $svcKeys) {
                        $javaKey = Join-Path $key.PSPath "Parameters\Java"
                        if (Test-Path $javaKey) {
                            $cp = (Get-ItemProperty $javaKey -ErrorAction SilentlyContinue).Classpath
                            if ($cp -match "^(.+?)\\lib\\") { $TomcatHome = $Matches[1]; break }
                        }
                    }
                }
                if ($TomcatHome) { break }
            }
            if ($TomcatHome) { Log "Tomcat home (from registry): $TomcatHome" }
        }

        # Method 3: CATALINA_HOME environment variable
        if (-not $TomcatHome) {
            $TomcatHome = [System.Environment]::GetEnvironmentVariable("CATALINA_HOME", "Machine")
            if ($TomcatHome) { Log "Tomcat home (from CATALINA_HOME): $TomcatHome" }
        }
    }
    if (-not $TomcatHome -or -not (Test-Path $TomcatHome)) {
        return [PSCustomObject]@{ Success=$false; Log=$log; Error="Could not locate Tomcat home. Use -TomcatHome." }
    }

    $confDir = Join-Path $TomcatHome "conf"

    # ── Find the backup folder ───────────────────────────────────────────────
    if (-not $RollbackDir) {
        $backups = @(
            Get-ChildItem -Path $confDir -Directory -Filter "_backup_*" -ErrorAction SilentlyContinue |
            Sort-Object Name -Descending
        )
        if ($backups.Count -eq 0) {
            return [PSCustomObject]@{ Success=$false; Log=$log; Error="No backup folders found in $confDir. Run without -Rollback first." }
        }
        $RollbackDir = $backups[0].FullName
    }
    if (-not (Test-Path $RollbackDir)) {
        return [PSCustomObject]@{ Success=$false; Log=$log; Error="Rollback directory not found: $RollbackDir" }
    }

    Log "Rolling back from: $RollbackDir"

    # ── Stop Tomcat before restoring files ───────────────────────────────────
    $tomcatWmi = Get-WmiObject Win32_Service -Filter "Description LIKE '%Tomcat%' OR DisplayName LIKE '%Tomcat%' OR Name LIKE '%Tomcat%'" -ErrorAction SilentlyContinue |
                 Select-Object -First 1
    $tomcatSvc = if ($tomcatWmi) { Get-Service -Name $tomcatWmi.Name -ErrorAction SilentlyContinue } else { $null }
    if ($tomcatSvc -and $tomcatSvc.Status -eq "Running") {
        Log "Stopping Tomcat service: $($tomcatSvc.Name) ..."
        Stop-Service -Name $tomcatSvc.Name -Force -ErrorAction SilentlyContinue
        Start-Sleep -Seconds 3
    }

    # ── Restore each file ────────────────────────────────────────────────────
    $restored = New-Object 'System.Collections.Generic.List[string]'

    $backedUpFiles = @(Get-ChildItem -Path $RollbackDir -File -ErrorAction SilentlyContinue)
    if ($backedUpFiles.Count -eq 0) {
        return [PSCustomObject]@{ Success=$false; Log=$log; Error="Backup folder is empty: $RollbackDir" }
    }
    foreach ($f in $backedUpFiles) {
        $dest = Join-Path $confDir $f.Name
        Copy-Item $f.FullName $dest -Force
        Log "  Restored: $dest"
        $restored.Add($f.Name)
    }

    # ── Remove new keystore if none existed before ───────────────────────────
    $newKeystore = Join-Path $confDir "keystore.jks"
    $restoredArr = @($restored)
    if ((Test-Path $newKeystore) -and ($restoredArr -notcontains "keystore.jks")) {
        Remove-Item $newKeystore -Force
        Log "  Removed new keystore.jks (no prior keystore existed)"
    }

    # ── Start Tomcat if requested ─────────────────────────────────────────────
    $restartNote = ""
    if ($DoRestart) {
        $tomcatWmi = Get-WmiObject Win32_Service -Filter "Description LIKE '%Tomcat%' OR DisplayName LIKE '%Tomcat%' OR Name LIKE '%Tomcat%'" -ErrorAction SilentlyContinue |
                     Select-Object -First 1
        $tomcatSvc = if ($tomcatWmi) { Get-Service -Name $tomcatWmi.Name -ErrorAction SilentlyContinue } else { $null }
        if ($tomcatSvc) {
            Log "Starting Tomcat service: $($tomcatSvc.Name) ..."
            Start-Service -Name $tomcatSvc.Name -ErrorAction SilentlyContinue
            Start-Sleep -Seconds 5
            $tomcatSvc = Get-Service -Name $tomcatSvc.Name -ErrorAction SilentlyContinue
            $restartNote = "Service '$($tomcatSvc.Name)' status after rollback: $($tomcatSvc.Status)"
            Log $restartNote
        } else {
            $restartNote = "WARNING: Could not find Tomcat service. Start manually."
            Log $restartNote
        }
    } else {
        Log "Restart skipped. Start Tomcat manually for rollback to take effect."
    }

    $restoredList = ($restoredArr | ForEach-Object { $_ }) -join ', '

    return [PSCustomObject]@{
        Success      = $true
        Log          = $log
        Error        = $null
        RollbackDir  = $RollbackDir
        RestoredList = $restoredList
        RestartNote  = $restartNote
    }
}
#endregion Rollback scriptblock

#region Configure scriptblock
$configureScript = {
    param(
        [string]$TomcatHome,
        [string]$KeystorePass,
        [string]$CertAlias,
        [string]$CertCN,
        [string]$CertOU,
        [string]$CertO,
        [string]$CertL,
        [string]$CertST,
        [string]$CertC,
        [int]   $CertValidDays,
        [int]   $HttpsPort,
        [bool]  $DoRestart
    )

    $log = New-Object 'System.Collections.Generic.List[string]'
    function Log { param([string]$m) $log.Add($m); Write-Host $m }

    # ── 1. Locate Tomcat home ────────────────────────────────────────────────
    if (-not $TomcatHome) {

        # Method 1: derive from the Tomcat service PathName (most reliable)
        $tomcatWmiSvc = Get-WmiObject Win32_Service -Filter "Description LIKE '%Tomcat%' OR DisplayName LIKE '%Tomcat%' OR Name LIKE '%Tomcat%'" -ErrorAction SilentlyContinue |
                        Select-Object -First 1
        if ($tomcatWmiSvc -and $tomcatWmiSvc.PathName) {
            # PathName may be:  "C:\Tomcat\bin\Tomcat10.exe" //RS//ServiceName
            # or quoted:        "C:\Program Files\...\bin\Tomcat10.exe"
            $exePath = $tomcatWmiSvc.PathName -replace '^"?([^"]+\.exe).*$', '$1'
            $exePath = $exePath.Trim('"')
            $candidate = Split-Path $exePath -Parent   # \bin
            $candidate = Split-Path $candidate -Parent # Tomcat root
            if (Test-Path (Join-Path $candidate "conf\server.xml")) {
                $TomcatHome = $candidate
                Log "Tomcat home (from service PathName): $TomcatHome"
            }
        }

        # Method 2: Procrun registry Classpath
        if (-not $TomcatHome) {
            $regBases = @(
                "HKLM:\SOFTWARE\Apache Software Foundation\Procrun 2.0",
                "HKLM:\SOFTWARE\WOW6432Node\Apache Software Foundation\Procrun 2.0"
            )
            foreach ($base in $regBases) {
                if (Test-Path $base) {
                    $svcKeys = Get-ChildItem $base -ErrorAction SilentlyContinue |
                               Where-Object { $_.PSChildName -like "*Tomcat*" }
                    foreach ($key in $svcKeys) {
                        $javaKey = Join-Path $key.PSPath "Parameters\Java"
                        if (Test-Path $javaKey) {
                            $cp = (Get-ItemProperty $javaKey -ErrorAction SilentlyContinue).Classpath
                            if ($cp -match "^(.+?)\\lib\\") { $TomcatHome = $Matches[1]; break }
                        }
                    }
                }
                if ($TomcatHome) { break }
            }
            if ($TomcatHome) { Log "Tomcat home (from registry): $TomcatHome" }
        }

        # Method 3: CATALINA_HOME environment variable
        if (-not $TomcatHome) {
            $TomcatHome = [System.Environment]::GetEnvironmentVariable("CATALINA_HOME", "Machine")
            if ($TomcatHome) { Log "Tomcat home (from CATALINA_HOME): $TomcatHome" }
        }

        # Method 4: last-resort Program Files scan
        if (-not $TomcatHome) {
            $candidates = @(
                Get-ChildItem "C:\Program Files\Apache Software Foundation" `
                    -Directory -ErrorAction SilentlyContinue |
                Where-Object { $_.Name -like "Tomcat*" } |
                Sort-Object Name -Descending
            )
            if ($candidates.Count -gt 0) {
                $TomcatHome = $candidates[0].FullName
                Log "Tomcat home (from Program Files scan): $TomcatHome"
            }
        }
    }
    if (-not $TomcatHome -or -not (Test-Path $TomcatHome)) {
        return [PSCustomObject]@{ Success=$false; Log=$log; Error="Could not locate Tomcat home. Use -TomcatHome." }
    }
    Log "Tomcat home   : $TomcatHome"

    # ── 2. Locate keytool.exe ────────────────────────────────────────────────
    $keytool = $null
    $javaHome = [System.Environment]::GetEnvironmentVariable("JAVA_HOME", "Machine")
    if ($javaHome) {
        $kt = Join-Path $javaHome "bin\keytool.exe"
        if (Test-Path $kt) { $keytool = $kt }
    }
    if (-not $keytool) {
        foreach ($sub in @("jre\bin\keytool.exe", "bin\keytool.exe")) {
            $kt = Join-Path $TomcatHome $sub
            if (Test-Path $kt) { $keytool = $kt; break }
        }
    }
    if (-not $keytool) {
        $ktCmd = Get-Command keytool.exe -ErrorAction SilentlyContinue
        if ($ktCmd) { $keytool = $ktCmd.Source }
    }
    if (-not $keytool) {
        return [PSCustomObject]@{ Success=$false; Log=$log; Error="keytool.exe not found. Ensure JDK/JRE is installed and JAVA_HOME is set." }
    }
    Log "keytool       : $keytool"

    # ── 3. Define paths ──────────────────────────────────────────────────────
    $confDir      = Join-Path $TomcatHome "conf"
    $keystoreFile = Join-Path $confDir "keystore.jks"
    Log "Keystore path : $keystoreFile"

    # ── 4. Pre-flight backup ─────────────────────────────────────────────────
    $backupStamp = Get-Date -Format "yyyyMMdd_HHmmss"
    $backupDir   = Join-Path $TomcatHome ("conf\_backup_" + $backupStamp)
    New-Item -ItemType Directory -Path $backupDir -Force | Out-Null
    Log "Backup directory: $backupDir"

    $filesToBackup = @(
        (Join-Path $confDir "server.xml"),
        (Join-Path $confDir "web.xml"),
        (Join-Path $confDir "context.xml"),
        (Join-Path $confDir "keystore.jks")
    )
    foreach ($f in $filesToBackup) {
        if (Test-Path $f) {
            Copy-Item $f $backupDir -Force
            Log "  Backed up: $f"
        }
    }
    Log "Backup complete."

    # ── 5. Generate self-signed JKS certificate ──────────────────────────────
    if (Test-Path $keystoreFile) {
        Log "Existing keystore found — removing for fresh generation."
        Remove-Item $keystoreFile -Force
    }

    $dname = "CN=$CertCN, OU=$CertOU, O=$CertO, L=$CertL, ST=$CertST, C=$CertC"
    Log "Generating self-signed cert: $dname"

    # Use the call operator (&) instead of Start-Process so PowerShell handles
    # argument quoting correctly — Start-Process splits on spaces/commas inside
    # the -dname value, breaking the distinguished name into separate tokens.
    $keytoolErr = "$env:TEMP\keytool_err.txt"
    & $keytool -genkeypair `
        -alias     $CertAlias `
        -keyalg    RSA `
        -keysize   2048 `
        -validity  $CertValidDays `
        -keystore  $keystoreFile `
        -storepass $KeystorePass `
        -keypass   $KeystorePass `
        -dname     $dname `
        -storetype JKS 2> $keytoolErr

    $keytoolExit = $LASTEXITCODE
    if ($keytoolExit -ne 0) {
        $errText = Get-Content $keytoolErr -Raw -ErrorAction SilentlyContinue
        return [PSCustomObject]@{ Success=$false; Log=$log; Error="keytool failed (exit $keytoolExit): $errText" }
    }
    if (-not (Test-Path $keystoreFile)) {
        return [PSCustomObject]@{ Success=$false; Log=$log; Error="Keystore file was not created." }
    }
    Log "Keystore created successfully."

    # ── 6. Edit server.xml ───────────────────────────────────────────────────
    $serverXml = Join-Path $confDir "server.xml"
    if (-not (Test-Path $serverXml)) {
        return [PSCustomObject]@{ Success=$false; Log=$log; Error="server.xml not found at $serverXml" }
    }

    [xml]$xml = Get-Content $serverXml -Raw

    # 6a. Update redirectPort on the HTTP connector
    $httpConn = $xml.Server.Service.Connector |
                Where-Object { ($_.port -eq "80" -or $_.port -eq "8080") -and $_.SSLEnabled -ne "true" } |
                Select-Object -First 1
    if ($httpConn) {
        $httpConn.redirectPort = "$HttpsPort"
        Log "Updated redirectPort on HTTP connector (port $($httpConn.port)) to $HttpsPort"
    } else {
        Log "WARNING: Could not find HTTP connector to update redirectPort."
    }

    # 6b. Remove any existing connector on this HTTPS port
    $xmlSvc = $xml.Server.Service
    $existingHttps = @($xmlSvc.Connector | Where-Object { $_.port -eq "$HttpsPort" })
    foreach ($old in $existingHttps) {
        Log "Removing existing Connector on port $HttpsPort"
        $xmlSvc.RemoveChild($old) | Out-Null
    }

    # 6c. Build new Tomcat 10.1 HTTPS Connector
    $newConn = $xml.CreateElement("Connector")
    $newConn.SetAttribute("port",              "$HttpsPort")
    $newConn.SetAttribute("protocol",          "org.apache.coyote.http11.Http11NioProtocol")
    $newConn.SetAttribute("maxThreads",        "150")
    $newConn.SetAttribute("SSLEnabled",        "true")
    $newConn.SetAttribute("scheme",            "https")
    $newConn.SetAttribute("secure",            "true")
    $newConn.SetAttribute("connectionTimeout", "20000")

    $sslHostConfig = $xml.CreateElement("SSLHostConfig")
    $certificate   = $xml.CreateElement("Certificate")
    $certificate.SetAttribute("certificateKeystoreFile",     $keystoreFile)
    $certificate.SetAttribute("certificateKeystorePassword", $KeystorePass)
    $certificate.SetAttribute("certificateKeyAlias",         $CertAlias)
    $certificate.SetAttribute("type",                        "RSA")

    $sslHostConfig.AppendChild($certificate) | Out-Null
    $newConn.AppendChild($sslHostConfig)     | Out-Null
    $xmlSvc.AppendChild($newConn)            | Out-Null
    Log "Added HTTPS Connector on port $HttpsPort to server.xml"

    # 6d. Save server.xml
    $xmlSettings = New-Object System.Xml.XmlWriterSettings
    $xmlSettings.Indent             = $true
    $xmlSettings.IndentChars        = "  "
    $xmlSettings.Encoding           = [System.Text.Encoding]::UTF8
    $xmlSettings.OmitXmlDeclaration = $false

    $xmlWriter = [System.Xml.XmlWriter]::Create($serverXml, $xmlSettings)
    $xml.Save($xmlWriter)
    $xmlWriter.Close()
    Log "server.xml saved."

    # ── 7. Optionally restart Tomcat ─────────────────────────────────────────
    $restartNote = ""
    if ($DoRestart) {
        $tomcatWmi = Get-WmiObject Win32_Service -Filter "Description LIKE '%Tomcat%' OR DisplayName LIKE '%Tomcat%' OR Name LIKE '%Tomcat%'" -ErrorAction SilentlyContinue |
                     Select-Object -First 1
        $svc = if ($tomcatWmi) { Get-Service -Name $tomcatWmi.Name -ErrorAction SilentlyContinue } else { $null }
        if ($svc) {
            Log "Restarting Tomcat service: $($svc.Name) ..."
            Restart-Service -Name $svc.Name -Force -ErrorAction SilentlyContinue
            Start-Sleep -Seconds 5
            $svc = Get-Service -Name $svc.Name -ErrorAction SilentlyContinue
            $restartNote = "Service '$($svc.Name)' status after restart: $($svc.Status)"
            Log $restartNote
        } else {
            $restartNote = "WARNING: Could not find Tomcat service to restart. Restart manually."
            Log $restartNote
        }
    } else {
        Log "Restart skipped. Restart Tomcat manually for changes to take effect."
    }

    return [PSCustomObject]@{
        Success      = $true
        Log          = $log
        Error        = $null
        TomcatHome   = $TomcatHome
        KeystoreFile = $keystoreFile
        HttpsPort    = $HttpsPort
        BackupDir    = $backupDir
        RestartNote  = $restartNote
    }
}
#endregion Configure scriptblock

# ── Cluster pause helper ──────────────────────────────────────────────────────
# Returns: 'next' | 'quit' | 'rollback'
function Invoke-ClusterPause {
    param(
        [string]$CompletedServer,
        [string]$NextServer,
        [int]   $CurrentIndex,
        [int]   $TotalCount
    )

    $isLast = ($CurrentIndex -eq $TotalCount)

    Write-Host ""
    Write-Host ("  ┌─────────────────────────────────────────────────────┐") -ForegroundColor DarkCyan
    Write-Host ("  │  CLUSTER PAUSE — server $CurrentIndex of $TotalCount complete" + (" " * [Math]::Max(0, 23 - "$CurrentIndex of $TotalCount".Length)) + "│") -ForegroundColor DarkCyan
    Write-Host ("  │  Completed : $CompletedServer") -ForegroundColor DarkCyan
    if (-not $isLast) {
        Write-Host ("  │  Next      : $NextServer") -ForegroundColor DarkCyan
    }
    Write-Host ("  ├─────────────────────────────────────────────────────┤") -ForegroundColor DarkCyan
    if ($isLast) {
        Write-Host ("  │  [ENTER] Finish   [R] Rollback all   [Q] Quit      │") -ForegroundColor Yellow
    } else {
        Write-Host ("  │  [ENTER] Next     [R] Rollback all   [Q] Quit      │") -ForegroundColor Yellow
    }
    Write-Host ("  └─────────────────────────────────────────────────────┘") -ForegroundColor DarkCyan
    Write-Host ""

    while ($true) {
        $key = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
        switch ($key.Character.ToString().ToUpper()) {
            ""  { return "next"     }  # Enter
            "R" { return "rollback" }
            "Q" { return "quit"     }
            default {
                # Also handle Enter (VirtualKeyCode 13)
                if ($key.VirtualKeyCode -eq 13) { return "next" }
            }
        }
    }
}

$serverIndex = 0

# ============================================================================
# MAIN LOOP — one iteration per server
# ============================================================================
foreach ($ComputerName in $servers) {

    $serverIndex++
    $nextServer = if ($serverIndex -lt $servers.Count) { $servers[$serverIndex] } else { $null }

    # ── Detect localhost ─────────────────────────────────────────────────────
    $localNames = @(
        "localhost", "127.0.0.1", "::1",
        $env:COMPUTERNAME,
        ($env:COMPUTERNAME + "." + $env:USERDNSDOMAIN)
    )
    $isLocal = $localNames -contains $ComputerName

    # ── Resolve FQDN for cert CN ─────────────────────────────────────────────
    $CertCN = $ComputerName
    try { $CertCN = [System.Net.Dns]::GetHostEntry($ComputerName).HostName } catch {}

    $localTag = if ($isLocal) { "  [LOCAL]" } else { "" }
    Write-Status "----------------------------------------" -Color DarkCyan
    Write-Status "Server $serverIndex of $($servers.Count) : $ComputerName  (CN: $CertCN)$localTag" -Color Cyan

    # ── Open PSSession (remote only) ─────────────────────────────────────────
    $session = $null
    if ($isLocal) {
        Write-Status "  Running locally (no PSSession needed)." -Color Gray
    } else {
        try {
            $session = New-PSSession -ComputerName $ComputerName @sessionParams
        } catch {
            Write-Status "  ERROR: Could not open PSSession - $_" -Color Red
            $summary.Add([PSCustomObject]@{ Server=$ComputerName; Status="SESSION FAILED"; Detail=$_.ToString() })
            continue
        }
    }

    # ── ROLLBACK ─────────────────────────────────────────────────────────────
    if ($Rollback) {
        $rbArgs = @($TomcatHome, $RollbackDir, $RestartTomcat.IsPresent)
        if ($isLocal) {
            $rbResult = Invoke-Command -ScriptBlock $rollbackScript -ArgumentList $rbArgs
        } else {
            $rbResult = Invoke-Command -Session $session -ScriptBlock $rollbackScript -ArgumentList $rbArgs
            Remove-PSSession $session -ErrorAction SilentlyContinue
        }

        Write-Status ""
        if ($rbResult.Success) {
            Write-Status "=== ROLLBACK COMPLETE : $ComputerName ===" -Color Green
            Write-Status "Restored from : $($rbResult.RollbackDir)"  -Color Cyan
            Write-Status "Files restored: $($rbResult.RestoredList)"  -Color Cyan
            if ($rbResult.RestartNote) { Write-Status $rbResult.RestartNote -Color Yellow }
            $summary.Add([PSCustomObject]@{ Server=$ComputerName; Status="ROLLED BACK"; Detail=$rbResult.RollbackDir })
        } else {
            Write-Status "=== ROLLBACK FAILED : $ComputerName ===" -Color Red
            Write-Status $rbResult.Error -Color Red
            $summary.Add([PSCustomObject]@{ Server=$ComputerName; Status="ROLLBACK FAILED"; Detail=$rbResult.Error })
        }
        Write-Status ""
        Write-Status "--- Remote log ---" -Color Gray
        foreach ($line in $rbResult.Log) { Write-Status "  $line" -Color Gray }

        if ($Cluster) {
            $choice = Invoke-ClusterPause -CompletedServer $ComputerName -NextServer $nextServer `
                          -CurrentIndex $serverIndex -TotalCount $servers.Count
            if ($choice -eq "quit") {
                Write-Status "Quit requested. Stopping." -Color Yellow
                break
            } elseif ($choice -eq "rollback") {
                Write-Status "Rollback-all requested — re-run with -Rollback to restore all servers." -Color Yellow
                break
            }
        }
        continue
    }

    # ── CONFIGURE ────────────────────────────────────────────────────────────
    $cfgArgs = @(
        $TomcatHome, $KeystorePass, $CertAlias, $CertCN,
        $CertOU, $CertO, $CertL, $CertST, $CertC,
        $CertValidDays, $HttpsPort, $RestartTomcat.IsPresent
    )
    if ($isLocal) {
        $result = Invoke-Command -ScriptBlock $configureScript -ArgumentList $cfgArgs
    } else {
        $result = Invoke-Command -Session $session -ScriptBlock $configureScript -ArgumentList $cfgArgs
        Remove-PSSession $session -ErrorAction SilentlyContinue
    }

    Write-Status ""
    if ($result.Success) {
        Write-Status "=== SUCCESS : $ComputerName ===" -Color Green
        Write-Status "Tomcat Home   : $($result.TomcatHome)"   -Color Cyan
        Write-Status "Keystore      : $($result.KeystoreFile)"  -Color Cyan
        Write-Status "HTTPS Port    : $($result.HttpsPort)"     -Color Cyan
        Write-Status "Backup Dir    : $($result.BackupDir)"     -Color Cyan
        Write-Status "  Rollback cmd: .\Configure-TomcatSSL.ps1 -Rollback [-RollbackDir '<path>'] [-RestartTomcat]" -Color DarkCyan
        if ($result.RestartNote) { Write-Status $result.RestartNote -Color Yellow }
        $summary.Add([PSCustomObject]@{ Server=$ComputerName; Status="OK"; Detail=$result.BackupDir })
    } else {
        Write-Status "=== FAILED : $ComputerName ===" -Color Red
        Write-Status $result.Error -Color Red
        $summary.Add([PSCustomObject]@{ Server=$ComputerName; Status="FAILED"; Detail=$result.Error })
    }

    Write-Status ""
    Write-Status "--- Remote log ---" -Color Gray
    foreach ($line in $result.Log) { Write-Status "  $line" -Color Gray }

    if ($Cluster) {
        $choice = Invoke-ClusterPause -CompletedServer $ComputerName -NextServer $nextServer `
                      -CurrentIndex $serverIndex -TotalCount $servers.Count
        if ($choice -eq "quit") {
            Write-Status "Quit requested. Stopping after $serverIndex of $($servers.Count) servers." -Color Yellow
            break
        } elseif ($choice -eq "rollback") {
            Write-Status "Rollback-all requested — re-run with -Rollback to restore all servers processed so far." -Color Yellow
            break
        }
        # "next" falls through to next iteration
    }

} # end foreach server

# ── Final summary ─────────────────────────────────────────────────────────────
Write-Status ""
Write-Status "=======================================" -Color Cyan
Write-Status "  SUMMARY  ($($servers.Count) server(s) processed)" -Color Cyan
Write-Status "=======================================" -Color Cyan
foreach ($row in $summary) {
    $color = "Yellow"
    if ($row.Status -eq "OK" -or $row.Status -eq "ROLLED BACK") {
        $color = "Green"
    }
    if ($row.Status -eq "FAILED" -or $row.Status -eq "ROLLBACK FAILED" -or $row.Status -eq "SESSION FAILED") {
        $color = "Red"
    }
    Write-Status ("  {0,-40} [{1}]  {2}" -f $row.Server, $row.Status, $row.Detail) -Color $color
}
Write-Status "=======================================" -Color Cyan
