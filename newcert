#Requires -Version 5.1
<#
.SYNOPSIS
    Generates a self-signed JKS certificate and configures Tomcat 10.1.x for HTTPS.

.DESCRIPTION
    Targets remote Windows servers via WinRM. Run as administrator.
    Compatible with Windows PowerShell 5.1. Supports interactive and
    non-interactive hosts (VS Code, SSH, remoting) via fallback-safe prompting.

.PARAMETER ServerList
    Path to a text file with one server FQDN or hostname per line.
    Lines starting with # are treated as comments. Defaults to servers.txt
    in the same directory as this script.

.PARAMETER TomcatHome
    Explicit path to Tomcat home. Auto-detected if omitted.

.PARAMETER KeystorePass
    Password for the JKS keystore. Defaults to 'changeit'.

.PARAMETER CertAlias
    Alias for the cert entry in the keystore. Defaults to 'tomcat'.

.PARAMETER CertOU
    Certificate Organizational Unit field. Defaults to 'IT'.

.PARAMETER CertO
    Certificate Organization field. Defaults to 'MyOrg'.

.PARAMETER CertL
    Certificate Locality (city) field. Defaults to 'Atlanta'.

.PARAMETER CertST
    Certificate State field. Defaults to 'GA'.

.PARAMETER CertC
    Certificate Country field. Defaults to 'US'.

.PARAMETER CertValidDays
    Certificate validity in days. Defaults to 3650 (10 years).

.PARAMETER HttpsPort
    HTTPS port to configure on Tomcat. Defaults to 443.

.PARAMETER RestartTomcat
    Switch. Restart the Tomcat service after configuring or rolling back.

.PARAMETER Rollback
    Switch. Restore server.xml, web.xml, context.xml, and keystore from backup.

.PARAMETER RollbackDir
    Explicit path to a _backup_<timestamp> folder. Auto-selects latest if omitted.

.PARAMETER Credential
    PSCredential used for WinRM connections to remote servers.

.EXAMPLE
    # Configure all servers in servers.txt
    .\Configure-TomcatSSL.ps1

.EXAMPLE
    # Configure and restart Tomcat on each server
    .\Configure-TomcatSSL.ps1 -RestartTomcat

.EXAMPLE
    # Rollback the latest backup on all servers
    .\Configure-TomcatSSL.ps1 -Rollback

.EXAMPLE
    # Rollback a specific backup folder on all servers
    .\Configure-TomcatSSL.ps1 -Rollback -RollbackDir "C:\Tomcat\conf\_backup_20260101_120000"
#>

#region Parameters
param(
    [string]$ServerList    = (Join-Path $PSScriptRoot "servers.txt"),
    [string]$TomcatHome    = "",
    [string]$KeystorePass  = "changeit",
    [string]$CertAlias     = "tomcat",
    [string]$CertOU        = "IT",
    [string]$CertO         = "MyOrg",
    [string]$CertL         = "Atlanta",
    [string]$CertST        = "GA",
    [string]$CertC         = "US",
    [int]   $CertValidDays = 3650,
    [int]   $HttpsPort     = 443,
    [switch]$RestartTomcat,
    [switch]$Rollback,
    [string]$RollbackDir   = "",
    [System.Management.Automation.PSCredential]$Credential
)
#endregion Parameters

#region Helper functions

function Write-Status {
    param(
        [string]$Msg,
        [string]$Color = "White"
    )
    $ts = Get-Date -Format "HH:mm:ss"
    Write-Host ("[$ts] $Msg") -ForegroundColor $Color
}

# Fallback-safe single-key prompt.
# Returns one uppercase char: "N" (next/Enter), "R" (rollback all), or "Q" (quit).
# Works in interactive consoles, VS Code, SSH, and WinRM.
# NOTE: $input is a reserved automatic variable in PS 5.1 — never use it as a variable name.
function Read-ClusterChoice {
    try {
        if ($null -ne $Host.UI.RawUI -and $Host.Name -ne 'ServerRemoteHost') {
            $key = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
            return $key.Character.ToString().ToUpper()
        }
    }
    catch {
        # RawUI not available in this host type — fall through to Read-Host
    }

    $rawInput = (Read-Host "  Enter choice (ENTER=Next, R=Rollback all, Q=Quit)").Trim().ToUpper()
    if ([string]::IsNullOrEmpty($rawInput)) {
        return "N"
    }
    return $rawInput.Substring(0, 1)
}

# Dispatch a scriptblock to run either locally or in an existing PSSession.
# Reads $script:isLocal and $script:session from the caller's scope.
function Invoke-Targeted {
    param(
        [scriptblock]$ScriptBlock,
        [object[]]$ArgumentList
    )
    if ($script:isLocal) {
        return Invoke-Command -ScriptBlock $ScriptBlock -ArgumentList $ArgumentList
    }
    else {
        return Invoke-Command -Session $script:session -ScriptBlock $ScriptBlock -ArgumentList $ArgumentList
    }
}

#endregion Helper functions

#region Validate server list

if (-not (Test-Path $ServerList)) {
    Write-Host "ERROR: Server list not found: $ServerList" -ForegroundColor Red
    Write-Host "Create a servers.txt file in the same directory as this script," -ForegroundColor Yellow
    Write-Host "with one server FQDN or hostname per line. Lines starting with # are comments." -ForegroundColor Yellow
    exit 1
}

$servers = @(
    Get-Content $ServerList |
    Where-Object { ($_ -notmatch '^\s*$') -and ($_ -notmatch '^\s*#') } |
    ForEach-Object { $_.Trim() }
)

if ($servers.Count -eq 0) {
    Write-Host "ERROR: No servers found in $ServerList" -ForegroundColor Red
    exit 1
}

$modeLabel = if ($Rollback) { 'ROLLBACK' } else { 'CONFIGURE' }
Write-Status "=== Tomcat 10.1 SSL Configurator ===" -Color Cyan
Write-Status "Mode        : $modeLabel" -Color Cyan
Write-Status "Server list : $ServerList ($($servers.Count) server(s))" -Color Cyan
Write-Status "Port        : $HttpsPort" -Color Cyan
Write-Status ""

#endregion Validate server list

#region WinRM session params

$sessionParams = @{ ErrorAction = "Stop" }
if ($Credential) {
    $sessionParams["Credential"] = $Credential
}

#endregion WinRM session params

# Per-server result accumulator
$summary = New-Object 'System.Collections.Generic.List[System.Management.Automation.PSObject]'

# =============================================================================
# LOCATE-TOMCAT SCRIPTBLOCK
#
# PS 5.1 REMOTING NOTE: Scriptblock objects do not survive serialization across
# a PSSession boundary. To share reusable logic with remote scriptblocks, we
# capture the body as a plain [string] ($locateTomcatStr) and pass that string
# as a parameter. Inside the remote scriptblock, [scriptblock]::Create() turns
# it back into a callable scriptblock. This is the only PS 5.1-safe pattern.
# =============================================================================

$locateTomcatDef = {
    param([string]$TomcatHome)

    # Method 1: Windows service PathName (most reliable)
    if (-not $TomcatHome) {
        $svc = Get-WmiObject Win32_Service `
            -Filter "Description LIKE '%Tomcat%' OR DisplayName LIKE '%Tomcat%' OR Name LIKE '%Tomcat%'" `
            -ErrorAction SilentlyContinue | Select-Object -First 1
        if ($svc -and $svc.PathName) {
            $exe  = ($svc.PathName -replace '^"?([^"]+\.exe).*$', '$1').Trim('"')
            $root = Split-Path (Split-Path $exe -Parent) -Parent
            if (Test-Path (Join-Path $root "conf\server.xml")) {
                $TomcatHome = $root
            }
        }
    }

    # Method 2: Procrun registry entries
    if (-not $TomcatHome) {
        $regBases = @(
            "HKLM:\SOFTWARE\Apache Software Foundation\Procrun 2.0",
            "HKLM:\SOFTWARE\WOW6432Node\Apache Software Foundation\Procrun 2.0"
        )
        foreach ($base in $regBases) {
            if (Test-Path $base) {
                $keys = Get-ChildItem $base -ErrorAction SilentlyContinue |
                        Where-Object { $_.PSChildName -like "*Tomcat*" }
                foreach ($key in $keys) {
                    $javaKey = Join-Path $key.PSPath "Parameters\Java"
                    if (Test-Path $javaKey) {
                        $cp = (Get-ItemProperty $javaKey -ErrorAction SilentlyContinue).Classpath
                        if ($cp -match "^(.+?)\\lib\\") {
                            $TomcatHome = $Matches[1]
                            break
                        }
                    }
                }
            }
            if ($TomcatHome) { break }
        }
    }

    # Method 3: CATALINA_HOME environment variable
    if (-not $TomcatHome) {
        $TomcatHome = [System.Environment]::GetEnvironmentVariable("CATALINA_HOME", "Machine")
    }

    # Method 4: Program Files scan
    if (-not $TomcatHome) {
        $asfPath = "C:\Program Files\Apache Software Foundation"
        if (Test-Path $asfPath) {
            $found = Get-ChildItem $asfPath -Directory -ErrorAction SilentlyContinue |
                     Where-Object { $_.Name -like "Tomcat*" } |
                     Sort-Object Name -Descending |
                     Select-Object -First 1
            if ($found) {
                $TomcatHome = $found.FullName
            }
        }
    }

    return $TomcatHome
}

# Serialize to string so it can cross the remoting boundary safely
$locateTomcatStr = $locateTomcatDef.ToString()

# =============================================================================
# ROLLBACK SCRIPTBLOCK
# =============================================================================

$rollbackScript = {
    param(
        [string]$TomcatHome,
        [string]$RollbackDir,
        [bool]  $DoRestart,
        [string]$LocateFnStr
    )

    $log = New-Object 'System.Collections.Generic.List[string]'
    function Write-Log {
        param([string]$m)
        $log.Add($m)
        Write-Host $m
    }

    # Reconstruct the locate function from its serialized string
    $locateFn = [scriptblock]::Create($LocateFnStr)

    # Locate Tomcat home
    $TomcatHome = & $locateFn $TomcatHome
    if (-not $TomcatHome -or -not (Test-Path $TomcatHome)) {
        return [PSCustomObject]@{
            Success      = $false
            Log          = $log
            Error        = "Could not locate Tomcat home. Use -TomcatHome."
            RollbackDir  = ""
            RestoredList = ""
            RestartNote  = ""
        }
    }
    Write-Log "Tomcat home: $TomcatHome"

    $confDir = Join-Path $TomcatHome "conf"

    # Find backup folder — use latest if none specified
    if (-not $RollbackDir) {
        $latest = Get-ChildItem -Path $confDir -Directory -Filter "_backup_*" `
                  -ErrorAction SilentlyContinue |
                  Sort-Object Name -Descending |
                  Select-Object -First 1
        if (-not $latest) {
            return [PSCustomObject]@{
                Success      = $false
                Log          = $log
                Error        = "No backup folders found in $confDir. Run without -Rollback first."
                RollbackDir  = ""
                RestoredList = ""
                RestartNote  = ""
            }
        }
        $RollbackDir = $latest.FullName
    }

    if (-not (Test-Path $RollbackDir)) {
        return [PSCustomObject]@{
            Success      = $false
            Log          = $log
            Error        = "Rollback directory not found: $RollbackDir"
            RollbackDir  = ""
            RestoredList = ""
            RestartNote  = ""
        }
    }
    Write-Log "Rolling back from: $RollbackDir"

    # Stop Tomcat before restoring files
    $stoppedSvcName = $null
    $svcWmi = Get-WmiObject Win32_Service `
        -Filter "Description LIKE '%Tomcat%' OR DisplayName LIKE '%Tomcat%' OR Name LIKE '%Tomcat%'" `
        -ErrorAction SilentlyContinue | Select-Object -First 1
    if ($svcWmi) {
        $svc = Get-Service -Name $svcWmi.Name -ErrorAction SilentlyContinue
        if ($svc -and $svc.Status -eq "Running") {
            Write-Log "Stopping Tomcat service: $($svc.Name)"
            Stop-Service -Name $svc.Name -Force -ErrorAction SilentlyContinue
            Start-Sleep -Seconds 3
            $stoppedSvcName = $svc.Name
        }
    }

    # Restore files
    $backedUpFiles = @(Get-ChildItem -Path $RollbackDir -File -ErrorAction SilentlyContinue)
    if ($backedUpFiles.Count -eq 0) {
        return [PSCustomObject]@{
            Success      = $false
            Log          = $log
            Error        = "Backup folder is empty: $RollbackDir"
            RollbackDir  = $RollbackDir
            RestoredList = ""
            RestartNote  = ""
        }
    }

    $restoredNames = New-Object 'System.Collections.Generic.List[string]'
    foreach ($f in $backedUpFiles) {
        $dest = Join-Path $confDir $f.Name
        Copy-Item -LiteralPath $f.FullName -Destination $dest -Force
        Write-Log "  Restored: $dest"
        $restoredNames.Add($f.Name)
    }

    # Remove new keystore if it was not in the backup (i.e. we added it)
    $newKeystore = Join-Path $confDir "keystore.jks"
    if ((Test-Path $newKeystore) -and (-not $restoredNames.Contains("keystore.jks"))) {
        Remove-Item $newKeystore -Force
        Write-Log "  Removed new keystore.jks (none existed in backup)"
    }

    # Optionally restart Tomcat
    $restartNote = ""
    if ($DoRestart) {
        $svcName = $stoppedSvcName
        if (-not $svcName) {
            $svcWmi2 = Get-WmiObject Win32_Service `
                -Filter "Description LIKE '%Tomcat%' OR DisplayName LIKE '%Tomcat%' OR Name LIKE '%Tomcat%'" `
                -ErrorAction SilentlyContinue | Select-Object -First 1
            if ($svcWmi2) { $svcName = $svcWmi2.Name }
        }
        if ($svcName) {
            Write-Log "Starting Tomcat service: $svcName"
            Start-Service -Name $svcName -ErrorAction SilentlyContinue
            Start-Sleep -Seconds 5
            $svcObj = Get-Service -Name $svcName -ErrorAction SilentlyContinue
            $restartNote = "Service '$svcName' status after rollback: $($svcObj.Status)"
            Write-Log $restartNote
        }
        else {
            $restartNote = "WARNING: Could not find Tomcat service to start. Start manually."
            Write-Log $restartNote
        }
    }
    else {
        Write-Log "Restart skipped. Start Tomcat manually for rollback to take effect."
    }

    return [PSCustomObject]@{
        Success      = $true
        Log          = $log
        Error        = $null
        RollbackDir  = $RollbackDir
        RestoredList = ($restoredNames -join ", ")
        RestartNote  = $restartNote
    }
}

# =============================================================================
# CONFIGURE SCRIPTBLOCK
# =============================================================================

$configureScript = {
    param(
        [string]$TomcatHome,
        [string]$KeystorePass,
        [string]$CertAlias,
        [string]$CertCN,
        [string]$CertOU,
        [string]$CertO,
        [string]$CertL,
        [string]$CertST,
        [string]$CertC,
        [int]   $CertValidDays,
        [int]   $HttpsPort,
        [bool]  $DoRestart,
        [string]$LocateFnStr
    )

    $log = New-Object 'System.Collections.Generic.List[string]'
    function Write-Log {
        param([string]$m)
        $log.Add($m)
        Write-Host $m
    }

    # Reconstruct the locate function from its serialized string
    $locateFn = [scriptblock]::Create($LocateFnStr)

    # ── 1. Locate Tomcat home ────────────────────────────────────────────────
    $TomcatHome = & $locateFn $TomcatHome
    if (-not $TomcatHome -or -not (Test-Path $TomcatHome)) {
        return [PSCustomObject]@{
            Success      = $false
            Log          = $log
            Error        = "Could not locate Tomcat home. Use -TomcatHome."
            TomcatHome   = ""
            KeystoreFile = ""
            HttpsPort    = $HttpsPort
            BackupDir    = ""
            RestartNote  = ""
        }
    }
    Write-Log "Tomcat home   : $TomcatHome"

    # ── 2. Locate keytool.exe ────────────────────────────────────────────────
    $keytool = $null

    $javaHome = [System.Environment]::GetEnvironmentVariable("JAVA_HOME", "Machine")
    if ($javaHome) {
        $kt = Join-Path $javaHome "bin\keytool.exe"
        if (Test-Path $kt) { $keytool = $kt }
    }

    if (-not $keytool) {
        foreach ($sub in @("jre\bin\keytool.exe", "bin\keytool.exe")) {
            $kt = Join-Path $TomcatHome $sub
            if (Test-Path $kt) {
                $keytool = $kt
                break
            }
        }
    }

    if (-not $keytool) {
        $ktCmd = Get-Command keytool.exe -ErrorAction SilentlyContinue
        if ($ktCmd) { $keytool = $ktCmd.Source }
    }

    if (-not $keytool) {
        return [PSCustomObject]@{
            Success      = $false
            Log          = $log
            Error        = "keytool.exe not found. Ensure JDK/JRE is installed and JAVA_HOME is set."
            TomcatHome   = $TomcatHome
            KeystoreFile = ""
            HttpsPort    = $HttpsPort
            BackupDir    = ""
            RestartNote  = ""
        }
    }
    Write-Log "keytool       : $keytool"

    # ── 3. Define paths ──────────────────────────────────────────────────────
    $confDir      = Join-Path $TomcatHome "conf"
    $keystoreFile = Join-Path $confDir "keystore.jks"
    Write-Log "Keystore path : $keystoreFile"

    # ── 4. Pre-flight backup ─────────────────────────────────────────────────
    $backupStamp = Get-Date -Format "yyyyMMdd_HHmmss"
    $backupDir   = Join-Path $confDir ("_backup_" + $backupStamp)
    New-Item -ItemType Directory -Path $backupDir -Force | Out-Null
    Write-Log "Backup dir    : $backupDir"

    foreach ($fileName in @("server.xml", "web.xml", "context.xml", "keystore.jks")) {
        $src = Join-Path $confDir $fileName
        if (Test-Path $src) {
            Copy-Item -LiteralPath $src -Destination $backupDir -Force
            Write-Log "  Backed up: $src"
        }
    }
    Write-Log "Backup complete."

    # ── 5. Generate self-signed JKS certificate ──────────────────────────────
    if (Test-Path $keystoreFile) {
        Write-Log "Removing existing keystore for fresh generation."
        Remove-Item $keystoreFile -Force
    }

    $dname      = "CN=$CertCN, OU=$CertOU, O=$CertO, L=$CertL, ST=$CertST, C=$CertC"
    $keytoolErr = Join-Path $env:TEMP ("keytool_err_" + $PID + ".txt")
    Write-Log "Generating cert: $dname"

    # Use the call operator (&) so PowerShell handles -dname quoting correctly.
    # Start-Process splits on spaces/commas inside the DN value, which breaks it.
    & $keytool `
        -genkeypair `
        -alias     $CertAlias `
        -keyalg    RSA `
        -keysize   2048 `
        -validity  $CertValidDays `
        -keystore  $keystoreFile `
        -storepass $KeystorePass `
        -keypass   $KeystorePass `
        -dname     $dname `
        -storetype JKS 2>$keytoolErr

    if ($LASTEXITCODE -ne 0) {
        $errText = ""
        if (Test-Path $keytoolErr) {
            $errText = Get-Content $keytoolErr -Raw -ErrorAction SilentlyContinue
        }
        return [PSCustomObject]@{
            Success      = $false
            Log          = $log
            Error        = "keytool failed (exit $LASTEXITCODE): $errText"
            TomcatHome   = $TomcatHome
            KeystoreFile = ""
            HttpsPort    = $HttpsPort
            BackupDir    = $backupDir
            RestartNote  = ""
        }
    }

    if (-not (Test-Path $keystoreFile)) {
        return [PSCustomObject]@{
            Success      = $false
            Log          = $log
            Error        = "Keystore file was not created after keytool ran."
            TomcatHome   = $TomcatHome
            KeystoreFile = ""
            HttpsPort    = $HttpsPort
            BackupDir    = $backupDir
            RestartNote  = ""
        }
    }

    Remove-Item $keytoolErr -Force -ErrorAction SilentlyContinue
    Write-Log "Keystore created successfully."

    # ── 6. Edit server.xml ───────────────────────────────────────────────────
    $serverXml = Join-Path $confDir "server.xml"
    if (-not (Test-Path $serverXml)) {
        return [PSCustomObject]@{
            Success      = $false
            Log          = $log
            Error        = "server.xml not found at: $serverXml"
            TomcatHome   = $TomcatHome
            KeystoreFile = $keystoreFile
            HttpsPort    = $HttpsPort
            BackupDir    = $backupDir
            RestartNote  = ""
        }
    }

    [xml]$xml = Get-Content $serverXml -Raw
    $xmlSvc   = $xml.Server.Service

    # 6a. Update redirectPort on the HTTP connector
    $httpConn = $xmlSvc.Connector |
                Where-Object { ($_.port -eq "80" -or $_.port -eq "8080") -and $_.SSLEnabled -ne "true" } |
                Select-Object -First 1
    if ($httpConn) {
        $httpConn.redirectPort = [string]$HttpsPort
        Write-Log "Updated redirectPort on HTTP connector (port $($httpConn.port)) to $HttpsPort"
    }
    else {
        Write-Log "WARNING: HTTP connector not found. redirectPort not updated."
    }

    # 6b. Remove any existing connector on the target HTTPS port
    $existingHttps = @($xmlSvc.Connector | Where-Object { $_.port -eq [string]$HttpsPort })
    foreach ($old in $existingHttps) {
        Write-Log "Removing existing Connector on port $HttpsPort"
        $xmlSvc.RemoveChild($old) | Out-Null
    }

    # 6c. Build Tomcat 10.1 HTTPS Connector with nested SSLHostConfig / Certificate
    $newConn = $xml.CreateElement("Connector")
    $newConn.SetAttribute("port",              [string]$HttpsPort)
    $newConn.SetAttribute("protocol",          "org.apache.coyote.http11.Http11NioProtocol")
    $newConn.SetAttribute("maxThreads",        "150")
    $newConn.SetAttribute("SSLEnabled",        "true")
    $newConn.SetAttribute("scheme",            "https")
    $newConn.SetAttribute("secure",            "true")
    $newConn.SetAttribute("connectionTimeout", "20000")

    $sslHostConfig = $xml.CreateElement("SSLHostConfig")

    $certificate = $xml.CreateElement("Certificate")
    $certificate.SetAttribute("certificateKeystoreFile",     $keystoreFile)
    $certificate.SetAttribute("certificateKeystorePassword", $KeystorePass)
    $certificate.SetAttribute("certificateKeyAlias",         $CertAlias)
    $certificate.SetAttribute("type",                        "RSA")

    $sslHostConfig.AppendChild($certificate) | Out-Null
    $newConn.AppendChild($sslHostConfig)     | Out-Null
    $xmlSvc.AppendChild($newConn)            | Out-Null
    Write-Log "Added HTTPS Connector on port $HttpsPort to server.xml"

    # 6d. Save server.xml — UTF-8 with XML declaration, indented
    $xmlSettings                    = New-Object System.Xml.XmlWriterSettings
    $xmlSettings.Indent             = $true
    $xmlSettings.IndentChars        = "  "
    $xmlSettings.Encoding           = [System.Text.Encoding]::UTF8
    $xmlSettings.OmitXmlDeclaration = $false

    $xmlWriter = [System.Xml.XmlWriter]::Create($serverXml, $xmlSettings)
    $xml.Save($xmlWriter)
    $xmlWriter.Close()
    Write-Log "server.xml saved."

    # ── 7. Optionally restart Tomcat ─────────────────────────────────────────
    $restartNote = ""
    if ($DoRestart) {
        $svcWmi = Get-WmiObject Win32_Service `
            -Filter "Description LIKE '%Tomcat%' OR DisplayName LIKE '%Tomcat%' OR Name LIKE '%Tomcat%'" `
            -ErrorAction SilentlyContinue | Select-Object -First 1
        if ($svcWmi) {
            $svc = Get-Service -Name $svcWmi.Name -ErrorAction SilentlyContinue
            if ($svc) {
                Write-Log "Restarting Tomcat service: $($svc.Name)"
                Restart-Service -Name $svc.Name -Force -ErrorAction SilentlyContinue
                Start-Sleep -Seconds 5
                $svc = Get-Service -Name $svc.Name -ErrorAction SilentlyContinue
                $restartNote = "Service '$($svc.Name)' status after restart: $($svc.Status)"
                Write-Log $restartNote
            }
            else {
                $restartNote = "WARNING: Could not retrieve Tomcat service object. Restart manually."
                Write-Log $restartNote
            }
        }
        else {
            $restartNote = "WARNING: Could not find Tomcat service. Restart manually."
            Write-Log $restartNote
        }
    }
    else {
        Write-Log "Restart skipped. Restart Tomcat manually for changes to take effect."
    }

    return [PSCustomObject]@{
        Success      = $true
        Log          = $log
        Error        = $null
        TomcatHome   = $TomcatHome
        KeystoreFile = $keystoreFile
        HttpsPort    = $HttpsPort
        BackupDir    = $backupDir
        RestartNote  = $restartNote
    }
}

# =============================================================================
# MAIN LOOP
# =============================================================================

$rollbackAllRequested = $false

for ($i = 0; $i -lt $servers.Count; $i++) {

    $ComputerName = $servers[$i]

    # Detect localhost — stored in script: scope so Invoke-Targeted can read it
    $localNames = @(
        "localhost",
        "127.0.0.1",
        "::1",
        $env:COMPUTERNAME,
        "$($env:COMPUTERNAME).$($env:USERDNSDOMAIN)"
    )
    $script:isLocal = $localNames -contains $ComputerName

    # Resolve FQDN for cert CN
    $CertCN = $ComputerName
    try {
        $CertCN = [System.Net.Dns]::GetHostEntry($ComputerName).HostName
    }
    catch { }

    $localTag = if ($script:isLocal) { "  [LOCAL]" } else { "" }
    Write-Status "---------------------------------------------" -Color DarkCyan
    Write-Status "Server $($i + 1)/$($servers.Count) : $ComputerName  (CN: $CertCN)$localTag" -Color Cyan

    # Open PSSession for remote servers — stored in script: scope for Invoke-Targeted
    $script:session = $null
    if (-not $script:isLocal) {
        try {
            $script:session = New-PSSession -ComputerName $ComputerName @sessionParams
        }
        catch {
            Write-Status "  ERROR: Could not open PSSession - $_" -Color Red
            $summary.Add([PSCustomObject]@{
                Server = $ComputerName
                Status = "SESSION FAILED"
                Detail = $_.ToString()
            })
            continue
        }
    }
    else {
        Write-Status "  Running locally (no PSSession needed)." -Color Gray
    }

    # ── ROLLBACK ─────────────────────────────────────────────────────────────
    if ($Rollback -or $rollbackAllRequested) {

        $rbResult = Invoke-Targeted -ScriptBlock $rollbackScript -ArgumentList @(
            $TomcatHome,
            $RollbackDir,
            [bool]$RestartTomcat.IsPresent,
            $locateTomcatStr
        )

        if ($script:session) {
            Remove-PSSession $script:session -ErrorAction SilentlyContinue
            $script:session = $null
        }

        Write-Status ""
        if ($rbResult.Success) {
            Write-Status "=== ROLLBACK COMPLETE : $ComputerName ===" -Color Green
            Write-Status "  Restored from : $($rbResult.RollbackDir)" -Color Cyan
            Write-Status "  Files         : $($rbResult.RestoredList)" -Color Cyan
            if ($rbResult.RestartNote) {
                Write-Status "  $($rbResult.RestartNote)" -Color Yellow
            }
            $summary.Add([PSCustomObject]@{
                Server = $ComputerName
                Status = "ROLLED BACK"
                Detail = $rbResult.RollbackDir
            })
        }
        else {
            Write-Status "=== ROLLBACK FAILED : $ComputerName ===" -Color Red
            Write-Status "  $($rbResult.Error)" -Color Red
            $summary.Add([PSCustomObject]@{
                Server = $ComputerName
                Status = "ROLLBACK FAILED"
                Detail = $rbResult.Error
            })
        }

        Write-Status "--- Remote log ---" -Color Gray
        foreach ($line in $rbResult.Log) {
            Write-Status "  $line" -Color Gray
        }
        continue
    }

    # ── CONFIGURE ────────────────────────────────────────────────────────────

    $result = Invoke-Targeted -ScriptBlock $configureScript -ArgumentList @(
        $TomcatHome,
        $KeystorePass,
        $CertAlias,
        $CertCN,
        $CertOU,
        $CertO,
        $CertL,
        $CertST,
        $CertC,
        [int]$CertValidDays,
        [int]$HttpsPort,
        [bool]$RestartTomcat.IsPresent,
        $locateTomcatStr
    )

    if ($script:session) {
        Remove-PSSession $script:session -ErrorAction SilentlyContinue
        $script:session = $null
    }

    Write-Status ""
    if ($result.Success) {
        Write-Status "=== SUCCESS : $ComputerName ===" -Color Green
        Write-Status "  Tomcat Home : $($result.TomcatHome)" -Color Cyan
        Write-Status "  Keystore    : $($result.KeystoreFile)" -Color Cyan
        Write-Status "  HTTPS Port  : $($result.HttpsPort)" -Color Cyan
        Write-Status "  Backup Dir  : $($result.BackupDir)" -Color Cyan
        Write-Status "  Rollback    : .\Configure-TomcatSSL.ps1 -Rollback [-RollbackDir '<path>'] [-RestartTomcat]" -Color DarkCyan
        if ($result.RestartNote) {
            Write-Status "  $($result.RestartNote)" -Color Yellow
        }
        $summary.Add([PSCustomObject]@{
            Server = $ComputerName
            Status = "OK"
            Detail = $result.BackupDir
        })
    }
    else {
        Write-Status "=== FAILED : $ComputerName ===" -Color Red
        Write-Status "  $($result.Error)" -Color Red
        $summary.Add([PSCustomObject]@{
            Server = $ComputerName
            Status = "FAILED"
            Detail = $result.Error
        })
    }

    Write-Status "--- Remote log ---" -Color Gray
    foreach ($line in $result.Log) {
        Write-Status "  $line" -Color Gray
    }

    # ── Cluster pause — shown between servers, not after the last one ─────────
    if ($i -lt ($servers.Count - 1)) {

        $nextServer   = $servers[$i + 1]
        $completedNum = $i + 1

        Write-Host ""
        Write-Host "+-----------------------------------------------------+" -ForegroundColor Cyan
        Write-Host ("| CLUSTER PAUSE -- server {0} of {1} complete" -f $completedNum, $servers.Count).PadRight(53) + "|" -ForegroundColor Cyan
        Write-Host ("| Completed : " + $ComputerName).PadRight(53) + "|" -ForegroundColor Cyan
        Write-Host ("| Next      : " + $nextServer).PadRight(53) + "|" -ForegroundColor Cyan
        Write-Host "+-----------------------------------------------------+" -ForegroundColor Cyan
        Write-Host "|  [ENTER] Next     [R] Rollback all   [Q] Quit      |" -ForegroundColor Cyan
        Write-Host "+-----------------------------------------------------+" -ForegroundColor Cyan
        Write-Host ""

        $choice = Read-ClusterChoice

        if ($choice -eq "Q") {
            Write-Status "Quit requested. Exiting." -Color Yellow
            break
        }
        elseif ($choice -eq "R") {
            Write-Status "Rollback-all requested -- switching to rollback mode for remaining servers." -Color Yellow
            $rollbackAllRequested = $true
        }
        # Any other key (N or bare Enter) falls through and continues to next server
    }

} # end main for loop

# =============================================================================
# FINAL SUMMARY
# =============================================================================

Write-Status ""
Write-Status "=======================================" -Color Cyan
Write-Status "  SUMMARY  ($($servers.Count) server(s) processed)" -Color Cyan
Write-Status "=======================================" -Color Cyan

foreach ($row in $summary) {
    if ($row.Status -eq "OK" -or $row.Status -eq "ROLLED BACK") {
        $color = "Green"
    }
    elseif ($row.Status -eq "FAILED" -or $row.Status -eq "ROLLBACK FAILED" -or $row.Status -eq "SESSION FAILED") {
        $color = "Red"
    }
    else {
        $color = "Yellow"
    }
    Write-Status ("  {0,-42} [{1}]  {2}" -f $row.Server, $row.Status, $row.Detail) -Color $color
}

Write-Status "=======================================" -Color Cyan
