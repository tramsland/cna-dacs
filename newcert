#Requires -Version 5.1
# Configure-TomcatSSL.ps1
# Generates a self-signed JKS certificate with SAN entries for all cluster nodes,
# distributes the keystore to every node, exports a per-node .cer file (named by FQDN),
# and configures Tomcat 10.1.x for HTTPS on port 443.
# Each Tomcat instance gets its own timestamped backup and can be rolled back independently.
# Targets remote Windows servers via WinRM. Run as administrator.
# Compatible with Windows PowerShell 5.1+

#region Parameters
param(
    # servers.txt in the same folder as this script is the default.
    # Each line: one server FQDN or hostname. Lines starting with # are comments.
    [string]$ServerList    = (Join-Path $PSScriptRoot "servers.txt"),

    [string]$TomcatHome    = "",                    # Auto-detected if left blank
    [string]$KeystorePass  = "passwordwaschanged",  # Password for the JKS keystore
    [string]$CertAlias     = "tomcat",              # Alias for the cert entry in the keystore
    [string]$CertOU        = "IT",
    [string]$CertO         = "MyOrg",
    [string]$CertL         = "Atlanta",
    [string]$CertST        = "GA",
    [string]$CertC         = "US",
    [int]   $CertValidDays = 3650,                  # 10 years
    [int]   $HttpsPort     = 443,
    [switch]$RestartTomcat,                         # Restart Tomcat service after configuring

    # ── Rollback mode ────────────────────────────────────────────────────────
    # Run with -Rollback to restore all instances on every server to their most
    # recent backup. Supply -RollbackTimestamp to target a specific backup stamp
    # (format: yyyyMMdd_HHmmss) rather than the latest one.
    [switch]$Rollback,
    [string]$RollbackTimestamp = "",   # e.g. "20250514_143022" — blank = latest

    [System.Management.Automation.PSCredential]$Credential
)
#endregion

#region Helpers
function Write-Status {
    param([string]$Msg, [string]$Color = "White")
    $ts = Get-Date -Format "HH:mm:ss"
    Write-Host ("[$ts] $Msg") -ForegroundColor $Color
}

function Exit-Error {
    param([string]$Msg)
    Write-Status ("ERROR: $Msg") -Color Red
    exit 1
}
#endregion

#region Load server list
if (-not (Test-Path $ServerList)) {
    Write-Host "ERROR: Server list not found: $ServerList" -ForegroundColor Red
    Write-Host "Create a servers.txt file in the same directory as this script," -ForegroundColor Yellow
    Write-Host "with one server FQDN or hostname per line. Lines starting with # are comments." -ForegroundColor Yellow
    exit 1
}

$servers = @(
    Get-Content $ServerList |
    Where-Object { ($_ -notmatch '^\s*$') -and ($_ -notmatch '^\s*#') } |
    ForEach-Object { $_.Trim() }
)

if ($servers.Count -eq 0) {
    Write-Host "ERROR: No servers found in $ServerList" -ForegroundColor Red
    exit 1
}

$modeLabel = if ($Rollback) { 'ROLLBACK' } else { 'CONFIGURE' }
Write-Status "=== Tomcat 10.1 SSL Configurator ===" -Color Cyan
Write-Status "Mode        : $modeLabel"              -Color Cyan
Write-Status "Server list : $ServerList ($($servers.Count) server(s))" -Color Cyan
Write-Status "Port        : $HttpsPort"              -Color Cyan
Write-Status ""
#endregion

#region Session params
$sessionParams = @{ ErrorAction = "Stop" }
if ($Credential) { $sessionParams["Credential"] = $Credential }
#endregion

$summary = New-Object 'System.Collections.Generic.List[System.Management.Automation.PSObject]'

# ============================================================================
# PRE-RESOLVE ALL FQDNs — build the full SAN list before touching any node
# ============================================================================
$localNames = @(
    "localhost", "127.0.0.1", "::1",
    $env:COMPUTERNAME,
    ($env:COMPUTERNAME + "." + $env:USERDNSDOMAIN)
)

Write-Status "--- Resolving FQDNs for all cluster nodes ---" -Color Cyan
$nodeInfo = [System.Collections.Generic.List[PSObject]]::new()
foreach ($srv in $servers) {
    $fqdn = $srv
    try { $fqdn = [System.Net.Dns]::GetHostEntry($srv).HostName } catch {}
    $short   = $fqdn.Split('.')[0]
    $isLocal = $localNames -contains $srv
    $nodeInfo.Add([PSCustomObject]@{
        InputName = $srv
        FQDN      = $fqdn
        ShortName = $short
        IsLocal   = $isLocal
    })
    Write-Status "  $srv  ->  $fqdn" -Color Gray
}

$sanEntries = foreach ($n in $nodeInfo) { "dns:$($n.FQDN)", "dns:$($n.ShortName)" }
$sanString  = $sanEntries -join ","
Write-Status "SAN entries : $sanString" -Color Cyan
Write-Status ""

# ============================================================================
# SCRIPTBLOCK: Locate all Tomcat instances on a server
# Returns List of PSCustomObjects: TomcatHome, ConfDir, ServiceName, NormalizedHome
# ============================================================================
$findInstancesBlock = {
    param([string]$TomcatHomeOverride)

    $instances = New-Object 'System.Collections.Generic.List[PSObject]'

    function Try-Add {
        param([string]$home, [string]$svcName)
        if (-not $home -or -not (Test-Path (Join-Path $home "conf\server.xml"))) { return }
        $norm = $home.TrimEnd('\').ToLower()
        if ($instances | Where-Object { $_.NormalizedHome -eq $norm }) { return }
        $instances.Add([PSCustomObject]@{
            TomcatHome     = $home
            NormalizedHome = $norm
            ConfDir        = Join-Path $home "conf"
            ServiceName    = $svcName
        })
    }

    if ($TomcatHomeOverride) {
        Try-Add $TomcatHomeOverride ""
    } else {
        # Method 1: all Tomcat Windows services via WMI
        $svcs = @(Get-WmiObject Win32_Service -Filter "Description LIKE '%Tomcat%' OR DisplayName LIKE '%Tomcat%' OR Name LIKE '%Tomcat%'" -ErrorAction SilentlyContinue)
        foreach ($svc in $svcs) {
            if ($svc.PathName) {
                $exe  = ($svc.PathName -replace '^"?([^"]+\.exe).*$','$1').Trim('"')
                $home = Split-Path (Split-Path $exe -Parent) -Parent
                Try-Add $home $svc.Name
            }
        }

        # Method 2: Procrun registry
        $regBases = @(
            "HKLM:\SOFTWARE\Apache Software Foundation\Procrun 2.0",
            "HKLM:\SOFTWARE\WOW6432Node\Apache Software Foundation\Procrun 2.0"
        )
        foreach ($base in $regBases) {
            if (-not (Test-Path $base)) { continue }
            foreach ($key in (Get-ChildItem $base -ErrorAction SilentlyContinue | Where-Object { $_.PSChildName -like "*Tomcat*" })) {
                $javaKey = Join-Path $key.PSPath "Parameters\Java"
                if (Test-Path $javaKey) {
                    $cp = (Get-ItemProperty $javaKey -ErrorAction SilentlyContinue).Classpath
                    if ($cp -match "^(.+?)\\lib\\") { Try-Add $Matches[1] $key.PSChildName }
                }
            }
        }

        # Method 3: CATALINA_HOME env
        $ch = [System.Environment]::GetEnvironmentVariable("CATALINA_HOME","Machine")
        if ($ch) { Try-Add $ch "" }

        # Method 4: Program Files scan
        foreach ($pf in @("C:\Program Files\Apache Software Foundation","C:\Program Files (x86)\Apache Software Foundation")) {
            if (-not (Test-Path $pf)) { continue }
            foreach ($d in (Get-ChildItem $pf -Directory -ErrorAction SilentlyContinue | Where-Object { $_.Name -like "Tomcat*" })) {
                Try-Add $d.FullName ""
            }
        }
    }

    return ,$instances
}

# ============================================================================
# SCRIPTBLOCK: Rollback a single instance
# ============================================================================
$rollbackInstanceBlock = {
    param(
        [string]$TomcatHome,
        [string]$ConfDir,
        [string]$ServiceName,
        [string]$RollbackTimestamp,
        [bool]  $DoRestart
    )

    $log = New-Object 'System.Collections.Generic.List[string]'
    function Log { param([string]$m) $log.Add($m); Write-Host $m }

    Log "Instance: $TomcatHome"

    # Find backup directory — specific timestamp or latest
    $backupDir = $null
    if ($RollbackTimestamp) {
        $candidate = Join-Path $ConfDir "_backup_$RollbackTimestamp"
        if (Test-Path $candidate) { $backupDir = $candidate }
        else {
            return [PSCustomObject]@{ Success=$false; Log=$log
                Error="Backup not found for timestamp '$RollbackTimestamp' at: $candidate" }
        }
    } else {
        $latest = Get-ChildItem -Path $ConfDir -Directory -Filter "_backup_*" -ErrorAction SilentlyContinue |
                  Sort-Object Name -Descending | Select-Object -First 1
        if ($latest) { $backupDir = $latest.FullName }
        else {
            return [PSCustomObject]@{ Success=$false; Log=$log
                Error="No backup folders found in $ConfDir" }
        }
    }
    Log "Restoring from: $backupDir"

    # List available backups for reference
    $allBackups = @(Get-ChildItem -Path $ConfDir -Directory -Filter "_backup_*" -ErrorAction SilentlyContinue | Sort-Object Name -Descending)
    Log "Available backups on this instance ($($allBackups.Count) total):"
    foreach ($b in $allBackups) { Log "  $($b.Name)$(if ($b.FullName -eq $backupDir) { '  <-- restoring this one' })" }

    # Stop service
    $svc = $null
    if ($ServiceName) { $svc = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue }
    if (-not $svc) {
        $escaped = [regex]::Escape($TomcatHome)
        $wmi = Get-WmiObject Win32_Service -Filter "Description LIKE '%Tomcat%' OR DisplayName LIKE '%Tomcat%' OR Name LIKE '%Tomcat%'" -ErrorAction SilentlyContinue |
               Where-Object { $_.PathName -match $escaped } | Select-Object -First 1
        if ($wmi) { $svc = Get-Service -Name $wmi.Name -ErrorAction SilentlyContinue }
    }
    if ($svc -and $svc.Status -eq "Running") {
        Log "Stopping service: $($svc.Name)..."
        Stop-Service -Name $svc.Name -Force -ErrorAction SilentlyContinue
        $timeout = 30; $elapsed = 0
        while ((Get-Service $svc.Name).Status -ne "Stopped" -and $elapsed -lt $timeout) { Start-Sleep 2; $elapsed += 2 }
        Log "Service stopped."
    }

    # Restore files from backup
    $files = @(Get-ChildItem -Path $backupDir -File -ErrorAction SilentlyContinue)
    if ($files.Count -eq 0) {
        return [PSCustomObject]@{ Success=$false; Log=$log; Error="Backup folder is empty: $backupDir" }
    }
    $restored = @()
    foreach ($f in $files) {
        $dest = Join-Path $ConfDir $f.Name
        Copy-Item $f.FullName $dest -Force
        Log "  Restored: $($f.Name)"
        $restored += $f.Name
    }

    # If keystore.jks was not in the backup it did not exist before — remove the new one
    $ksPath = Join-Path $ConfDir "keystore.jks"
    if ((Test-Path $ksPath) -and ($restored -notcontains "keystore.jks")) {
        Remove-Item $ksPath -Force
        Log "  Removed keystore.jks (was not present before this script ran)"
    }

    # Sanity-check the restored server.xml no longer references passwordwaschanged
    $sxPath = Join-Path $ConfDir "server.xml"
    if (Test-Path $sxPath) {
        $sxRaw = Get-Content $sxPath -Raw
        if ($sxRaw -match "passwordwaschanged") {
            Log "  WARNING: Restored server.xml still contains 'passwordwaschanged' — the backup may have been taken after the script ran. Verify manually."
        } else {
            Log "  server.xml verified clean after restore (no 'passwordwaschanged' found)."
        }
    }

    # Restart if requested
    $restartNote = ""
    if ($DoRestart -and $svc) {
        Log "Starting service: $($svc.Name)..."
        Start-Service -Name $svc.Name -ErrorAction SilentlyContinue
        Start-Sleep 5
        $svc = Get-Service -Name $svc.Name -ErrorAction SilentlyContinue
        $restartNote = "Service $($svc.Name) status: $($svc.Status)"
        Log $restartNote
    } elseif (-not $DoRestart) {
        Log "Restart skipped — start Tomcat manually."
    }

    return [PSCustomObject]@{
        Success     = $true
        Log         = $log
        Error       = $null
        BackupDir   = $backupDir
        Restored    = ($restored -join ", ")
        RestartNote = $restartNote
    }
}

# ============================================================================
# SCRIPTBLOCK: Configure a single instance
# ============================================================================
$configureInstanceBlock = {
    param(
        [string]$TomcatHome,
        [string]$ConfDir,
        [string]$ServiceName,
        [string]$KeystorePass,
        [string]$CertAlias,
        [string]$CertCN,
        [string]$CertOU,
        [string]$CertO,
        [string]$CertL,
        [string]$CertST,
        [string]$CertC,
        [int]   $CertValidDays,
        [int]   $HttpsPort,
        [bool]  $DoRestart,
        [bool]  $IsFirstNode,
        [string]$SanString,
        [byte[]]$KeystoreBytes,
        [string]$NodeFqdn
    )

    $log = New-Object 'System.Collections.Generic.List[string]'
    function Log { param([string]$m) $log.Add($m); Write-Host $m }

    Log "Instance: $TomcatHome"

    # ── Locate keytool ───────────────────────────────────────────────────────
    $keytool  = $null
    $javaHome = [System.Environment]::GetEnvironmentVariable("JAVA_HOME","Machine")
    if ($javaHome) { $kt = Join-Path $javaHome "bin\keytool.exe"; if (Test-Path $kt) { $keytool = $kt } }
    if (-not $keytool) {
        foreach ($sub in @("jre\bin\keytool.exe","bin\keytool.exe")) {
            $kt = Join-Path $TomcatHome $sub
            if (Test-Path $kt) { $keytool = $kt; break }
        }
    }
    if (-not $keytool) {
        $ktCmd = Get-Command keytool.exe -ErrorAction SilentlyContinue
        if ($ktCmd) { $keytool = $ktCmd.Source }
    }
    if (-not $keytool) {
        return [PSCustomObject]@{ Success=$false; Log=$log
            Error="keytool.exe not found. Ensure JDK/JRE is installed and JAVA_HOME is set." }
    }
    Log "keytool: $keytool"

    # ── Backup this instance before making any changes ───────────────────────
    $stamp     = Get-Date -Format "yyyyMMdd_HHmmss"
    $backupDir = Join-Path $ConfDir "_backup_$stamp"
    New-Item -ItemType Directory -Path $backupDir -Force | Out-Null
    Log "Backup: $backupDir"
    foreach ($f in @("server.xml","web.xml","context.xml","keystore.jks")) {
        $src = Join-Path $ConfDir $f
        if (Test-Path $src) { Copy-Item $src $backupDir -Force; Log "  Backed up: $f" }
    }
    Log "Backup complete — rollback with: -Rollback -RollbackTimestamp '$stamp'"

    # ── Keystore: generate (first node) or write distributed bytes ───────────
    $keystoreFile = Join-Path $ConfDir "keystore.jks"
    if (Test-Path $keystoreFile) { Remove-Item $keystoreFile -Force; Log "Removed existing keystore." }

    if ($IsFirstNode) {
        $dname      = "CN=$CertCN, OU=$CertOU, O=$CertO, L=$CertL, ST=$CertST, C=$CertC"
        $keytoolErr = "$env:TEMP\keytool_err.txt"
        Log "Generating keystore (first node / cluster primary):"
        Log "  DN : $dname"
        Log "  SAN: $SanString"

        & $keytool -genkeypair `
            -alias     $CertAlias `
            -keyalg    RSA `
            -keysize   2048 `
            -validity  $CertValidDays `
            -keystore  $keystoreFile `
            -storepass $KeystorePass `
            -keypass   $KeystorePass `
            -dname     $dname `
            -ext        "SAN=$SanString" `
            -storetype JKS 2> $keytoolErr

        if ($LASTEXITCODE -ne 0) {
            $errText = Get-Content $keytoolErr -Raw -ErrorAction SilentlyContinue
            return [PSCustomObject]@{ Success=$false; Log=$log
                Error="keytool genkeypair failed (exit $LASTEXITCODE): $errText" }
        }
        if (-not (Test-Path $keystoreFile)) {
            return [PSCustomObject]@{ Success=$false; Log=$log; Error="Keystore file was not created." }
        }
        Log "Keystore generated successfully."
    } else {
        Log "Writing distributed keystore from cluster primary ($($KeystoreBytes.Length) bytes)..."
        [System.IO.File]::WriteAllBytes($keystoreFile, $KeystoreBytes)
        if (-not (Test-Path $keystoreFile)) {
            return [PSCustomObject]@{ Success=$false; Log=$log; Error="Failed to write distributed keystore." }
        }
        Log "Distributed keystore written."
    }

    # ── Verify keystore is readable with the configured password ─────────────
    $keytoolErr = "$env:TEMP\keytool_list_err.txt"
    & $keytool -list `
        -keystore  $keystoreFile `
        -storepass $KeystorePass `
        -storetype JKS 2> $keytoolErr | Out-Null

    if ($LASTEXITCODE -ne 0) {
        $errText = Get-Content $keytoolErr -Raw -ErrorAction SilentlyContinue
        return [PSCustomObject]@{ Success=$false; Log=$log
            Error="Keystore verification failed — password mismatch or corrupt store: $errText" }
    }
    Log "Keystore verified (password '$KeystorePass' accepted, alias '$CertAlias' accessible)."

    # ── Export per-node public certificate (.cer named by FQDN) ─────────────
    $certFile   = Join-Path $ConfDir "$NodeFqdn.cer"
    $keytoolErr = "$env:TEMP\keytool_export_err.txt"
    & $keytool -exportcert `
        -alias     $CertAlias `
        -keystore  $keystoreFile `
        -storepass $KeystorePass `
        -file      $certFile `
        -rfc 2> $keytoolErr

    if ($LASTEXITCODE -ne 0) {
        $errText = Get-Content $keytoolErr -Raw -ErrorAction SilentlyContinue
        Log "WARNING: Certificate export failed (non-fatal): $errText"
        $certFile = ""
    } else {
        Log "Certificate exported: $certFile"
        Log "  IIS trust: Import-Certificate -FilePath '$certFile' -CertStoreLocation Cert:\LocalMachine\Root"
        Log "         or: certutil -addstore Root '$certFile'"
    }

    # Read keystore bytes back for distribution to remaining nodes (first node only)
    $keystoreBytesOut = $null
    if ($IsFirstNode) {
        $keystoreBytesOut = [System.IO.File]::ReadAllBytes($keystoreFile)
        Log "Keystore read back for cluster distribution ($($keystoreBytesOut.Length) bytes)."
    }

    # ── Update server.xml ────────────────────────────────────────────────────
    $serverXmlPath = Join-Path $ConfDir "server.xml"
    if (-not (Test-Path $serverXmlPath)) {
        return [PSCustomObject]@{ Success=$false; Log=$log; Error="server.xml not found: $serverXmlPath" }
    }

    [xml]$xml = Get-Content $serverXmlPath -Raw

    # Update HTTP connector redirectPort
    $httpConn = $xml.Server.Service.Connector |
                Where-Object { ($_.port -eq "80" -or $_.port -eq "8080") -and $_.SSLEnabled -ne "true" } |
                Select-Object -First 1
    if ($httpConn) {
        $httpConn.redirectPort = "$HttpsPort"
        Log "HTTP connector (port $($httpConn.port)) redirectPort set to $HttpsPort."
    } else {
        Log "WARNING: HTTP connector not found — redirectPort not updated."
    }

    # Remove any existing HTTPS connector on this port
    $xmlSvc = $xml.Server.Service
    @($xmlSvc.Connector | Where-Object { $_.port -eq "$HttpsPort" }) | ForEach-Object {
        $xmlSvc.RemoveChild($_) | Out-Null
        Log "Removed existing connector on port $HttpsPort."
    }

    # Build new HTTPS Connector with explicit keystore path and password
    $newConn = $xml.CreateElement("Connector")
    $newConn.SetAttribute("port",              "$HttpsPort")
    $newConn.SetAttribute("protocol",          "org.apache.coyote.http11.Http11NioProtocol")
    $newConn.SetAttribute("maxThreads",        "150")
    $newConn.SetAttribute("SSLEnabled",        "true")
    $newConn.SetAttribute("scheme",            "https")
    $newConn.SetAttribute("secure",            "true")
    $newConn.SetAttribute("connectionTimeout", "20000")

    $sslHostConfig = $xml.CreateElement("SSLHostConfig")
    $cert          = $xml.CreateElement("Certificate")
    $cert.SetAttribute("certificateKeystoreFile",     $keystoreFile)   # Full path to this instance's keystore
    $cert.SetAttribute("certificateKeystorePassword", $KeystorePass)   # "passwordwaschanged"
    $cert.SetAttribute("certificateKeyAlias",         $CertAlias)      # "tomcat"
    $cert.SetAttribute("type",                        "RSA")

    $sslHostConfig.AppendChild($cert)    | Out-Null
    $newConn.AppendChild($sslHostConfig) | Out-Null
    $xmlSvc.AppendChild($newConn)        | Out-Null
    Log "HTTPS Connector added to server.xml:"
    Log "  certificateKeystoreFile    : $keystoreFile"
    Log "  certificateKeystorePassword: $KeystorePass"
    Log "  certificateKeyAlias        : $CertAlias"

    # Save server.xml
    $xmlSettings = New-Object System.Xml.XmlWriterSettings
    $xmlSettings.Indent             = $true
    $xmlSettings.IndentChars        = "  "
    $xmlSettings.Encoding           = [System.Text.Encoding]::UTF8
    $xmlSettings.OmitXmlDeclaration = $false
    $xmlWriter = [System.Xml.XmlWriter]::Create($serverXmlPath, $xmlSettings)
    $xml.Save($xmlWriter)
    $xmlWriter.Close()
    Log "server.xml saved."

    # ── Verify server.xml was written correctly ───────────────────────────────
    $verifyContent  = Get-Content $serverXmlPath -Raw
    $verifyFailed   = $false
    $ksPathEscaped  = [regex]::Escape($keystoreFile)
    $passEscaped    = [regex]::Escape($KeystorePass)
    $aliasEscaped   = [regex]::Escape($CertAlias)

    if ($verifyContent -notmatch $ksPathEscaped) {
        Log "VERIFICATION FAILED: keystoreFile path not found in server.xml."
        $verifyFailed = $true
    }
    if ($verifyContent -notmatch $passEscaped) {
        Log "VERIFICATION FAILED: keystorePassword ('$KeystorePass') not found in server.xml."
        $verifyFailed = $true
    }
    if ($verifyContent -notmatch $aliasEscaped) {
        Log "VERIFICATION FAILED: certificateKeyAlias ('$CertAlias') not found in server.xml."
        $verifyFailed = $true
    }
    if ($verifyFailed) {
        return [PSCustomObject]@{ Success=$false; Log=$log
            Error="server.xml post-write verification failed. Check log for details." }
    }
    Log "server.xml verified — keystoreFile, password, and alias all confirmed present."

    # ── Optionally restart ───────────────────────────────────────────────────
    $restartNote = ""
    if ($DoRestart) {
        $svc = $null
        if ($ServiceName) { $svc = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue }
        if (-not $svc) {
            $escaped = [regex]::Escape($TomcatHome)
            $wmi = Get-WmiObject Win32_Service -Filter "Description LIKE '%Tomcat%' OR DisplayName LIKE '%Tomcat%' OR Name LIKE '%Tomcat%'" -ErrorAction SilentlyContinue |
                   Where-Object { $_.PathName -match $escaped } | Select-Object -First 1
            if ($wmi) { $svc = Get-Service -Name $wmi.Name -ErrorAction SilentlyContinue }
        }
        if ($svc) {
            Log "Restarting: $($svc.Name)..."
            Restart-Service -Name $svc.Name -Force -ErrorAction SilentlyContinue
            Start-Sleep 5
            $svc         = Get-Service -Name $svc.Name -ErrorAction SilentlyContinue
            $restartNote = "Service $($svc.Name) status: $($svc.Status)"
            Log $restartNote
        } else {
            $restartNote = "WARNING: Could not find Tomcat service — restart manually."
            Log $restartNote
        }
    } else {
        Log "Restart skipped — restart Tomcat manually for changes to take effect."
    }

    return [PSCustomObject]@{
        Success          = $true
        Log              = $log
        Error            = $null
        TomcatHome       = $TomcatHome
        KeystoreFile     = $keystoreFile
        CertFile         = $certFile
        BackupDir        = $backupDir
        BackupStamp      = $stamp
        HttpsPort        = $HttpsPort
        RestartNote      = $restartNote
        KeystoreBytesOut = $keystoreBytesOut
    }
}

# ============================================================================
# MAIN LOOP
# ============================================================================
$clusterKeystoreBytes = $null
$isFirstNode          = $true

foreach ($node in $nodeInfo) {

    $ComputerName = $node.InputName
    $NodeFqdn     = $node.FQDN
    $isLocal      = $node.IsLocal

    $localTag = if ($isLocal) { "  [LOCAL]" } else { "" }
    Write-Status "========================================" -Color DarkCyan
    Write-Status "Server: $ComputerName  ($NodeFqdn)$localTag" -Color Cyan

    # ── Open PSSession ────────────────────────────────────────────────────────
    $session = $null
    if (-not $isLocal) {
        try {
            $session = New-PSSession -ComputerName $ComputerName @sessionParams
        } catch {
            Write-Status "  ERROR: PSSession failed - $_" -Color Red
            $summary.Add([PSCustomObject]@{ Server=$ComputerName; Instance=""; Status="SESSION FAILED"; Detail=$_.ToString() })
            continue
        }
    }

    # ── Discover Tomcat instances ─────────────────────────────────────────────
    $instances = $null
    try {
        if ($isLocal) {
            $instances = & $findInstancesBlock $TomcatHome
        } else {
            $instances = Invoke-Command -Session $session -ScriptBlock $findInstancesBlock -ArgumentList @($TomcatHome)
        }
    } catch {
        Write-Status "  ERROR: Could not enumerate Tomcat instances - $_" -Color Red
        $summary.Add([PSCustomObject]@{ Server=$ComputerName; Instance=""; Status="ENUM FAILED"; Detail=$_.ToString() })
        if ($session) { Remove-PSSession $session -ErrorAction SilentlyContinue }
        continue
    }

    if (-not $instances -or $instances.Count -eq 0) {
        Write-Status "  WARNING: No Tomcat instances found on $ComputerName" -Color Yellow
        $summary.Add([PSCustomObject]@{ Server=$ComputerName; Instance=""; Status="NO INSTANCES"; Detail="" })
        if ($session) { Remove-PSSession $session -ErrorAction SilentlyContinue }
        continue
    }

    Write-Status "  Found $($instances.Count) instance(s)." -Color Gray

    foreach ($inst in $instances) {

        Write-Status "  -- Instance: $($inst.TomcatHome)" -Color Cyan

        # ── ROLLBACK ─────────────────────────────────────────────────────────
        if ($Rollback) {
            $rbArgs = @(
                $inst.TomcatHome,
                $inst.ConfDir,
                $inst.ServiceName,
                $RollbackTimestamp,
                $RestartTomcat.IsPresent
            )
            $rbResult = $null
            try {
                if ($isLocal) {
                    $rbResult = Invoke-Command -ScriptBlock $rollbackInstanceBlock -ArgumentList $rbArgs
                } else {
                    $rbResult = Invoke-Command -Session $session -ScriptBlock $rollbackInstanceBlock -ArgumentList $rbArgs
                }
            } catch {
                $rbResult = [PSCustomObject]@{ Success=$false; Log=@(); Error=$_.ToString() }
            }

            if ($rbResult.Success) {
                Write-Status "  ROLLBACK OK: $($inst.TomcatHome)" -Color Green
                Write-Status "    Restored from : $($rbResult.BackupDir)" -Color Cyan
                Write-Status "    Files         : $($rbResult.Restored)"  -Color Cyan
                if ($rbResult.RestartNote) { Write-Status "    $($rbResult.RestartNote)" -Color Yellow }
                $summary.Add([PSCustomObject]@{ Server=$ComputerName; Instance=$inst.TomcatHome; Status="ROLLED BACK"; Detail=$rbResult.BackupDir })
            } else {
                Write-Status "  ROLLBACK FAILED: $($inst.TomcatHome)" -Color Red
                Write-Status "    $($rbResult.Error)" -Color Red
                $summary.Add([PSCustomObject]@{ Server=$ComputerName; Instance=$inst.TomcatHome; Status="ROLLBACK FAILED"; Detail=$rbResult.Error })
            }
            Write-Status "  --- Log ---" -Color Gray
            foreach ($line in $rbResult.Log) { Write-Status "    $line" -Color Gray }
            continue
        }

        # ── CONFIGURE ────────────────────────────────────────────────────────
        if ($isFirstNode) {
            Write-Status "  ** Cluster primary — generating keystore with full SAN list **" -Color Yellow
        }

        $cfgArgs = @(
            $inst.TomcatHome,
            $inst.ConfDir,
            $inst.ServiceName,
            $KeystorePass,
            $CertAlias,
            $NodeFqdn,           # CertCN = this node's FQDN
            $CertOU, $CertO, $CertL, $CertST, $CertC,
            $CertValidDays,
            $HttpsPort,
            $RestartTomcat.IsPresent,
            $isFirstNode,
            $sanString,
            $clusterKeystoreBytes,
            $NodeFqdn
        )

        $result = $null
        try {
            if ($isLocal) {
                $result = Invoke-Command -ScriptBlock $configureInstanceBlock -ArgumentList $cfgArgs
            } else {
                $result = Invoke-Command -Session $session -ScriptBlock $configureInstanceBlock -ArgumentList $cfgArgs
            }
        } catch {
            $result = [PSCustomObject]@{ Success=$false; Log=@(); Error=$_.ToString() }
        }

        if ($result.Success) {
            Write-Status "  OK: $($inst.TomcatHome)" -Color Green
            Write-Status "    Keystore  : $($result.KeystoreFile)"  -Color Cyan
            Write-Status "    Password  : $KeystorePass"            -Color Cyan
            Write-Status "    Cert      : $($result.CertFile)"      -Color Cyan
            Write-Status "    Backup    : $($result.BackupDir)"     -Color Cyan
            Write-Status "    Rollback  : .\Configure-TomcatSSL.ps1 -Rollback -RollbackTimestamp '$($result.BackupStamp)' [-RestartTomcat]" -Color DarkCyan
            if ($result.CertFile) {
                Write-Status "    IIS trust : Import-Certificate -FilePath '$($result.CertFile)' -CertStoreLocation Cert:\LocalMachine\Root" -Color DarkCyan
            }
            if ($result.RestartNote) { Write-Status "    $($result.RestartNote)" -Color Yellow }
            $summary.Add([PSCustomObject]@{
                Server   = $ComputerName
                Instance = $inst.TomcatHome
                Status   = "OK"
                Detail   = "Stamp: $($result.BackupStamp)  Cert: $($result.CertFile)"
            })

            # Capture keystore from first successful node for distribution
            if ($isFirstNode -and $result.KeystoreBytesOut) {
                $clusterKeystoreBytes = $result.KeystoreBytesOut
                Write-Status "  Keystore captured ($($clusterKeystoreBytes.Length) bytes) — will be distributed to remaining nodes." -Color Yellow
                $isFirstNode = $false
            }
        } else {
            Write-Status "  FAILED: $($inst.TomcatHome)" -Color Red
            Write-Status "    $($result.Error)" -Color Red
            $summary.Add([PSCustomObject]@{ Server=$ComputerName; Instance=$inst.TomcatHome; Status="FAILED"; Detail=$result.Error })
        }

        Write-Status "  --- Log ---" -Color Gray
        foreach ($line in $result.Log) { Write-Status "    $line" -Color Gray }

    } # end foreach instance

    if ($session) { Remove-PSSession $session -ErrorAction SilentlyContinue }

} # end foreach server

# ── Final summary ─────────────────────────────────────────────────────────────
Write-Status ""
Write-Status "=======================================" -Color Cyan
Write-Status "  SUMMARY" -Color Cyan
Write-Status "=======================================" -Color Cyan
foreach ($row in $summary) {
    $color = switch -Wildcard ($row.Status) {
        "OK"              { "Green"  }
        "ROLLED BACK"     { "Green"  }
        "FAILED"          { "Red"    }
        "ROLLBACK FAILED" { "Red"    }
        "SESSION FAILED"  { "Red"    }
        "ENUM FAILED"     { "Red"    }
        default           { "Yellow" }
    }
    Write-Status ("  {0,-35} [{1}]  {2}" -f $row.Server, $row.Status, $row.Detail) -Color $color
    if ($row.Instance) { Write-Status ("    Instance: $($row.Instance)") -Color DarkGray }
}
Write-Status ""
Write-Status "  Rollback commands:" -Color Cyan
Write-Status "    Latest backup  : .\Configure-TomcatSSL.ps1 -Rollback [-RestartTomcat]" -Color DarkCyan
Write-Status "    Specific stamp : .\Configure-TomcatSSL.ps1 -Rollback -RollbackTimestamp 'yyyyMMdd_HHmmss' [-RestartTomcat]" -Color DarkCyan
Write-Status ""
Write-Status "  IIS trust commands (run on each IIS server):" -Color Cyan
Write-Status "    Import-Certificate -FilePath '<fqdn>.cer' -CertStoreLocation Cert:\LocalMachine\Root" -Color DarkCyan
Write-Status "    certutil -addstore Root '<fqdn>.cer'" -Color DarkCyan
Write-Status "=======================================" -Color Cyan
