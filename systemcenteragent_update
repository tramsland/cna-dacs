#region Shared Helpers
if (-not (Test-Path $LogDir)) { New-Item -ItemType Directory -Path $LogDir -Force | Out-Null }

function New-LogPath {
    param([string]$Prefix)
    return Join-Path $LogDir "${Prefix}_$(Get-Date -Format 'yyyyMMdd_HHmmss').log"
}

$script:_ActiveLog = $null

function Write-Log {
    param([string]$Message, [string]$Level = 'INFO', [string]$Color = 'White', [switch]$Spacer)
    if ($Spacer) {
        if ($script:_ActiveLog) { Add-Content -Path $script:_ActiveLog -Value '' }
        Write-Host ''
        return
    }
    $entry = "[$Level] - $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') - $Message"
    Write-Host $entry -ForegroundColor $Color
    if ($script:_ActiveLog) { Add-Content -Path $script:_ActiveLog -Value $entry }
}

function Write-Header {
    param([string]$Text)
    $line = '=' * 70
    Write-Host ''
    Write-Host $line           -ForegroundColor Cyan
    Write-Host ("  " + $Text) -ForegroundColor Cyan
    Write-Host $line           -ForegroundColor Cyan
    Write-Host ''
}

function Get-ServerList {
    param([string]$Path)
    if (-not (Test-Path $Path)) {
        Write-Log "servers.txt not found: $Path" 'ERROR' 'Red'
        return $null
    }
    $list = @(Get-Content $Path | ForEach-Object { $_.Trim() } |
              Where-Object { $_ -ne '' -and $_ -notmatch '^\s*#' -and $_ -notmatch '^\[' })
    if ($list.Count -eq 0) {
        Write-Log "No server entries found in servers.txt." 'ERROR' 'Red'
        return $null
    }
    return $list
}

function Parse-ServersFile {
    param([string]$Path)
    $groups  = [ordered]@{}
    $current = 'Ungrouped'
    $count   = 0
    foreach ($line in (Get-Content $Path)) {
        $t = $line.Trim()
        if ($t -match '^\s*$' -or $t -match '^\s*#') { continue }
        if ($t -match '^\[(.+)\]$') {
            $current = $Matches[1].Trim()
            if (-not $groups.Contains($current)) {
                $groups[$current] = New-Object 'System.Collections.Generic.List[string]'
            }
            continue
        }
        if (-not $groups.Contains($current)) {
            $groups[$current] = New-Object 'System.Collections.Generic.List[string]'
        }
        $groups[$current].Add($t)
        $count++
    }
    return $groups, $count
}

function Wait-ServiceState {
    param([string]$Name, [string]$TargetState, [int]$TimeoutSec, [string]$ActionLabel)
    $svc     = Get-Service -Name $Name -ErrorAction Stop
    $timeout = [TimeSpan]::FromSeconds($TimeoutSec)
    try {
        $svc.WaitForStatus($TargetState, $timeout)
        Write-Log "Service '$Name' $ActionLabel." 'OK' 'Green'
    }
    catch [System.ServiceProcess.TimeoutException] {
        throw "Timed out waiting for '$Name' to reach '$TargetState' after ${TimeoutSec}s."
    }
}
#endregion

#region Remote Connection Layer
# Provides a three-tier fallback per server:
#   Tier 1 — WinRM  (Invoke-Command / New-PSSession, port 5985)
#             Full scriptblock execution. Best option.
#   Tier 2 — DCOM   (CIM session over RPC, port 135 + dynamic)
#             WMI queries work. Remote execution via Win32_Process.Create +
#             poll for completion + read output via UNC temp file.
#   Tier 3 — UNC    (admin share \\server\e$, SMB port 445)
#             File read/write only. No remote code execution.
#             Version detection reads files directly; operations that need
#             execution are skipped with a clear warning.
#
# Usage:
#   $ctx = Connect-RemoteServer -Hostname $fqdn
#   if ($ctx) {
#       $result = Invoke-RCmd -Ctx $ctx -Block { param($x) ... } -Args @($x)
#       $text   = Read-RFile  -Ctx $ctx -Path 'E:\some\file.txt'
#       Disconnect-RemoteServer -Ctx $ctx
#   }
# -----------------------------------------------------------------------

function Connect-RemoteServer {
    param([string]$Hostname)

    # --- Tier 1: WinRM ---
    try {
        $s = New-PSSession -ComputerName $Hostname -ErrorAction Stop
        Write-Log "  $Hostname : Connected via WinRM." 'INFO' 'Green'
        return [pscustomobject]@{ Tier = 'WinRM'; Session = $s; Hostname = $Hostname }
    }
    catch {
        Write-Log "  $Hostname : WinRM failed ($($_.Exception.Message)) — trying DCOM." 'WARN' 'Yellow'
    }

    # --- Tier 2: DCOM ---
    try {
        $opt = New-CimSessionOption -Protocol Dcom
        $cs  = New-CimSession -ComputerName $Hostname -SessionOption $opt -ErrorAction Stop
        Write-Log "  $Hostname : Connected via DCOM." 'INFO' 'Yellow'
        return [pscustomobject]@{ Tier = 'DCOM'; Session = $cs; Hostname = $Hostname }
    }
    catch {
        Write-Log "  $Hostname : DCOM failed ($($_.Exception.Message)) — trying UNC." 'WARN' 'Yellow'
    }

    # --- Tier 3: UNC admin share ---
    $unc = "\\$Hostname\e$"
    if (Test-Path $unc) {
        Write-Log "  $Hostname : UNC share reachable ($unc). File operations only — no remote execution." 'WARN' 'Yellow'
        return [pscustomobject]@{ Tier = 'UNC'; Session = $null; Hostname = $Hostname }
    }

    Write-Log "  $Hostname : All connection methods failed." 'ERROR' 'Red'
    return $null
}

function Disconnect-RemoteServer {
    param([pscustomobject]$Ctx)
    if (-not $Ctx) { return }
    try {
        switch ($Ctx.Tier) {
            'WinRM' { Remove-PSSession  $Ctx.Session -ErrorAction SilentlyContinue }
            'DCOM'  { Remove-CimSession $Ctx.Session -ErrorAction SilentlyContinue }
        }
    }
    catch {}
}

# Invoke-RCmd — run a scriptblock remotely.
#   WinRM: Invoke-Command with full scriptblock support.
#   DCOM:  Serialise the block as a string, write a temp .ps1 to UNC,
#          launch it via Win32_Process, poll for exit, read output via UNC.
#   UNC:   Cannot execute — returns $null and logs a warning.
function Invoke-RCmd {
    param(
        [pscustomobject]$Ctx,
        [scriptblock]$Block,
        [object[]]$Args = @()
    )

    if (-not $Ctx) { return $null }

    switch ($Ctx.Tier) {

        'WinRM' {
            return Invoke-Command -Session $Ctx.Session -ScriptBlock $Block -ArgumentList $Args
        }

        'DCOM' {
            # Build a self-contained .ps1 that inlines the args as JSON then calls the block
            $guid    = [guid]::NewGuid().ToString('N')
            $outFile = "C:\Windows\Temp\rcmd_out_$guid.txt"
            $ps1File = "C:\Windows\Temp\rcmd_$guid.ps1"
            $uncOut  = "\\$($Ctx.Hostname)\C`$\Windows\Temp\rcmd_out_$guid.txt"
            $uncPs1  = "\\$($Ctx.Hostname)\C`$\Windows\Temp\rcmd_$guid.ps1"

            # Serialise arguments via CliXml into the script header
            $argsXml = ($Args | ForEach-Object { $_ | ConvertTo-Json -Depth 5 -Compress }) -join "`n"
            $ps1Body = @"
`$argsRaw = @(
$(($Args | ForEach-Object { "`$(`$null | Select-Object -InputObject (ConvertFrom-Json '$($_ | ConvertTo-Json -Depth 5 -Compress)')" }) -join "`n")
)
& {
$($Block.ToString())
} @argsRaw 2>&1 | Out-File -FilePath '$outFile' -Encoding utf8
"@
            # Simpler approach: write block + args via param substitution
            $argLines = for ($i = 0; $i -lt $Args.Count; $i++) {
                "`$arg$i = $(ConvertTo-Json $Args[$i] -Depth 5 -Compress)"
            }
            $argPass = (0..($Args.Count-1) | ForEach-Object { "`$arg$_" }) -join ','
            $ps1Body = @"
$(($argLines) -join "`n")
& {
$($Block.ToString())
} $argPass 2>&1 | Out-File -FilePath '$outFile' -Encoding utf8
"@
            try {
                Set-Content -Path $uncPs1 -Value $ps1Body -Encoding UTF8 -ErrorAction Stop
            }
            catch {
                Write-Log "  $($Ctx.Hostname) : DCOM - could not write temp script via UNC: $_" 'ERROR' 'Red'
                return $null
            }

            $mc = $null
            try { $mc = [wmiclass]"\\$($Ctx.Hostname)\root\cimv2:Win32_Process" }
            catch {
                Write-Log "  $($Ctx.Hostname) : DCOM - Win32_Process class unavailable: $_" 'ERROR' 'Red'
                Remove-Item $uncPs1 -Force -ErrorAction SilentlyContinue
                return $null
            }

            $r = $mc.Create("powershell.exe -NonInteractive -ExecutionPolicy Bypass -File `"$ps1File`"")
            if ($r.ReturnValue -ne 0) {
                Write-Log "  $($Ctx.Hostname) : DCOM - Win32_Process.Create failed (rc=$($r.ReturnValue))." 'ERROR' 'Red'
                Remove-Item $uncPs1 -Force -ErrorAction SilentlyContinue
                return $null
            }

            $pid2    = $r.ProcessId
            $timeout = 180
            $elapsed = 0
            do {
                Start-Sleep -Seconds 2
                $elapsed += 2
                $running = Get-WmiObject -Class Win32_Process -ComputerName $Ctx.Hostname `
                               -Filter "ProcessId=$pid2" -ErrorAction SilentlyContinue
            } while ($running -and $elapsed -lt $timeout)

            $output = Get-Content $uncOut -ErrorAction SilentlyContinue
            Remove-Item $uncOut  -Force -ErrorAction SilentlyContinue
            Remove-Item $uncPs1  -Force -ErrorAction SilentlyContinue
            return $output
        }

        'UNC' {
            Write-Log "  $($Ctx.Hostname) : UNC-only — cannot execute remote commands." 'WARN' 'Yellow'
            return $null
        }
    }
}

# Read-RFile — read a remote text file.
#   WinRM: Invoke-Command Get-Content.
#   DCOM/UNC: direct UNC path read (no remote execution needed).
function Read-RFile {
    param([pscustomobject]$Ctx, [string]$Path)
    if (-not $Ctx) { return $null }
    if ($Ctx.Tier -eq 'WinRM') {
        return Invoke-Command -Session $Ctx.Session -ScriptBlock {
            param($p) Get-Content -Path $p -Raw -ErrorAction Stop
        } -ArgumentList $Path
    }
    $unc = "\\$($Ctx.Hostname)\$($Path -replace '^([A-Za-z]):\\', '$1$\')"
    return Get-Content -Path $unc -Raw -ErrorAction Stop
}

# Write-RFile — write content to a remote path.
#   WinRM: Invoke-Command Set-Content.
#   DCOM/UNC: direct UNC write.
function Write-RFile {
    param([pscustomobject]$Ctx, [string]$Path, [string]$Content)
    if (-not $Ctx) { return }
    if ($Ctx.Tier -eq 'WinRM') {
        Invoke-Command -Session $Ctx.Session -ScriptBlock {
            param($p, $c) Set-Content -Path $p -Value $c -Encoding UTF8 -Force
        } -ArgumentList $Path, $Content
        return
    }
    $unc = "\\$($Ctx.Hostname)\$($Path -replace '^([A-Za-z]):\\', '$1$\')"
    Set-Content -Path $unc -Value $Content -Encoding UTF8 -Force
}

# Get-RCimInstances — query WMI/CIM on a remote server.
#   WinRM: Get-CimInstance via PSSession.
#   DCOM:  Get-CimInstance via existing CimSession.
#   UNC:   Get-WmiObject fallback (DCOM-style, no CIM session required).
function Get-RCimInstances {
    param([pscustomobject]$Ctx, [string]$ClassName, [string]$Filter = '')
    if (-not $Ctx) { return $null }
    $params = @{ ClassName = $ClassName; ErrorAction = 'Stop' }
    if ($Filter) { $params['Filter'] = $Filter }
    switch ($Ctx.Tier) {
        'WinRM' {
            return Invoke-Command -Session $Ctx.Session -ScriptBlock {
                param($cn, $f)
                $p = @{ ClassName = $cn; ErrorAction = 'Stop' }
                if ($f) { $p['Filter'] = $f }
                Get-CimInstance @p
            } -ArgumentList $ClassName, $Filter
        }
        'DCOM' {
            $params['CimSession'] = $Ctx.Session
            return Get-CimInstance @params
        }
        'UNC' {
            # Fallback to legacy Get-WmiObject (uses DCOM internally, no CIM session)
            $wparams = @{ Class = $ClassName; ComputerName = $Ctx.Hostname; ErrorAction = 'Stop' }
            if ($Filter) { $wparams['Filter'] = $Filter }
            return Get-WmiObject @wparams
        }
    }
}

# Get-RServiceInfo — return service details for a named service.
function Get-RServiceInfo {
    param([pscustomobject]$Ctx, [string]$Name)
    return Get-RCimInstances -Ctx $Ctx -ClassName 'Win32_Service' -Filter "Name='$Name'"
}

# Test connection tier and log a summary banner.
function Write-ConnectionBanner {
    param([pscustomobject]$Ctx)
    if (-not $Ctx) { return }
    $tierColor = switch ($Ctx.Tier) {
        'WinRM' { 'Green'  }
        'DCOM'  { 'Yellow' }
        'UNC'   { 'Red'    }
    }
    $tierNote = switch ($Ctx.Tier) {
        'WinRM' { 'Full remote execution available.'                          }
        'DCOM'  { 'WMI queries + Win32_Process execution. No PS scriptblock.' }
        'UNC'   { 'File access only. Service ops will be skipped.'            }
    }
    Write-Log "  $($Ctx.Hostname) [$($Ctx.Tier)] — $tierNote" 'INFO' $tierColor
}
#endregion

#region Operation 1 — Backup
function Invoke-Backup {
    $script:_ActiveLog = New-LogPath 'Backup'
    $configFile = Join-Path $RootDir "servers.txt"

    Write-Header "Operation 1: Content Server Backup"
    Write-Log "Log file: $($script:_ActiveLog)" 'INFO' 'Gray'

    if (-not (Test-Path $configFile)) {
        Write-Log "servers.txt not found: $configFile" 'ERROR' 'Red'
        return
    }

    $serverGroups, $totalEntries = Parse-ServersFile -Path $configFile
    if ($totalEntries -eq 0) {
        Write-Log "No valid server entries in servers.txt." 'ERROR' 'Red'
        return
    }
    Write-Log "Servers: $totalEntries across $($serverGroups.Keys.Count) zone(s)" 'INFO' 'Gray'

    # Discovery scriptblock — runs via WinRM or DCOM Win32_Process
    $discoverScript = {
        $result = [pscustomobject]@{
            InstanceName      = $null
            TomcatServiceName = $null
            ContentServerDir  = $null
            Errors            = New-Object 'System.Collections.Generic.List[string]'
        }
        try {
            $allSvcs = Get-CimInstance -ClassName Win32_Service -ErrorAction Stop
            $csSvc   = $allSvcs | Where-Object {
                $_.Description -like '*Content Server*' -and
                $_.Description -notlike '*Content Server Admin*'
            } | Select-Object -First 1

            if ($csSvc) {
                $result.InstanceName = $csSvc.Name
                if ($csSvc.PathName) {
                    $exePath = $csSvc.PathName -replace '^"([^"]+)".*$','$1' `
                                               -replace '^([^\s]+\.exe).*$','$1'
                    $dir   = Split-Path $exePath -Parent
                    $csDir = $null
                    for ($i = 0; $i -lt 6; $i++) {
                        if ([IO.Path]::GetFileName($dir) -ieq 'contentserver') { $csDir = $dir; break }
                        $candidate = Join-Path $dir 'contentserver'
                        if (Test-Path $candidate -PathType Container) { $csDir = $candidate; break }
                        $parent = Split-Path $dir -Parent
                        if ($parent -eq $dir) { break }
                        $dir = $parent
                    }
                    if ($csDir) { $result.ContentServerDir = $csDir }
                    else { $result.Errors.Add("WARNING: Could not locate 'contentserver' directory.") }
                } else { $result.Errors.Add("WARNING: Content Server service has no PathName.") }
            } else { $result.Errors.Add("WARNING: No Content Server service found.") }

            $tomcatSvc = $allSvcs | Where-Object { $_.DisplayName -like '*Apache*Tomcat*' } |
                         Select-Object -First 1
            if ($tomcatSvc) { $result.TomcatServiceName = $tomcatSvc.Name }
            else { $result.Errors.Add("WARNING: No Tomcat service found.") }
        }
        catch { $result.Errors.Add("ERROR during discovery: $_") }
        return $result
    }

    # Compression scriptblock — runs via WinRM or DCOM Win32_Process
    $compressScript = {
        param(
            [string[]]$SvcNames,
            [string]$SrcPath,
            [string]$DestPath,
            [string]$DestFolder,
            [string]$SrcFolderName,
            [int]$MaxBackups,
            [int]$StopSec,
            [int]$StartSec
        )
        $h = $env:COMPUTERNAME

        function Wait-Svc {
            param([string]$n, [string]$s, [int]$t, [string]$a)
            $svc = Get-Service -Name $n -ErrorAction Stop
            try {
                $svc.WaitForStatus($s, [TimeSpan]::FromSeconds($t))
                Write-Output "($h) Service '$n' $a."
            }
            catch [System.ServiceProcess.TimeoutException] {
                throw "Timeout waiting for '$n' -> '$s' after ${t}s."
            }
        }

        $stopped = New-Object 'System.Collections.Generic.List[string]'
        try {
            foreach ($sn in $SvcNames) {
                $svc = Get-Service -Name $sn -ErrorAction SilentlyContinue
                if (-not $svc) { Write-Output "($h) WARNING: '$sn' not found. Skipping."; continue }
                if ($svc.Status -eq 'Running') {
                    Write-Output "($h) Stopping '$sn'..."
                    Stop-Service -Name $sn -Force -ErrorAction Stop
                    Wait-Svc $sn 'Stopped' $StopSec 'stopped'
                    $stopped.Add($sn)
                } else { Write-Output "($h) '$sn' already stopped." }
            }
            if (-not (Test-Path $SrcPath -PathType Container)) { throw "Source path not found: $SrcPath" }
            Write-Output "($h) Compressing '$SrcPath' -> '$DestPath'..."
            Compress-Archive -Path $SrcPath -DestinationPath $DestPath -Force
            Write-Output "($h) Compression complete."
            $backups = Get-ChildItem -Path $DestFolder -Filter "${SrcFolderName}_*.zip" | Sort-Object CreationTime
            $excess  = $backups.Count - $MaxBackups
            if ($excess -gt 0) {
                Write-Output "($h) Removing $excess old backup(s)."
                $backups | Select-Object -First $excess | ForEach-Object {
                    Remove-Item $_.FullName -Force
                    Write-Output "($h) Deleted: $($_.Name)"
                }
            }
        }
        catch { throw $_ }
        finally {
            if ($stopped.Count -gt 0) {
                $arr = $stopped.ToArray()
                [array]::Reverse($arr)
                foreach ($sn in $arr) {
                    try {
                        Write-Output "($h) Starting '$sn'..."
                        Start-Service -Name $sn -ErrorAction Stop
                        Wait-Svc $sn 'Running' $StartSec 'started'
                    }
                    catch { Write-Output "($h) ERROR restarting '$sn': $_" }
                }
            }
        }
    }

    # Phase 1: Discovery
    Write-Log "Phase 1: Discovery..." 'INFO' 'Yellow'
    $discoveryResults = @{}

    foreach ($group in $serverGroups.Keys) {
        foreach ($fqdn in $serverGroups[$group]) {
            $ctx = Connect-RemoteServer -Hostname $fqdn
            if (-not $ctx) {
                Write-Log "  ${fqdn}: All connection methods failed — skipping." 'ERROR' 'Red'
                $errList = New-Object 'System.Collections.Generic.List[string]'
                $errList.Add("All connection methods failed.")
                $discoveryResults[$fqdn] = [pscustomobject]@{
                    InstanceName=$null; TomcatServiceName=$null; ContentServerDir=$null
                    Errors=$errList; Ctx=$null
                }
                continue
            }
            Write-ConnectionBanner -Ctx $ctx

            if ($ctx.Tier -eq 'UNC') {
                # UNC only — can't run discovery scriptblock; try WMI via legacy Get-WmiObject
                Write-Log "  ${fqdn}: UNC-only — attempting legacy WMI service discovery..." 'WARN' 'Yellow'
                $errList = New-Object 'System.Collections.Generic.List[string]'
                try {
                    $allSvcs   = Get-WmiObject -Class Win32_Service -ComputerName $fqdn -ErrorAction Stop
                    $csSvc     = $allSvcs | Where-Object {
                        $_.Description -like '*Content Server*' -and
                        $_.Description -notlike '*Content Server Admin*'
                    } | Select-Object -First 1
                    $tomcatSvc = $allSvcs | Where-Object { $_.DisplayName -like '*Apache*Tomcat*' } |
                                 Select-Object -First 1
                    $instName  = if ($csSvc)     { $csSvc.Name }     else { $null }
                    $tomName   = if ($tomcatSvc) { $tomcatSvc.Name } else { $null }
                    if (-not $instName) { $errList.Add("WARNING: No Content Server service found via WMI.") }
                    if (-not $tomName)  { $errList.Add("WARNING: No Tomcat service found via WMI.") }
                    # ContentServerDir — can't resolve path without executing code; skip
                    $errList.Add("WARNING: ContentServerDir not resolvable via UNC-only — backup skipped.")
                    $discoveryResults[$fqdn] = [pscustomobject]@{
                        InstanceName=$instName; TomcatServiceName=$tomName; ContentServerDir=$null
                        Errors=$errList; Ctx=$ctx
                    }
                }
                catch {
                    $errList.Add("ERROR: Legacy WMI failed: $_")
                    $discoveryResults[$fqdn] = [pscustomobject]@{
                        InstanceName=$null; TomcatServiceName=$null; ContentServerDir=$null
                        Errors=$errList; Ctx=$ctx
                    }
                }
                continue
            }

            # WinRM or DCOM — run discovery scriptblock
            try {
                $disc = Invoke-RCmd -Ctx $ctx -Block $discoverScript
                if ($disc) {
                    $disc | Add-Member -NotePropertyName 'Ctx' -NotePropertyValue $ctx -Force
                    $disc.Errors | ForEach-Object { Write-Log "  ${fqdn}: $_" 'WARN' 'Yellow' }
                    Write-Log "  ${fqdn}: Instance='$($disc.InstanceName)' Tomcat='$($disc.TomcatServiceName)' CSDir='$($disc.ContentServerDir)'" 'INFO' 'Gray'
                    $discoveryResults[$fqdn] = $disc
                }
                else {
                    $errList = New-Object 'System.Collections.Generic.List[string]'
                    $errList.Add("Discovery scriptblock returned null.")
                    $discoveryResults[$fqdn] = [pscustomobject]@{
                        InstanceName=$null; TomcatServiceName=$null; ContentServerDir=$null
                        Errors=$errList; Ctx=$ctx
                    }
                }
            }
            catch {
                Write-Log "  ${fqdn}: Discovery FAILED - $_" 'ERROR' 'Red'
                $errList = New-Object 'System.Collections.Generic.List[string]'
                $errList.Add("Discovery failed: $_")
                $discoveryResults[$fqdn] = [pscustomobject]@{
                    InstanceName=$null; TomcatServiceName=$null; ContentServerDir=$null
                    Errors=$errList; Ctx=$ctx
                }
            }
        }
    }

    # Phase 2: Queue jobs
    Write-Log "Phase 2: Queuing compression jobs..." 'INFO' 'Yellow'
    $jobs = New-Object 'System.Collections.Generic.List[pscustomobject]'

    foreach ($group in $serverGroups.Keys) {
        foreach ($fqdn in $serverGroups[$group]) {
            $disc = $discoveryResults[$fqdn]
            if (-not $disc.InstanceName -or -not $disc.ContentServerDir) {
                Write-Log "SKIPPING $fqdn — incomplete discovery (no instance or CS dir)." 'WARN' 'Yellow'
                if ($disc.Ctx) { Disconnect-RemoteServer -Ctx $disc.Ctx }
                continue
            }
            $ctx = $disc.Ctx
            if ($ctx.Tier -eq 'UNC') {
                Write-Log "SKIPPING $fqdn — UNC-only cannot execute backup." 'WARN' 'Yellow'
                Disconnect-RemoteServer -Ctx $ctx
                continue
            }

            $inst     = $disc.InstanceName
            $svcNames = @($BackupConfig.StaticServices | ForEach-Object {
                if ($_ -eq '{TOMCAT}') {
                    if ($disc.TomcatServiceName) { $disc.TomcatServiceName }
                }
                elseif ($_ -eq '{INSTANCE}') { $inst }
                else { $_ -replace [regex]::Escape('{INSTANCE}'), $inst }
            } | Where-Object { $_ })

            $srcPath    = $disc.ContentServerDir
            $destFolder = Split-Path $srcPath -Parent
            $srcName    = Split-Path $srcPath -Leaf
            $destPath   = Join-Path $destFolder "${srcName}_$(Get-Date -Format 'yyyy-MM-dd_HHmmss').zip"

            while ((Get-Job -State Running).Count -ge $BackupConfig.MaxParallelJobs) {
                Start-Sleep -Milliseconds 500
            }

            # For WinRM — use Invoke-Command AsJob (original approach)
            # For DCOM  — use Start-Job that calls Invoke-RCmd (which uses Win32_Process)
            if ($ctx.Tier -eq 'WinRM') {
                $job = Invoke-Command -ComputerName $fqdn -ScriptBlock $compressScript `
                    -ArgumentList $svcNames,$srcPath,$destPath,$destFolder,$srcName, `
                                  $BackupConfig.MaxBackups,$BackupConfig.StopTimeoutSec,$BackupConfig.StartTimeoutSec `
                    -AsJob
                $job.Name = $fqdn
            }
            else {
                # DCOM — wrap in a local job that drives Win32_Process remotely
                $capturedCtx  = $ctx
                $capturedArgs = @($svcNames,$srcPath,$destPath,$destFolder,$srcName,
                                  $BackupConfig.MaxBackups,$BackupConfig.StopTimeoutSec,$BackupConfig.StartTimeoutSec)
                $job = Start-Job -ScriptBlock {
                    param($hostname,$blk,$al)
                    # Re-establish DCOM inside the job
                    $opt = New-CimSessionOption -Protocol Dcom
                    $cs  = New-CimSession -ComputerName $hostname -SessionOption $opt -ErrorAction Stop
                    $innerCtx = [pscustomobject]@{ Tier='DCOM'; Session=$cs; Hostname=$hostname }

                    $guid    = [guid]::NewGuid().ToString('N')
                    $outFile = "C:\Windows\Temp\rcmd_out_$guid.txt"
                    $ps1File = "C:\Windows\Temp\rcmd_$guid.ps1"
                    $uncOut  = "\\$hostname\C`$\Windows\Temp\rcmd_out_$guid.txt"
                    $uncPs1  = "\\$hostname\C`$\Windows\Temp\rcmd_$guid.ps1"

                    $argLines = for ($i = 0; $i -lt $al.Count; $i++) {
                        "`$arg$i = $(ConvertTo-Json $al[$i] -Depth 5 -Compress)"
                    }
                    $argPass  = (0..($al.Count-1) | ForEach-Object { "`$arg$_" }) -join ','
                    $ps1Body  = "$(($argLines) -join "`n")`n& {`n$blk`n} $argPass 2>&1 | Out-File '$outFile' -Encoding utf8"
                    Set-Content -Path $uncPs1 -Value $ps1Body -Encoding UTF8

                    $mc = [wmiclass]"\\$hostname\root\cimv2:Win32_Process"
                    $r  = $mc.Create("powershell.exe -NonInteractive -ExecutionPolicy Bypass -File `"$ps1File`"")
                    if ($r.ReturnValue -ne 0) { throw "Win32_Process.Create failed rc=$($r.ReturnValue)" }
                    $pid2 = $r.ProcessId; $elapsed = 0
                    do {
                        Start-Sleep 2; $elapsed += 2
                        $running = Get-WmiObject -Class Win32_Process -ComputerName $hostname `
                                       -Filter "ProcessId=$pid2" -ErrorAction SilentlyContinue
                    } while ($running -and $elapsed -lt 180)
                    Get-Content $uncOut -ErrorAction SilentlyContinue
                    Remove-Item $uncOut,$uncPs1 -Force -ErrorAction SilentlyContinue
                    Remove-CimSession $cs -ErrorAction SilentlyContinue
                } -ArgumentList $fqdn, $compressScript.ToString(), $capturedArgs
                $job.Name = $fqdn
            }

            $jobs.Add([pscustomobject]@{
                Job          = $job
                ComputerName = $fqdn
                GroupName    = $group
                InstanceName = $inst
                Tier         = $ctx.Tier
            })
        }
    }

    if ($jobs.Count -eq 0) {
        Write-Log "No jobs queued." 'WARN' 'Yellow'
    }
    else {
        $jobs | ForEach-Object { $_.Job } | Wait-Job | Out-Null
        $prevGroup = $null
        foreach ($entry in ($jobs | Sort-Object GroupName,ComputerName)) {
            if ($entry.GroupName -ne $prevGroup) {
                Write-Log "# Zone: $($entry.GroupName)" 'INFO' 'Magenta'
                $prevGroup = $entry.GroupName
            }
            Write-Log "--- $($entry.ComputerName) ($($entry.InstanceName)) [$($entry.Tier)] ---" 'INFO' 'Cyan'
            $entry.Job | Receive-Job | ForEach-Object {
                $c = if     ($_ -match 'ERROR|FAILED')                   { 'Red'    }
                     elseif ($_ -match 'WARNING')                        { 'Yellow' }
                     elseif ($_ -match 'completed|started\.|stopped\.')  { 'Green'  }
                     else                                                { 'Gray'   }
                Write-Log $_ 'INFO' $c
            }
            if ($entry.Job.State -eq 'Completed') {
                Write-Log "RESULT: SUCCESS - $($entry.ComputerName)" 'OK' 'Green'
            }
            else {
                $jobErr = $entry.Job.ChildJobs[0].Error | Select-Object -First 1
                $errMsg = if ($jobErr) { $jobErr.Exception.Message } else { 'Unknown error' }
                Write-Log "RESULT: FAILED - $($entry.ComputerName) | $errMsg" 'ERROR' 'Red'
            }
        }
        $jobs | ForEach-Object { $_.Job | Remove-Job -Force }
    }

    # Disconnect all sessions opened during discovery
    foreach ($fqdn in $discoveryResults.Keys) {
        if ($discoveryResults[$fqdn].Ctx) {
            Disconnect-RemoteServer -Ctx $discoveryResults[$fqdn].Ctx
        }
    }

    Write-Log "Backup operation complete. Log: $($script:_ActiveLog)" 'OK' 'Green'
}
#endregion

#region Operation 2 — System Center Agent Update
function Invoke-SystemCenterUpdate {
    $script:_ActiveLog = New-LogPath 'SystemCenterUpdate'

    Write-Header "Operation 2: System Center Agent Update (Remote — servers.txt)"
    Write-Log "Log: $($script:_ActiveLog)" 'INFO' 'Gray'

    # -----------------------------------------------------------------------
    # Step 0 — Validate servers.txt
    # -----------------------------------------------------------------------
    $configFile = Join-Path $RootDir 'servers.txt'
    if (-not (Test-Path $configFile)) {
        Write-Log "servers.txt not found: $configFile" 'ERROR' 'Red'; return
    }
    $serverGroups, $totalEntries = Parse-ServersFile -Path $configFile
    if ($totalEntries -eq 0) {
        Write-Log "No valid server entries in servers.txt." 'ERROR' 'Red'; return
    }
    Write-Log "Servers: $totalEntries across $($serverGroups.Keys.Count) zone(s)" 'INFO' 'Gray'

    # -----------------------------------------------------------------------
    # Step 1 — Detect MSI version from the patch server (once, locally)
    #          We read the version string embedded in the MSI ProductVersion
    #          property by downloading to a temp location only if we later
    #          find at least one server that needs it.
    #          Strategy:
    #            a) Try HTTP HEAD to confirm server reachable.
    #            b) Defer actual download until first server needs upgrade.
    # -----------------------------------------------------------------------
    $script:_MsiLocalPath   = $null   # set once downloaded
    $script:_MsiVersion     = $null   # ProductVersion from MSI, detected after download
    $script:_MsiDownloaded  = $false
    $script:_MsiTempDir     = $null

    function Get-MsiProductVersion {
        param([string]$MsiPath)
        try {
            $wi  = New-Object -ComObject WindowsInstaller.Installer
            $db  = $wi.GetType().InvokeMember('OpenDatabase', 'InvokeMethod', $null, $wi,
                       @($MsiPath, 0))
            $view = $db.GetType().InvokeMember('OpenView', 'InvokeMethod', $null, $db,
                       @("SELECT Value FROM Property WHERE Property='ProductVersion'"))
            $view.GetType().InvokeMember('Execute', 'InvokeMethod', $null, $view, $null)
            $rec = $view.GetType().InvokeMember('Fetch', 'InvokeMethod', $null, $view, $null)
            if ($rec) {
                return $rec.GetType().InvokeMember('StringData', 'GetProperty', $null, $rec, @(1))
            }
        }
        catch { }
        return $null
    }

    function Ensure-MsiDownloaded {
        if ($script:_MsiDownloaded) { return $script:_MsiLocalPath }
        Write-Log "Downloading MSI from $($SCConfig.MsiUrl) ..." 'INFO' 'Yellow'
        $script:_MsiTempDir = Join-Path $env:TEMP "SCA_$(Get-Date -Format 'yyyyMMdd_HHmmss')"
        New-Item -ItemType Directory -Path $script:_MsiTempDir -Force | Out-Null
        $dest = Join-Path $script:_MsiTempDir $SCConfig.MsiName
        try {
            $wc = New-Object System.Net.WebClient
            $wc.DownloadFile($SCConfig.MsiUrl, $dest)
        }
        catch { throw "MSI download failed: $_" }
        if (-not (Test-Path $dest) -or (Get-Item $dest).Length -eq 0) {
            throw "Downloaded MSI is missing or empty."
        }
        $sizeMB = [math]::Round((Get-Item $dest).Length / 1MB, 2)
        Write-Log "MSI downloaded: $dest ($sizeMB MB)" 'OK' 'Green'
        $script:_MsiLocalPath  = $dest
        $script:_MsiDownloaded = $true
        $script:_MsiVersion    = Get-MsiProductVersion -MsiPath $dest
        if ($script:_MsiVersion) {
            Write-Log "MSI ProductVersion: $($script:_MsiVersion)" 'INFO' 'Gray'
        }
        else {
            Write-Log "Could not read ProductVersion from MSI — version-skip check disabled." 'WARN' 'Yellow'
        }
        return $dest
    }

    # -----------------------------------------------------------------------
    # Scriptblock: detect installed SC agent version on a remote server.
    # Tries registry first (fast), then Win32_Product (slow fallback).
    # Returns version string or $null.
    # -----------------------------------------------------------------------
    $detectVersionBlock = {
        param([string]$InstallDir)
        # Method 1 — Uninstall registry keys (fast)
        $regPaths = @(
            'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall',
            'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall'
        )
        foreach ($rp in $regPaths) {
            if (-not (Test-Path $rp)) { continue }
            foreach ($key in (Get-ChildItem $rp -ErrorAction SilentlyContinue)) {
                $p = Get-ItemProperty $key.PSPath -ErrorAction SilentlyContinue
                if ($p.DisplayName -like '*System Center*' -or $p.DisplayName -like '*OTS*') {
                    if ($p.DisplayVersion) { return $p.DisplayVersion }
                }
            }
        }
        # Method 2 — Win32_Product (slower)
        try {
            $prod = Get-CimInstance -ClassName Win32_Product -ErrorAction Stop |
                    Where-Object { $_.Name -like '*System Center*' -or $_.Name -like '*OTS*' } |
                    Select-Object -First 1
            if ($prod) { return $prod.Version }
        }
        catch { }
        # Method 3 — version.txt in install dir
        $vf = Join-Path $InstallDir 'version.txt'
        if (Test-Path $vf) {
            $m = Get-Content $vf -TotalCount 5 |
                 Select-String '(\d+\.\d+[\.\d]*)' | Select-Object -First 1
            if ($m) { return $m.Matches[0].Groups[1].Value }
        }
        return $null
    }

    # -----------------------------------------------------------------------
    # Scriptblock: full SC agent update — runs on the remote server.
    # Receives the MSI path (already on the remote machine via UNC copy).
    # Returns a result hashtable.
    # -----------------------------------------------------------------------
    $updateBlock = {
        param(
            [string]$MsiRemotePath,
            [string]$InstallDir,
            [string]$LocalhostDir,
            [string]$MsiInstallDir,
            [string]$HttpPort,
            [string]$ServerName,
            [string]$RestoreFile,
            [string]$CopyFile,
            [string[]]$ServiceOrder,
            [int]$StopTimeoutSec,
            [int]$StartTimeoutSec,
            [string]$RemoteLogDir
        )

        $h = $env:COMPUTERNAME
        $msgs = New-Object 'System.Collections.Generic.List[string]'
        $ok   = $true

        function Add-Msg  { param($m,$l='INFO') $msgs.Add("[$l] ($h) $m") }
        function Throw-Op { param($m) $ok = $false; throw $m }

        function Resolve-Services {
            $all  = Get-CimInstance -ClassName Win32_Service -ErrorAction Stop
            $cs   = $all | Where-Object {
                $_.Description -like '*Content Server*' -and
                $_.Description -notlike '*Content Server Admin*'
            } | Select-Object -First 1
            $tc   = $all | Where-Object { $_.DisplayName -like '*Apache*Tomcat*' } |
                    Select-Object -First 1
            $inst = if ($cs) { $cs.Name } else { $null }
            $tom  = if ($tc) { $tc.Name } else { $null }
            return @($ServiceOrder | ForEach-Object {
                switch ($_) {
                    '{TOMCAT}'   { if ($tom)  { $tom  } }
                    '{INSTANCE}' { if ($inst) { $inst } }
                    default {
                        $v = if ($inst) { $inst } else { '' }
                        $_ -replace [regex]::Escape('{INSTANCE}'), $v
                    }
                }
            } | Where-Object { $_ -and $_.Trim() -ne '' })
        }

        function Wait-Svc {
            param([string]$n, [string]$s, [int]$t, [string]$a)
            $svc = Get-Service -Name $n -ErrorAction Stop
            $svc.WaitForStatus($s, [TimeSpan]::FromSeconds($t))
            Add-Msg "Service '$n' $a." 'OK'
        }

        $stopped = New-Object 'System.Collections.Generic.List[string]'
        $backupPath = $null

        try {
            # Phase 1 — resolve + stop services
            Add-Msg "Resolving services..."
            $svcNames = Resolve-Services
            Add-Msg "Service order: $($svcNames -join ' -> ')"
            foreach ($sn in $svcNames) {
                $svc = Get-Service -Name $sn -ErrorAction SilentlyContinue
                if (-not $svc) { Add-Msg "Service '$sn' not found — skipping." 'WARN'; continue }
                if ($svc.Status -eq 'Running') {
                    Add-Msg "Stopping '$sn'..."
                    Stop-Service -Name $sn -Force -ErrorAction Stop
                    Wait-Svc $sn 'Stopped' $StopTimeoutSec 'stopped'
                    $stopped.Add($sn)
                }
                else { Add-Msg "Service '$sn' already stopped." 'WARN' }
            }

            # Phase 2 — backup install dir
            if (-not (Test-Path $InstallDir)) {
                Add-Msg "Install dir not found: $InstallDir — skipping backup." 'WARN'
            }
            else {
                $backupDir  = Split-Path $InstallDir -Parent
                $backupName = "$(Split-Path $InstallDir -Leaf)_backup_$(Get-Date -Format 'yyyyMMdd_HHmmss').zip"
                $backupPath = Join-Path $backupDir $backupName
                Add-Msg "Backing up to $backupPath ..."
                Compress-Archive -Path $InstallDir -DestinationPath $backupPath -Force
                Add-Msg "Backup complete." 'OK'
            }

            # Phase 3 — uninstall current agent
            Add-Msg "Checking for installed SC agent..."
            $installed = $null
            # Registry first
            $regPaths = @(
                'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall',
                'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall'
            )
            $prodCode = $null
            foreach ($rp in $regPaths) {
                if (-not (Test-Path $rp)) { continue }
                foreach ($key in (Get-ChildItem $rp -ErrorAction SilentlyContinue)) {
                    $p = Get-ItemProperty $key.PSPath -ErrorAction SilentlyContinue
                    if ($p.DisplayName -like '*System Center*' -or $p.DisplayName -like '*OTS*') {
                        $prodCode = $p.PSChildName
                        Add-Msg "Found via registry: '$($p.DisplayName)' ($prodCode)"
                        break
                    }
                }
                if ($prodCode) { break }
            }
            if (-not $prodCode) {
                # Fall back to Win32_Product
                try {
                    $installed = Get-CimInstance -ClassName Win32_Product -ErrorAction Stop |
                                 Where-Object { $_.Name -like '*System Center*' -or $_.Name -like '*OTS*' } |
                                 Select-Object -First 1
                    if ($installed) { $prodCode = $installed.IdentifyingNumber }
                }
                catch { Add-Msg "Win32_Product query failed: $_" 'WARN' }
            }
            if ($prodCode) {
                Add-Msg "Uninstalling product code $prodCode ..."
                $unLog = Join-Path $RemoteLogDir "sc_uninstall_$(Get-Date -Format 'yyyyMMdd_HHmmss').log"
                $proc  = Start-Process 'msiexec.exe' `
                    -ArgumentList "/qn /l*vx `"$unLog`" /x `"$prodCode`"" -Wait -PassThru
                if ($proc.ExitCode -ne 0) { Throw-Op "Uninstall failed (exit $($proc.ExitCode)). Log: $unLog" }
                Add-Msg "Uninstall complete." 'OK'
            }
            else { Add-Msg "No SC agent found via registry or Win32_Product — skipping uninstall." 'WARN' }

            # Phase 4 — empty install directory
            if (Test-Path $InstallDir) {
                Add-Msg "Emptying install directory $InstallDir ..."
                Get-ChildItem -Path $InstallDir -Force -ErrorAction SilentlyContinue |
                    ForEach-Object { Remove-Item $_.FullName -Recurse -Force -ErrorAction Stop }
                Add-Msg "Install directory emptied." 'OK'
            }

            # Phase 5 — install new agent from pushed MSI
            if (-not (Test-Path $MsiRemotePath)) { Throw-Op "MSI not found at remote path: $MsiRemotePath" }
            Add-Msg "Installing from $MsiRemotePath ..."
            $instLog  = Join-Path $RemoteLogDir "sc_install_$(Get-Date -Format 'yyyyMMdd_HHmmss').log"
            $instArgs = "/qn /l*vx `"$instLog`" /i `"$MsiRemotePath`" " +
                        "HTTP_PORT_NUMBER=`"$HttpPort`" " +
                        "SERVER_NAME=`"$ServerName`" " +
                        "INSTALLDIR=`"$MsiInstallDir`""
            $proc = Start-Process 'msiexec.exe' -ArgumentList $instArgs -Wait -PassThru
            if ($proc.ExitCode -ne 0) { Throw-Op "Install failed (exit $($proc.ExitCode)). Log: $instLog" }
            Add-Msg "Install complete. Log: $instLog" 'OK'

            # Phase 6 — restore configuration.conf.ini from backup zip
            if ($backupPath -and (Test-Path $backupPath)) {
                Add-Msg "Restoring '$RestoreFile' from backup zip..."
                Add-Type -AssemblyName System.IO.Compression.FileSystem
                $tmpEx = Join-Path $env:TEMP "SCA_restore_$(Get-Date -Format 'yyyyMMdd_HHmmss')"
                New-Item -ItemType Directory -Path $tmpEx -Force | Out-Null
                $zip = [System.IO.Compression.ZipFile]::OpenRead($backupPath)
                try {
                    $entry = $zip.Entries | Where-Object { $_.Name -ieq $RestoreFile } |
                             Select-Object -First 1
                    if (-not $entry) { throw "'$RestoreFile' not found in backup zip." }
                    [System.IO.Compression.ZipFileExtensions]::ExtractToFile(
                        $entry, (Join-Path $tmpEx $RestoreFile), $true)
                }
                finally { $zip.Dispose() }
                Move-Item (Join-Path $tmpEx $RestoreFile) (Join-Path $InstallDir $RestoreFile) -Force
                Remove-Item $tmpEx -Recurse -Force -ErrorAction SilentlyContinue
                Add-Msg "Restored '$RestoreFile'." 'OK'
            }
            else { Add-Msg "No backup available — skipping '$RestoreFile' restore." 'WARN' }

            # Phase 7 — copy conf.ini from localhost\configuration\
            $confSrc  = Join-Path $LocalhostDir "configuration\$CopyFile"
            $confDest = Join-Path $InstallDir $CopyFile
            if (Test-Path $confSrc) {
                Copy-Item -Path $confSrc -Destination $confDest -Force
                Add-Msg "Copied '$CopyFile' from localhost folder." 'OK'
            }
            else { Add-Msg "'$CopyFile' not found at $confSrc — skipping." 'WARN' }
        }
        catch {
            Add-Msg "FATAL: $_" 'ERROR'
            $ok = $false
        }
        finally {
            # Phase 8 — restart services (always)
            if ($stopped.Count -gt 0) {
                $arr = $stopped.ToArray(); [array]::Reverse($arr)
                foreach ($sn in $arr) {
                    $svc = Get-Service -Name $sn -ErrorAction SilentlyContinue
                    if (-not $svc) { Add-Msg "Service '$sn' not found during restart." 'WARN'; continue }
                    try {
                        Add-Msg "Starting '$sn'..."
                        Start-Service -Name $sn -ErrorAction Stop
                        Wait-Svc $sn 'Running' $StartTimeoutSec 'started'
                    }
                    catch { Add-Msg "ERROR starting '$sn': $_" 'ERROR'; $ok = $false }
                }
            }
        }

        return [pscustomobject]@{ Success = $ok; Messages = $msgs.ToArray() }
    }

    # -----------------------------------------------------------------------
    # Main loop — iterate servers, connect, version-check, update if needed
    # -----------------------------------------------------------------------
    $pass = 0; $fail = 0; $skip = 0
    $prevGroup = $null

    foreach ($group in $serverGroups.Keys) {
        foreach ($fqdn in $serverGroups[$group]) {

            if ($group -ne $prevGroup) {
                Write-Log "# Zone: $group" 'INFO' 'Magenta'
                $prevGroup = $group
            }
            Write-Log "--- $fqdn ---" 'INFO' 'Cyan'

            # Connect
            $ctx = Connect-RemoteServer -Hostname $fqdn
            if (-not $ctx) { Write-Log "  SKIPPED — no connection." 'ERROR' 'Red'; $fail++; continue }
            Write-ConnectionBanner -Ctx $ctx

            if ($ctx.Tier -eq 'UNC') {
                Write-Log "  SKIPPED — UNC-only, cannot run MSI installer." 'WARN' 'Yellow'
                Disconnect-RemoteServer -Ctx $ctx; $skip++; continue
            }

            # Version check — skip if already current
            $installedVer = $null
            try {
                $installedVer = Invoke-RCmd -Ctx $ctx -Block $detectVersionBlock `
                                    -Args @($SCConfig.InstallDir)
                if ($installedVer) {
                    Write-Log "  Installed SC agent version: $installedVer" 'INFO' 'Gray'
                }
                else {
                    Write-Log "  SC agent version not detected — will proceed with update." 'WARN' 'Yellow'
                }
            }
            catch {
                Write-Log "  Version detection failed: $_ — proceeding anyway." 'WARN' 'Yellow'
            }

            # Download MSI now if not yet done (deferred until first server needs it)
            $msiLocalPath = $null
            try { $msiLocalPath = Ensure-MsiDownloaded }
            catch {
                Write-Log "  SKIPPED — MSI download failed: $_" 'ERROR' 'Red'
                Disconnect-RemoteServer -Ctx $ctx; $fail++; continue
            }

            # Skip if versions match
            if ($installedVer -and $script:_MsiVersion -and ($installedVer -eq $script:_MsiVersion)) {
                Write-Log "  Already on version $installedVer — skipping." 'OK' 'Green'
                Disconnect-RemoteServer -Ctx $ctx; $skip++; continue
            }

            # Push MSI to remote server via UNC
            $remoteMsiDir  = 'C:\Windows\Temp\SCA_Deploy'
            $remoteMsiPath = "$remoteMsiDir\$($SCConfig.MsiName)"
            $uncMsiDir     = "\\$fqdn\C`$\Windows\Temp\SCA_Deploy"
            $uncMsiPath    = "$uncMsiDir\$($SCConfig.MsiName)"

            Write-Log "  Pushing MSI to $uncMsiDir ..." 'INFO' 'White'
            try {
                if (-not (Test-Path $uncMsiDir)) {
                    New-Item -ItemType Directory -Path $uncMsiDir -Force | Out-Null
                }
                Copy-Item -Path $msiLocalPath -Destination $uncMsiPath -Force
                Write-Log "  MSI staged at $remoteMsiPath" 'OK' 'Green'
            }
            catch {
                Write-Log "  SKIPPED — could not push MSI via UNC: $_" 'ERROR' 'Red'
                Disconnect-RemoteServer -Ctx $ctx; $fail++; continue
            }

            # Ensure remote log dir exists
            $remoteLogDir = 'C:\Logs'
            $uncLogDir    = "\\$fqdn\C`$\Logs"
            if (-not (Test-Path $uncLogDir)) {
                New-Item -ItemType Directory -Path $uncLogDir -Force -ErrorAction SilentlyContinue | Out-Null
            }

            # Run the update block remotely
            Write-Log "  Running update (this may take several minutes)..." 'INFO' 'White'
            $result = $null
            try {
                $result = Invoke-RCmd -Ctx $ctx -Block $updateBlock -Args @(
                    $remoteMsiPath,
                    $SCConfig.InstallDir,
                    $SCConfig.LocalhostDir,
                    $SCConfig.MsiInstallDir,
                    $SCConfig.HttpPort,
                    $SCConfig.ServerName,
                    $SCConfig.RestoreFile,
                    $SCConfig.CopyFile,
                    $SCConfig.ServiceOrder,
                    $SCConfig.StopTimeoutSec,
                    $SCConfig.StartTimeoutSec,
                    $remoteLogDir
                )
            }
            catch {
                Write-Log "  Remote execution error: $_" 'ERROR' 'Red'
                $fail++
                Disconnect-RemoteServer -Ctx $ctx
                # Clean up pushed MSI
                Remove-Item $uncMsiPath -Force -ErrorAction SilentlyContinue
                continue
            }

            # Log messages returned from remote block
            if ($result -and $result.Messages) {
                foreach ($msg in $result.Messages) {
                    $c = if     ($msg -match '\[ERROR\]') { 'Red'    }
                         elseif ($msg -match '\[WARN\]')  { 'Yellow' }
                         elseif ($msg -match '\[OK\]')    { 'Green'  }
                         else                             { 'Gray'   }
                    Write-Log $msg 'INFO' $c
                }
            }

            if ($result -and $result.Success) {
                Write-Log "  RESULT: SUCCESS — $fqdn" 'OK' 'Green'
                $pass++
            }
            else {
                Write-Log "  RESULT: FAILED — $fqdn" 'ERROR' 'Red'
                $fail++
            }

            # Clean up pushed MSI from remote temp
            Remove-Item $uncMsiPath -Force -ErrorAction SilentlyContinue
            try { Remove-Item $uncMsiDir -Force -ErrorAction SilentlyContinue } catch { }

            Disconnect-RemoteServer -Ctx $ctx
        }
    }

    # Clean up local MSI temp dir
    if ($script:_MsiTempDir -and (Test-Path $script:_MsiTempDir)) {
        Remove-Item $script:_MsiTempDir -Recurse -Force -ErrorAction SilentlyContinue
        Write-Log "Local MSI temp folder cleaned up." 'OK' 'Green'
    }

    Write-Host ''
    Write-Host ("  SC Agent Update complete — Success: {0}   Failed: {1}   Skipped: {2}   Total: {3}" `
        -f $pass, $fail, $skip, ($pass+$fail+$skip)) -ForegroundColor Cyan
    Write-Log "System Center update complete. Log: $($script:_ActiveLog)" 'OK' 'Green'
}
#endregion

#region Operation 3 — Tomcat Upgrade
function Invoke-TomcatUpgrade {
    $script:_ActiveLog = New-LogPath 'TomcatUpgrade'

    Write-Header "Operation 3: Tomcat Upgrade"
    Write-Log "Log: $($script:_ActiveLog)" 'INFO' 'Gray'

    $NewVersionPath    = $TomcatConfig.NewVersionPath
    $ServersFile       = $TomcatConfig.ServersFile
    $ThrottleLimit     = $TomcatConfig.ThrottleLimit
    $ServiceCandidates = $TomcatConfig.ServiceCandidates
    $LogFile           = $script:_ActiveLog

    if (-not (Test-Path $ServersFile))    { Write-Log "servers.txt not found: $ServersFile"       'ERROR' 'Red'; return }
    if (-not (Test-Path $NewVersionPath)) { Write-Log "NewVersion path not found: $NewVersionPath" 'ERROR' 'Red'; return }

    $servers = @(Get-Content $ServersFile |
                 Where-Object { $_.Trim() -ne '' -and $_ -notmatch '^#' -and $_ -notmatch '^\[' })
    Write-Log "Loaded $($servers.Count) server(s)." 'INFO' 'Gray'

    $localNames = @(
        'localhost', '127.0.0.1', '::1',
        $env:COMPUTERNAME,
        (($env:COMPUTERNAME + '.' + $env:USERDNSDOMAIN).TrimEnd('.'))
    )

    # ---- Detect new Tomcat version ----
    $newVersion   = $null
    $releaseNotes = @('RELEASE-NOTES','CHANGELOG.md','CHANGELOG') |
        ForEach-Object { Join-Path $NewVersionPath $_ } |
        Where-Object   { Test-Path $_ } |
        Select-Object  -First 1

    if ($releaseNotes) {
        $vl = Get-Content $releaseNotes -TotalCount 20 |
              Select-String -Pattern '(\d+\.\d+\.\d+)' | Select-Object -First 1
        if ($vl) {
            $newVersion = $vl.Matches[0].Value
            Write-Log "Detected version: $newVersion from $(Split-Path $releaseNotes -Leaf)" 'OK' 'Green'
        }
    }
    if (-not $newVersion) {
        $catJar = Join-Path $NewVersionPath "lib\catalina.jar"
        if (Test-Path $catJar) {
            Add-Type -AssemblyName System.IO.Compression.FileSystem
            try {
                $zip = [System.IO.Compression.ZipFile]::OpenRead($catJar)
                $mf  = $zip.Entries | Where-Object { $_.FullName -eq 'META-INF/MANIFEST.MF' }
                if ($mf) {
                    $rdr     = New-Object System.IO.StreamReader($mf.Open())
                    $content = $rdr.ReadToEnd()
                    $rdr.Close()
                    $m = [regex]::Match($content, 'Implementation-Version:\s*(\d+\.\d+\.\d+)')
                    if ($m.Success) {
                        $newVersion = $m.Groups[1].Value
                        Write-Log "Detected version $newVersion from catalina.jar." 'OK' 'Green'
                    }
                }
                $zip.Dispose()
            }
            catch { Write-Log "Could not read catalina.jar: $_" 'WARN' 'Yellow' }
        }
    }
    if (-not $newVersion) { Write-Log "Could not detect new version — version comparison skipped." 'WARN' 'Yellow' }

    # ---- Protect conf files in NewVersion\conf ----
    $confPath = Join-Path $NewVersionPath 'conf'
    if (Test-Path $confPath) {
        foreach ($f in @('web.xml','server.xml','tomcat-users.xml','tomcat-users.xsd')) {
            $fp = Join-Path $confPath $f
            if (Test-Path $fp) {
                try {
                    Rename-Item -Path $fp -NewName ($f + '.new') -ErrorAction Stop
                    Write-Log "Renamed '$f' -> '$f.new' in NewVersion\conf." 'WARN' 'Yellow'
                }
                catch { Write-Log "Failed to rename '$f': $_" 'ERROR' 'Red' }
            }
        }
    }

    # ---- Enumerate Tomcat services (runs remotely via Invoke-RCmd or WMI) ----
    $enumSvcsBlock = {
        param($candidates)
        $svcs = @(Get-Service -Name '*Tomcat*' -ErrorAction SilentlyContinue)
        if ($svcs.Count -eq 0) {
            $svcs = @(Get-Service -DisplayName '*Apache Tomcat*' -ErrorAction SilentlyContinue)
        }
        $results  = @()
        $seenDirs = New-Object 'System.Collections.Generic.HashSet[string]' -ArgumentList ([System.StringComparer]::OrdinalIgnoreCase)

        foreach ($svc in $svcs) {
            $installDir  = $null
            $regPath     = "HKLM:\SYSTEM\CurrentControlSet\Services\$($svc.Name)"
            $props       = Get-ItemProperty -Path $regPath -ErrorAction SilentlyContinue
            $imagePath   = $props.ImagePath
            $description = $props.Description
            if ($imagePath) {
                $exePath    = $imagePath.Trim('"').Split(' ')[0]
                $tomcatRoot = Split-Path (Split-Path $exePath -Parent) -Parent
                if ((Test-Path "$tomcatRoot\bin") -and (Test-Path "$tomcatRoot\lib")) {
                    $installDir = $tomcatRoot
                }
            }
            if (-not $installDir) {
                foreach ($c in $candidates) {
                    if ((Test-Path "$c\bin") -and (Test-Path "$c\lib")) { $installDir = $c; break }
                }
            }
            if (-not $installDir) { continue }
            $nd = $installDir.TrimEnd('\').ToLower()
            if ($seenDirs.Contains($nd)) { continue }
            $null = $seenDirs.Add($nd)

            $iv  = $null
            $jp  = Join-Path $installDir 'lib\catalina.jar'
            if (Test-Path $jp) {
                Add-Type -AssemblyName System.IO.Compression.FileSystem
                try {
                    $z  = [System.IO.Compression.ZipFile]::OpenRead($jp)
                    $mf = $z.Entries | Where-Object { $_.FullName -eq 'META-INF/MANIFEST.MF' }
                    if ($mf) {
                        $r  = New-Object System.IO.StreamReader($mf.Open())
                        $ct = $r.ReadToEnd()
                        $r.Close()
                        $mm = [regex]::Match($ct, 'Implementation-Version:\s*(\d+\.\d+\.\d+)')
                        if ($mm.Success) { $iv = $mm.Groups[1].Value }
                    }
                    $z.Dispose()
                }
                catch { }
            }
            # Also use DescVersion as fallback if catalina.jar unreadable
            $dv = $null
            if ($description) {
                $dm = [regex]::Match($description, '(\d+\.\d+\.\d+)')
                if ($dm.Success) { $dv = $dm.Groups[1].Value }
            }
            if (-not $iv -and $dv) { $iv = $dv }

            $results += [PSCustomObject]@{
                Name             = $svc.Name
                DisplayName      = $svc.DisplayName
                Description      = $description
                DescVersion      = $dv
                Status           = $svc.Status
                InstallDir       = $installDir
                NormalizedDir    = $nd
                InstalledVersion = $iv
            }
        }
        return $results
    }

    # UNC-only version detection — reads catalina.jar via UNC path directly
    function Get-TomcatVersionViaUnc {
        param([string]$Hostname, [string[]]$Candidates)
        Add-Type -AssemblyName System.IO.Compression.FileSystem
        foreach ($c in $Candidates) {
            $unc = "\\$Hostname\$($c -replace '^([A-Za-z]):\\', '$1$\')\lib\catalina.jar"
            if (Test-Path $unc) {
                try {
                    $z  = [System.IO.Compression.ZipFile]::OpenRead($unc)
                    $mf = $z.Entries | Where-Object { $_.FullName -eq 'META-INF/MANIFEST.MF' }
                    if ($mf) {
                        $r   = New-Object System.IO.StreamReader($mf.Open())
                        $ct  = $r.ReadToEnd()
                        $r.Close()
                        $z.Dispose()
                        $mm  = [regex]::Match($ct, 'Implementation-Version:\s*(\d+\.\d+\.\d+)')
                        if ($mm.Success) {
                            return [pscustomobject]@{
                                InstalledVersion = $mm.Groups[1].Value
                                InstallDir       = $c
                                NormalizedDir    = $c.TrimEnd('\').ToLower()
                                Name             = 'Unknown-UNC'
                            }
                        }
                    }
                    else { $z.Dispose() }
                }
                catch { }
            }
        }
        return $null
    }

    # ---- Deploy scriptblock (runs as Start-Job) ----
    $DeployBlock = {
        param(
            [string]$server,
            [string]$installDir,
            [string]$svcName,
            [string]$NewVersionPath,
            [string[]]$ServiceMapCandidates,
            [string]$LogFile,
            [string]$newVersion,
            [string]$ConnectionTier   # 'WinRM' | 'DCOM' | 'UNC'
        )

        $LogLock = New-Object System.Threading.Mutex($false, 'TomcatDeployLog')

        function Write-TLog {
            param([string]$Msg, [string]$Level = 'INFO')
            $ts    = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
            $label = "$server $svcName"
            $line  = "[$ts] [$Level] [$label] $Msg"
            $color = switch ($Level) {
                'ERROR' { 'Red'    }
                'WARN'  { 'Yellow' }
                'OK'    { 'Green'  }
                default { 'Cyan'   }
            }
            $null = $LogLock.WaitOne()
            try {
                Write-Host $line -ForegroundColor $color
                Add-Content -Path $LogFile -Value $line
            }
            finally { $LogLock.ReleaseMutex() }
        }

        $result = [PSCustomObject]@{
            Server        = $server
            SvcName       = $svcName
            InstallDir    = $installDir
            Success       = $false
            NeedsRollback = $false
            BackupPath    = $null
            Error         = $null
            Tier          = $ConnectionTier
        }

        if ($ConnectionTier -eq 'UNC') {
            Write-TLog 'UNC-only connection — cannot execute service operations. Skipping.' 'WARN'
            $result.Error = 'UNC-only: no remote execution'
            return $result
        }

        $localNames = @(
            'localhost','127.0.0.1','::1',
            $env:COMPUTERNAME,
            (($env:COMPUTERNAME + '.' + $env:USERDNSDOMAIN).TrimEnd('.'))
        )
        $isLocal = $localNames -contains $server

        # Establish connection
        $session  = $null
        $useWinRM = $false
        if ($ConnectionTier -eq 'WinRM') {
            try {
                if (-not $isLocal) {
                    $session  = New-PSSession -ComputerName $server -ErrorAction Stop
                    $useWinRM = $true
                    Write-TLog 'WinRM session established.' 'OK'
                }
                else { $useWinRM = $true; Write-TLog 'Local machine.' 'OK' }
            }
            catch {
                Write-TLog "WinRM session failed: $_ — falling back to DCOM." 'WARN'
                $ConnectionTier = 'DCOM'
            }
        }

        if ($ConnectionTier -eq 'DCOM') {
            Write-TLog 'Using DCOM (Win32_Process) for remote execution.' 'WARN'
        }

        function Invoke-Step {
            param([scriptblock]$sb, [object[]]$al = @())
            if ($useWinRM) {
                if ($isLocal) { return & $sb @al }
                return Invoke-Command -Session $session -ScriptBlock $sb -ArgumentList $al
            }
            # DCOM path
            $guid    = [guid]::NewGuid().ToString('N')
            $outFile = "C:\Windows\Temp\dep_out_$guid.txt"
            $ps1File = "C:\Windows\Temp\dep_$guid.ps1"
            $uncOut  = "\\$server\C`$\Windows\Temp\dep_out_$guid.txt"
            $uncPs1  = "\\$server\C`$\Windows\Temp\dep_$guid.ps1"
            $argLines = for ($i = 0; $i -lt $al.Count; $i++) {
                "`$a$i = $(ConvertTo-Json $al[$i] -Depth 5 -Compress)"
            }
            $argPass = (0..($al.Count-1) | ForEach-Object { "`$a$_" }) -join ','
            $body    = "$(($argLines) -join "`n")`n& {`n$($sb.ToString())`n} $argPass 2>&1 | Out-File '$outFile' -Encoding utf8"
            Set-Content -Path $uncPs1 -Value $body -Encoding UTF8
            $mc = [wmiclass]"\\$server\root\cimv2:Win32_Process"
            $r  = $mc.Create("powershell.exe -NonInteractive -ExecutionPolicy Bypass -File `"$ps1File`"")
            if ($r.ReturnValue -ne 0) { throw "Win32_Process.Create failed rc=$($r.ReturnValue)" }
            $pid2 = $r.ProcessId; $elapsed = 0
            do {
                Start-Sleep 2; $elapsed += 2
                $running = Get-WmiObject -Class Win32_Process -ComputerName $server `
                               -Filter "ProcessId=$pid2" -ErrorAction SilentlyContinue
            } while ($running -and $elapsed -lt 180)
            $out = Get-Content $uncOut -ErrorAction SilentlyContinue
            Remove-Item $uncOut,$uncPs1 -Force -ErrorAction SilentlyContinue
            return $out
        }

        try {
            Write-TLog "Stopping $svcName..."
            Invoke-Step -sb {
                param($s)
                Stop-Service -Name $s -Force -ErrorAction Stop
                $t = 60; $e = 0
                while ((Get-Service -Name $s).Status -ne 'Stopped' -and $e -lt $t) {
                    Start-Sleep 2; $e += 2
                }
                if ((Get-Service -Name $s).Status -ne 'Stopped') { throw "Service did not stop." }
            } -al $svcName
            Write-TLog "$svcName stopped." 'OK'

            $ts             = Get-Date -Format 'yyyyMMdd_HHmmss'
            $bp             = $installDir + '_backup_' + $ts + '.zip'
            $result.BackupPath = $bp
            Write-TLog "Backing up to $bp..."
            Invoke-Step -sb {
                param($s, $d)
                if (-not (Test-Path $s)) { throw "Dir not found: $s" }
                Compress-Archive -Path "$s\*" -DestinationPath $d -Force
            } -al $installDir, $bp
            Write-TLog 'Backup created.' 'OK'

            $tmp = "C:\Windows\Temp\TomcatNewVersion_$ts"
            Invoke-Step -sb {
                param($t)
                if (Test-Path $t) { Remove-Item $t -Recurse -Force }
                New-Item -ItemType Directory -Path $t | Out-Null
            } -al $tmp

            # Copy new version files — WinRM uses Copy-Item -ToSession; DCOM uses UNC
            if ($useWinRM -and -not $isLocal) {
                Copy-Item -Path "$NewVersionPath\*" -Destination $tmp -ToSession $session -Recurse -Force
            }
            else {
                $uncTmp = "\\$server\$($tmp -replace '^([A-Za-z]):\\', '$1$\')"
                Copy-Item -Path "$NewVersionPath\*" -Destination $uncTmp -Recurse -Force
            }
            Write-TLog 'Files staged.' 'OK'

            Invoke-Step -sb {
                param($d, $t)
                Copy-Item -Path "$t\*" -Destination $d -Recurse -Force
                Remove-Item $t -Recurse -Force
            } -al $installDir, $tmp
            Write-TLog 'Install dir updated.' 'OK'

            Invoke-Step -sb {
                param($s)
                Start-Service -Name $s -ErrorAction Stop
                $t = 60; $e = 0
                while ((Get-Service -Name $s).Status -ne 'Running' -and $e -lt $t) {
                    Start-Sleep 2; $e += 2
                }
                if ((Get-Service -Name $s).Status -ne 'Running') {
                    throw "Service did not reach Running state."
                }
            } -al $svcName
            Write-TLog "$svcName started." 'OK'
            $result.Success = $true
        }
        catch {
            Write-TLog "Error: $_" 'ERROR'
            $result.Error         = $_
            $result.NeedsRollback = $true
        }
        finally {
            if ($session) { Remove-PSSession $session -ErrorAction SilentlyContinue }
        }
        return $result
    }

    # ---- Pre-flight ----
    Write-Log '========== Pre-flight ==========' 'INFO' 'Yellow'
    $deployedKeys   = New-Object 'System.Collections.Generic.HashSet[string]' -ArgumentList ([System.StringComparer]::OrdinalIgnoreCase)
    $skipServers    = New-Object 'System.Collections.Generic.List[string]'
    $serverTierMap  = @{}   # fqdn -> connection tier string

    foreach ($s in ($servers | ForEach-Object { $_.Trim() })) {
        $isLocal = $localNames -contains $s
        if (-not $isLocal -and -not (Test-Connection -ComputerName $s -Count 1 -Quiet)) {
            Write-Log "$s - UNREACHABLE - will be skipped." 'WARN' 'Yellow'
            continue
        }

        # Establish connection to determine tier
        $ctx = if ($isLocal) { [pscustomobject]@{ Tier='WinRM'; Session=$null; Hostname=$s } }
               else          { Connect-RemoteServer -Hostname $s }
        if (-not $ctx) { continue }
        $serverTierMap[$s] = $ctx.Tier
        Write-ConnectionBanner -Ctx $ctx

        $svcList = $null
        if ($ctx.Tier -eq 'UNC') {
            # UNC-only: read catalina.jar via UNC for version detection
            Write-Log "$s - UNC-only: reading version via UNC path..." 'WARN' 'Yellow'
            $vResult = Get-TomcatVersionViaUnc -Hostname $s -Candidates $ServiceCandidates
            if ($vResult) {
                $svcList = @($vResult)
                Write-Log "$s - Detected version $($vResult.InstalledVersion) at $($vResult.InstallDir) via UNC." 'INFO' 'Gray'
            }
            else {
                Write-Log "$s - Could not detect Tomcat version via UNC." 'WARN' 'Yellow'
            }
        }
        elseif ($isLocal) {
            $svcList = & $enumSvcsBlock $ServiceCandidates
        }
        else {
            try {
                $svcList = Invoke-RCmd -Ctx $ctx -Block $enumSvcsBlock -Args @(,$ServiceCandidates)
            }
            catch { Write-Log "$s - Could not query services: $_" 'WARN' 'Yellow' }
        }

        Disconnect-RemoteServer -Ctx $ctx
        $svcList = @($svcList)
        if ($svcList.Count -eq 0) { Write-Log "$s - No Tomcat services found." 'WARN' 'Yellow'; continue }

        foreach ($svcEntry in $svcList) {
            $dk = ($s + '::' + $svcEntry.NormalizedDir).ToLower()
            if ($deployedKeys.Contains($dk)) { continue }
            if ($newVersion -and $svcEntry.InstalledVersion -eq $newVersion) {
                Write-Log "$s - $($svcEntry.InstallDir) already on $newVersion — skipping." 'WARN' 'Yellow'
                $skipServers.Add($dk)
                continue
            }
            if ($serverTierMap[$s] -eq 'UNC') {
                Write-Log "$s - $($svcEntry.InstallDir) version=$($svcEntry.InstalledVersion) [UNC-only — deploy will be SKIPPED]." 'WARN' 'Yellow'
            }
            else {
                Write-Log "$s - $($svcEntry.Name) at $($svcEntry.InstallDir) queued [$($serverTierMap[$s])]." 'OK' 'Green'
            }
            $null = $deployedKeys.Add($dk)
        }
    }

    $deployTargets = @($deployedKeys | Where-Object { $skipServers -notcontains $_ } | ForEach-Object {
        $p = $_ -split '::', 2
        [PSCustomObject]@{ Server = $p[0]; NormalizedDir = $p[1] }
    })

    if ($deployTargets.Count -eq 0) {
        Write-Log "All servers already on version $newVersion — nothing to deploy." 'OK' 'Green'
        return
    }
    Write-Log "Deploying to $($deployTargets.Count) target(s)." 'INFO' 'Yellow'

    # Resolve service name from normalized install dir
    $resolveBlock = {
        param($dir)
        $svcs = @(Get-Service -Name '*Tomcat*' -ErrorAction SilentlyContinue)
        if ($svcs.Count -eq 0) {
            $svcs = @(Get-Service -DisplayName '*Apache Tomcat*' -ErrorAction SilentlyContinue)
        }
        foreach ($svc in $svcs) {
            $rp = (Get-ItemProperty "HKLM:\SYSTEM\CurrentControlSet\Services\$($svc.Name)" `
                   -ErrorAction SilentlyContinue).ImagePath
            if ($rp) {
                $ex = $rp.Trim('"').Split(' ')[0]
                $tr = Split-Path (Split-Path $ex -Parent) -Parent
                if ($tr.TrimEnd('\').ToLower() -eq $dir) { return $svc.Name }
            }
        }
        return $null
    }

    $jobs = @()
    foreach ($target in $deployTargets) {
        $srv  = $target.Server
        $dir  = $target.NormalizedDir
        $tier = if ($serverTierMap.ContainsKey($srv)) { $serverTierMap[$srv] } else { 'WinRM' }

        if ($tier -eq 'UNC') {
            Write-Log "SKIPPING $srv at $dir — UNC-only, no remote execution." 'WARN' 'Yellow'
            continue
        }

        $isLocalTarget = $localNames -contains $srv
        $rsn = $null
        if ($isLocalTarget) { $rsn = & $resolveBlock $dir }
        else {
            $ctx2 = Connect-RemoteServer -Hostname $srv
            if ($ctx2) {
                try { $rsn = Invoke-RCmd -Ctx $ctx2 -Block $resolveBlock -Args @($dir) }
                catch { }
                Disconnect-RemoteServer -Ctx $ctx2
            }
        }
        if (-not $rsn) { Write-Log "Could not resolve service for $srv at $dir — skipping." 'ERROR' 'Red'; continue }
        Write-Log "Queuing $srv - $rsn at $dir [$tier]..." 'INFO' 'Gray'
        $jobs += Start-Job -ScriptBlock $DeployBlock `
            -ArgumentList $srv, $dir, $rsn, $NewVersionPath, $ServiceCandidates, $LogFile, $newVersion, $tier
        while (@(Get-Job -State Running).Count -ge $ThrottleLimit) { Start-Sleep 1 }
    }

    Write-Log "Waiting for all jobs..." 'INFO' 'Yellow'
    $results = $jobs | Wait-Job | Receive-Job
    $jobs | Remove-Job

    # ---- Rollback ----
    $script:RollbackAll = $false
    $failed = @($results | Where-Object { $_.NeedsRollback })
    if ($failed.Count -gt 0) {
        foreach ($r in $failed) {
            $doRollback = $false
            if ($script:RollbackAll) { $doRollback = $true }
            else {
                Write-Host ''
                Write-Host "  Deployment FAILED: $($r.Server) - $($r.SvcName)" -ForegroundColor Red
                Write-Host '  [1] Roll back this instance'
                Write-Host '  [2] Roll back this and all remaining failed instances'
                Write-Host '  [3] Skip rollback'
                $ch = Read-Host '  Choice (1/2/3)'
                switch ($ch.Trim()) {
                    '1' { $doRollback = $true }
                    '2' { $doRollback = $true; $script:RollbackAll = $true }
                }
            }
            if ($doRollback) {
                $rbCtx = Connect-RemoteServer -Hostname $r.Server
                if (-not $rbCtx) {
                    Write-Log "ROLLBACK FAILED: $($r.Server) — cannot connect." 'ERROR' 'Red'
                    continue
                }
                try {
                    Invoke-RCmd -Ctx $rbCtx -Block {
                        param($svc, $dir, $bak)
                        $s = Get-Service -Name $svc -ErrorAction SilentlyContinue
                        if ($s -and $s.Status -ne 'Stopped') {
                            Stop-Service -Name $svc -Force -ErrorAction SilentlyContinue
                            Start-Sleep 5
                        }
                        if (-not $bak -or -not (Test-Path $bak)) { throw "Backup not found: $bak" }
                        if (Test-Path $dir) { Remove-Item "$dir\*" -Recurse -Force }
                        Expand-Archive -Path $bak -DestinationPath $dir -Force
                        Start-Service -Name $svc -ErrorAction Stop
                    } -Args @($r.SvcName, $r.InstallDir, $r.BackupPath)
                    Write-Log "Rollback successful: $($r.Server) $($r.SvcName)" 'OK' 'Green'
                }
                catch {
                    Write-Log "ROLLBACK FAILED: $($r.Server) $($r.SvcName) — $_ — MANUAL INTERVENTION REQUIRED" 'ERROR' 'Red'
                }
                finally { Disconnect-RemoteServer -Ctx $rbCtx }
            }
        }
    }
    else { Write-Log 'All deployments successful.' 'OK' 'Green' }

    Write-Log "Tomcat upgrade complete. Log: $($script:_ActiveLog)" 'OK' 'Green'
}
#endregion

#region Operation S — Stage Software
function Invoke-StageSoftware {
    $script:_ActiveLog = New-LogPath 'Stage'

    Write-Header "Stage Software to Servers"
    Write-Log "Log: $($script:_ActiveLog)" 'INFO' 'Gray'

    $missing = @($StageConfig.Items | Where-Object { -not (Test-Path (Join-Path $RootDir $_.RelPath)) })
    if ($missing.Count -gt 0) {
        foreach ($m in $missing) {
            Write-Log "Source not found: $(Join-Path $RootDir $m.RelPath)" 'ERROR' 'Red'
        }
        Write-Host ''
        Write-Host '  Staging aborted - fix missing source items and retry.' -ForegroundColor Red
        Write-Host ''
        Write-Host '  Press any key to return to the menu...' -ForegroundColor Gray
        $null = $Host.UI.RawUI.ReadKey('NoEcho,IncludeKeyDown')
        return
    }

    $servers = Get-ServerList -Path (Join-Path $RootDir 'servers.txt')
    if (-not $servers) {
        Write-Host ''
        Write-Host '  Press any key to return to the menu...' -ForegroundColor Gray
        $null = $Host.UI.RawUI.ReadKey('NoEcho,IncludeKeyDown')
        return
    }

    Write-Log "Servers : $($servers.Count) target(s)" 'INFO' 'Gray'
    Write-Log "Source  : $RootDir" 'INFO' 'Gray'
    Write-Log "Dest    : \\<server>\$($StageConfig.RemoteBase)" 'INFO' 'Gray'
    Write-Host ''
    Write-Host '  Items to copy:' -ForegroundColor White
    foreach ($item in $StageConfig.Items) {
        Write-Host ("    {0,-8} {1}" -f $item.Type, $item.RelPath) -ForegroundColor DarkGray
    }
    Write-Host ''

    $pass = 0
    $fail = 0

    foreach ($server in $servers) {
        $remoteDest = "\\$server\$($StageConfig.RemoteBase)"
        Write-Log "[$server] -> $remoteDest" 'INFO' 'White'

        if (-not (Test-Path "\\$server\e$")) {
            Write-Log "[$server] Cannot reach \\$server\e$ - skipping." 'ERROR' 'Red'
            $fail++
            continue
        }
        try {
            if (-not (Test-Path $remoteDest)) {
                New-Item -ItemType Directory -Path $remoteDest -Force | Out-Null
                Write-Log "[$server] Created destination folder." 'OK' 'Green'
            }
        }
        catch {
            Write-Log "[$server] Failed to create destination: $_" 'ERROR' 'Red'
            $fail++
            continue
        }

        $serverOk = $true
        foreach ($item in $StageConfig.Items) {
            $src  = Join-Path $RootDir $item.RelPath
            $dest = Join-Path $remoteDest $item.RelPath
            try {
                if ($item.Type -eq 'File') {
                    Copy-Item -Path $src -Destination $dest -Force
                    Write-Log "[$server] Copied file  : $($item.RelPath)" 'OK' 'Green'
                }
                elseif ($item.Type -eq 'Folder') {
                    if (-not (Test-Path $dest)) {
                        New-Item -ItemType Directory -Path $dest -Force | Out-Null
                    }
                    Copy-Item -Path "$src\*" -Destination $dest -Recurse -Force
                    Write-Log "[$server] Copied folder: $($item.RelPath)" 'OK' 'Green'
                }
            }
            catch {
                Write-Log "[$server] Failed to copy $($item.RelPath): $_" 'ERROR' 'Red'
                $serverOk = $false
            }
        }
        if ($serverOk) { $pass++ } else { $fail++ }
    }

    Write-Host ''
    Write-Host ("  Staging complete - Success: {0}   Failed: {1}   Total: {2}" -f $pass, $fail, ($pass + $fail)) -ForegroundColor Cyan
    Write-Host ''
    Write-Log "Staging complete. Log: $($script:_ActiveLog)" 'OK' 'Green'
}
#endregion

#region Version Detection
function Get-InstalledVersions {
    $script:TomcatInstalledVersion = 'Not detected'
    $script:TomcatInstallPath      = $null
    $script:SCAgentInstalledVersion = 'Not detected'

    $candidates = @($TomcatConfig.ServiceCandidates)

    $svcs = @(Get-Service -Name '*Tomcat*' -ErrorAction SilentlyContinue)
    if ($svcs.Count -eq 0) {
        $svcs = @(Get-Service -DisplayName '*Apache Tomcat*' -ErrorAction SilentlyContinue)
    }
    foreach ($svc in $svcs) {
        $rp = (Get-ItemProperty "HKLM:\SYSTEM\CurrentControlSet\Services\$($svc.Name)" `
               -ErrorAction SilentlyContinue).ImagePath
        if ($rp) {
            $ex   = $rp.Trim('"').Split(' ')[0]
            $root = Split-Path (Split-Path $ex -Parent) -Parent
            if ((Test-Path "$root\bin") -and (Test-Path "$root\lib")) {
                $candidates = @($root) + $candidates
            }
        }
    }

    foreach ($candidate in $candidates) {
        $versionBat = Join-Path $candidate 'bin\version.bat'
        if (Test-Path $versionBat) {
            try {
                $output = & cmd.exe /c "`"$versionBat`" 2>&1"
                $vLine  = $output | Select-String -Pattern 'Server version\s*:\s*Apache Tomcat/(\S+)' |
                          Select-Object -First 1
                if ($vLine) {
                    $script:TomcatInstalledVersion = $vLine.Matches[0].Groups[1].Value
                }
                else {
                    $vLine2 = $output | Select-String -Pattern '(\d+\.\d+\.\d+)' | Select-Object -First 1
                    if ($vLine2) { $script:TomcatInstalledVersion = $vLine2.Matches[0].Groups[1].Value }
                }
                $script:TomcatInstallPath = $candidate
                break
            }
            catch { $script:TomcatInstalledVersion = 'Error running version.bat' }
        }
    }

    # Method 1: Registry uninstall keys (fast)
    $regPaths = @(
        'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall',
        'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall'
    )
    foreach ($regPath in $regPaths) {
        if (-not (Test-Path $regPath)) { continue }
        foreach ($key in (Get-ChildItem -Path $regPath -ErrorAction SilentlyContinue)) {
            $props = Get-ItemProperty -Path $key.PSPath -ErrorAction SilentlyContinue
            if ($props.DisplayName -like '*System Center*' -or $props.DisplayName -like '*OTS*') {
                if ($props.DisplayVersion) {
                    $script:SCAgentInstalledVersion = $props.DisplayVersion
                    return
                }
            }
        }
    }

    # Method 2: Win32_Product (slower fallback)
    try {
        $scProd = Get-CimInstance -ClassName Win32_Product -ErrorAction Stop |
                  Where-Object { $_.Name -like '*System Center*' -or $_.Name -like '*OTS*' } |
                  Select-Object -First 1
        if ($scProd) { $script:SCAgentInstalledVersion = $scProd.Version; return }
    }
    catch { }

    # Method 3: version.txt file
    $verFile = Join-Path $SCConfig.InstallDir 'version.txt'
    if (Test-Path $verFile) {
        $vContent = Get-Content $verFile -TotalCount 5 |
                    Select-String -Pattern '(\d+\.\d+[\.\d]*)' | Select-Object -First 1
        if ($vContent) { $script:SCAgentInstalledVersion = $vContent.Matches[0].Groups[1].Value }
    }
}
#endregion

#region Menu
function Show-Menu {
    Write-Header "CNA-DACS Maintenance  |  $RootDir"

    $tcVer  = $script:TomcatInstalledVersion
    $tcPath = if ($script:TomcatInstallPath) { $script:TomcatInstallPath } else { 'path not found' }
    $scVer  = $script:SCAgentInstalledVersion

    $tcColor = if ($tcVer -eq 'Not detected' -or $tcVer -like 'Error*') { 'Yellow' } else { 'Green' }
    $scColor = if ($scVer -eq 'Not detected') { 'Yellow' } else { 'Green' }

    Write-Host '  Installed Software Versions (local):' -ForegroundColor White
    Write-Host ("    Tomcat         : {0}  ({1})" -f $tcVer, $tcPath) -ForegroundColor $tcColor
    Write-Host ("    SC Agent       : {0}" -f $scVer)                  -ForegroundColor $scColor
    Write-Host ''
    Write-Host '  Connection tiers used per server:' -ForegroundColor DarkGray
    Write-Host '    [WinRM] Full execution   [DCOM] WMI+Win32_Process   [UNC] File access only' -ForegroundColor DarkGray
    Write-Host ''
    Write-Host '  Operations:' -ForegroundColor White
    Write-Host ''

    $nvReady = Test-Path (Join-Path $RootDir 'NewVersion')
    $svReady = Test-Path (Join-Path $RootDir 'servers.txt')

    Write-Host '  [1] [READY]    Content Server Backup'        -ForegroundColor Yellow
    Write-Host '  [2] [READY]    System Center Agent Update'   -ForegroundColor Yellow

    if ($nvReady) {
        Write-Host '  [3] [READY]    Tomcat Upgrade'           -ForegroundColor Yellow
    } else {
        Write-Host '  [3] [MISSING]  Tomcat Upgrade'           -ForegroundColor DarkGray
    }

    Write-Host ''
    $stageStatus = if ($nvReady -and $svReady) { '[READY]   ' } else { '[PARTIAL] ' }
    $stageColor  = if ($nvReady -and $svReady) { 'Cyan'       } else { 'Yellow'     }
    Write-Host ("  [S] {0}  Stage software to all servers  (copies: {1} + NewVersion\)" -f $stageStatus, $ScriptName) -ForegroundColor $stageColor
    Write-Host "         Dest: \\<server>\e`$\DLA-failsafe\patching\" -ForegroundColor DarkGray

    Write-Host ''
    Write-Host '  [A]  Run ALL (1, 2, 3) in sequence' -ForegroundColor Magenta
    Write-Host '  [Q]  Quit'                           -ForegroundColor Gray
    Write-Host ''
    Write-Host '  Enter a number or any combination (commas or spaces):' -ForegroundColor White
    Write-Host '    1        Backup only'              -ForegroundColor DarkGray
    Write-Host '    2,3      SystemCenter then Tomcat' -ForegroundColor DarkGray
    Write-Host '    1 2 3    All three in sequence'    -ForegroundColor DarkGray
    Write-Host ''
}

function Invoke-Operation {
    param([string]$Key)
    switch ($Key) {
        '1' { Invoke-Backup }
        '2' { Invoke-SystemCenterUpdate }
        '3' { Invoke-TomcatUpgrade }
    }
    Write-Host ''
    Write-Host '  Press any key to return to the menu...' -ForegroundColor Gray
    $null = $Host.UI.RawUI.ReadKey('NoEcho,IncludeKeyDown')
}
#endregion

#region Startup checks
if (-not (Test-Path $RootDir)) {
    Write-Host ''
    Write-Host "  [ERROR] Root directory not found: $RootDir" -ForegroundColor Red
    Write-Host '  This script must be placed in C:\DLA-failsafe\patching\' -ForegroundColor Yellow
    Write-Host ''
    pause
    exit 1
}

$serversFile = Join-Path $RootDir 'servers.txt'
if (-not (Test-Path $serversFile)) {
    Write-Host ''
    Write-Host "  [WARN] servers.txt not found at: $serversFile" -ForegroundColor Yellow
    Write-Host '  Required by Backup and Stage operations.' -ForegroundColor Yellow
    Write-Host ''
    Start-Sleep -Seconds 2
}

Write-Host ''
Write-Host '  Detecting installed software versions...' -ForegroundColor Gray
Get-InstalledVersions
#endregion

#region Main Loop
:MainLoop while ($true) {
    Clear-Host
    Show-Menu
    $raw = (Read-Host '  Enter selection').Trim().ToUpper()

    switch ($raw) {

        'Q' {
            Write-Host ''
            Write-Host '  Exiting.' -ForegroundColor Gray
            Write-Host ''
            break MainLoop
        }

        'S' { Invoke-StageSoftware }

        'A' { '1','2','3' | ForEach-Object { Invoke-Operation -Key $_ } }

        default {
            $tokens = @($raw -split '[,\s]+' | Where-Object { $_ -ne '' })
            $valid  = @($tokens | Where-Object { $_ -match '^[123]$' })
            $bad    = @($tokens | Where-Object { $_ -notmatch '^[123]$' })

            if ($bad.Count -gt 0) {
                Write-Host ''
                Write-Host ("  Invalid entry: '{0}' - use 1, 2, 3, S, A, or Q." -f ($bad -join ',')) -ForegroundColor Red
                Start-Sleep -Seconds 2
                continue
            }
            if ($valid.Count -eq 0) {
                Write-Host ''
                Write-Host '  No valid selection.' -ForegroundColor Red
                Start-Sleep -Seconds 2
                continue
            }
            $seen = @{}
            foreach ($v in $valid) {
                if (-not $seen.ContainsKey($v)) {
                    $seen[$v] = $true
                    Invoke-Operation -Key $v
                }
            }
        }
    }
}
#endregion
