#==================================================================================
#
#        SCRIPT: OpenText System Center Agent Audit (Parallel)
#
#        DESCRIPTION:
#        Evaluates the current state of the OpenText System Center Agent
#        across a list of remote servers. For each server, reports:
#          - Content Server instance name (resolved from service metadata)
#          - System Center Agent service status and version (from ARP)
#          - All installation path mappings resolved from the service
#          - otcs.log validation for wss://patch.dacs.dla.mil:443 and wss://localhost:8888
#          - For servers without agent installed: locates, compresses, and clears SystemCenter folder
#
#        servers.txt format:
#        - Place in the same directory as this script.
#        - Zones defined using [Zone Name] headers.
#        - One FQDN per line. Instance name is resolved automatically.
#        - Lines starting with # are comments and ignored.
#        - Blank lines are ignored.
#
#        Example servers.txt:
#
#          [Production - Public]
#          prodpub1.domain.com
#          prodpub2.domain.com
#
#          [Production - Private]
#          prodpriv1.domain.com
#
#==================================================================================

#region Configuration
$configFile = Join-Path $PSScriptRoot "servers.txt"
if (-not (Test-Path $configFile)) {
    Write-Host "ERROR: Server config file not found: $configFile" -ForegroundColor Red
    Write-Host "Create a 'servers.txt' file in the same directory as this script." -ForegroundColor Yellow
    Write-Host "One FQDN per line. Zone headers: [Zone Name]" -ForegroundColor Yellow
    exit 1
}

$logDir          = "C:\Logs"
$localLogPath    = Join-Path $logDir "SCOMAgentAudit_$(Get-Date -Format 'yyyyMMdd_HHmmss').log"
$csvPath         = Join-Path $logDir "SCOMAgentAudit_$(Get-Date -Format 'yyyyMMdd_HHmmss').csv"
$maxParallelJobs = 5
#endregion

#region Helpers
function Write-Log {
    param(
        [string]$Message,
        [string]$Level = 'INFO',
        [string]$Color = 'White',
        [switch]$Spacer
    )
    if ($Spacer) {
        Add-Content -Path $localLogPath -Value ''
        Write-Host ''
        return
    }
    $entry = "[$Level] - $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') - $Message"
    Write-Host $entry -ForegroundColor $Color
    Add-Content -Path $localLogPath -Value $entry
}

function Parse-ServersFile {
    param([string]$Path)
    $groups  = [ordered]@{}
    $current = 'Ungrouped'
    $count   = 0
    foreach ($line in (Get-Content $Path)) {
        $t = $line.Trim()
        if ($t -match '^\s*$' -or $t -match '^\s*#') { continue }
        if ($t -match '^\[(.+)\]$') {
            $current = $Matches[1].Trim()
            if (-not $groups.Contains($current)) {
                $groups[$current] = [System.Collections.Generic.List[string]]::new()
            }
            continue
        }
        if (-not $groups.Contains($current)) {
            $groups[$current] = [System.Collections.Generic.List[string]]::new()
        }
        $groups[$current].Add($t)
        $count++
    }
    return $groups, $count
}
#endregion

#region Remote Audit Script Block
$auditScript = {

    $result = [pscustomobject]@{
        ComputerName          = $env:COMPUTERNAME
        Zone                  = $null
        ContentServerInstance = $null
        ContentServerDir      = $null
        AgentServiceName      = $null
        AgentDisplayName      = $null
        AgentStatus           = $null
        AgentStartType        = $null
        AgentVersion          = $null
        AgentInstallPath      = $null
        AgentExePath          = $null
        AgentDataPath         = $null
        AgentConfigPath       = $null
        AgentAccountName      = $null
        AgentDescription      = $null
        AgentPID              = $null
        LogPath               = $null
        PatchConnectOK        = $null
        LocalhostFailures     = $null
        LogErrors             = [System.Collections.Generic.List[string]]::new()
        Errors                = [System.Collections.Generic.List[string]]::new()
    }

    try {
        $allSvcs = Get-CimInstance -ClassName Win32_Service -ErrorAction Stop

        #--- Resolve Content Server instance ---
        $csSvc = $allSvcs | Where-Object {
            $_.Description -like '*Content Server*' -and
            $_.Description -notlike '*Content Server Admin*'
        } | Select-Object -First 1

        if ($csSvc) {
            $result.ContentServerInstance = $csSvc.Name
            if ($csSvc.PathName) {
                $exePath = $csSvc.PathName -replace '^"([^"]+)".*$', '$1' `
                                           -replace '^([^\s]+\.exe).*$', '$1'
                $dir   = Split-Path $exePath -Parent
                $csDir = $null
                for ($i = 0; $i -lt 6; $i++) {
                    if ([IO.Path]::GetFileName($dir) -ieq 'contentserver') {
                        $csDir = $dir; break
                    }
                    $candidate = Join-Path $dir 'contentserver'
                    if (Test-Path $candidate -PathType Container) {
                        $csDir = $candidate; break
                    }
                    $parent = Split-Path $dir -Parent
                    if ($parent -eq $dir) { break }
                    $dir = $parent
                }
                $result.ContentServerDir = if ($csDir) { $csDir } else { 'Not resolved' }
            } else {
                $result.ContentServerDir = 'No PathName on service'
            }
        } else {
            $result.Errors.Add("WARNING: No Content Server service found (excluding Admin).")
        }

        #--- Resolve OpenText System Center Agent service ---
        $agentSvc = $allSvcs | Where-Object {
            $_.Name        -eq 'OTSystemCenterAgent'             -or
            $_.DisplayName -eq 'Open Text System Center Agent'   -or
            $_.Description -like '*Open Text System Center Agent*'
        } | Select-Object -First 1

        if ($agentSvc) {

            $result.AgentServiceName  = $agentSvc.Name
            $result.AgentDisplayName  = $agentSvc.DisplayName
            $result.AgentStatus       = $agentSvc.State
            $result.AgentStartType    = $agentSvc.StartMode
            $result.AgentAccountName  = $agentSvc.StartName
            $result.AgentDescription  = $agentSvc.Description
            $result.AgentPID          = $agentSvc.ProcessId

            #--- Resolve paths from service PathName ---
            if ($agentSvc.PathName) {
                $rawExe = $agentSvc.PathName -replace '^"([^"]+)".*$', '$1' `
                                             -replace '^([^\s]+\.exe).*$', '$1'
                $result.AgentExePath     = $rawExe
                $result.AgentInstallPath = Split-Path $rawExe -Parent
                $installDir              = $result.AgentInstallPath

                $dataCandidates = @(
                    (Join-Path $installDir 'Health Service State'),
                    (Join-Path (Split-Path $installDir -Parent) 'Health Service State'),
                    (Join-Path $installDir 'Data')
                )
                foreach ($c in $dataCandidates) {
                    if (Test-Path $c) { $result.AgentDataPath = $c; break }
                }

                $configCandidates = @(
                    (Join-Path $installDir 'MOMAgent.ini'),
                    (Join-Path $installDir 'AgentCfg.xml'),
                    (Join-Path $installDir 'conf'),
                    (Join-Path (Split-Path $installDir -Parent) 'conf')
                )
                foreach ($c in $configCandidates) {
                    if (Test-Path $c) { $result.AgentConfigPath = $c; break }
                }
            } else {
                $result.Errors.Add("WARNING: Agent service '$($agentSvc.Name)' has no PathName.")
            }

            #--- Version from Add/Remove Programs (returns 26.1.x product version) ---
            $arpPaths = @(
                'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall',
                'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall'
            )
            foreach ($arpBase in $arpPaths) {
                if (-not (Test-Path $arpBase)) { continue }
                $arpMatch = Get-ChildItem $arpBase -ErrorAction SilentlyContinue | ForEach-Object {
                    Get-ItemProperty $_.PSPath -ErrorAction SilentlyContinue
                } | Where-Object {
                    $_.DisplayName -like '*Open Text System Center Agent*' -or
                    $_.DisplayName -like '*OTSystemCenterAgent*'
                } | Select-Object -First 1

                if ($arpMatch) {
                    $result.AgentVersion = $arpMatch.DisplayVersion
                    if (-not $result.AgentInstallPath -and $arpMatch.InstallLocation) {
                        $result.AgentInstallPath = $arpMatch.InstallLocation
                    }
                    break
                }
            }

            #--- Fallback: file version from executable ---
            if (-not $result.AgentVersion -and $result.AgentExePath -and (Test-Path $result.AgentExePath)) {
                try {
                    $vi = (Get-Item $result.AgentExePath -ErrorAction Stop).VersionInfo
                    $result.AgentVersion = $vi.FileVersion
                } catch {
                    $result.Errors.Add("WARNING: Could not read file version from '$($result.AgentExePath)': $_")
                }
            }

            #--- Validate otcs.log ---
            $logPath = $null
            if ($result.AgentInstallPath) {
                $candidate = Join-Path $result.AgentInstallPath "logs\otcs.log"
                if (Test-Path $candidate) {
                    $logPath = $candidate
                }
            }

            if ($logPath) {
                $result.LogPath = $logPath
                $result.LogErrors.Add("INFO: Evaluating log file: '$logPath'.")
                try {
                    $lines = Get-Content $logPath -Tail 2000 -ErrorAction Stop

                    $patchOK = $lines | Where-Object {
                        $_ -match 'wss://patch\.dacs\.dla\.mil:443/otcs-server/v1/agentwebsocket'
                    }
                    $localFail = $lines | Where-Object {
                        $_ -match 'wss://localhost:8888/otcs-server/v1/agentwebsocket'
                    }

                    $result.PatchConnectOK    = if ($patchOK)   { $patchOK.Count }   else { 0 }
                    $result.LocalhostFailures = if ($localFail) { $localFail.Count } else { 0 }

                    if ($patchOK) {
                        $result.LogErrors.Add("PATCH OK (last match)  : $($patchOK | Select-Object -Last 1)")
                    }
                    if ($localFail) {
                        $result.LogErrors.Add("LOCALHOST FAIL (last)  : $($localFail | Select-Object -Last 1)")
                    }
                } catch {
                    $result.LogErrors.Add("ERROR reading log '$logPath': $_")
                    $result.PatchConnectOK    = 'ERROR'
                    $result.LocalhostFailures = 'ERROR'
                }
            } else {
                $checkedPath = if ($result.AgentInstallPath) { "$($result.AgentInstallPath)\logs\otcs.log" } else { 'AgentInstallPath not resolved' }
                $result.LogErrors.Add("WARNING: otcs.log not found. Checked path: '$checkedPath'.")
                $result.PatchConnectOK    = 'LOG NOT FOUND'
                $result.LocalhostFailures = 'LOG NOT FOUND'
            }

        } else {

            #--- Agent not installed --- 
            $result.AgentStatus       = 'NOT INSTALLED'
            $result.AgentVersion      = 'N/A'
            $result.PatchConnectOK    = 'N/A'
            $result.LocalhostFailures = 'N/A'
            $result.Errors.Add("WARNING: No OpenText System Center Agent service found on this host.")

            #--- Locate SystemCenter folder from known candidate paths ---
            $scCandidates = @(
                'C:\Program Files\OpenText\SystemCenter',
                'C:\Program Files (x86)\OpenText\SystemCenter',
                'C:\OpenText\SystemCenter',
                'D:\Program Files\OpenText\SystemCenter',
                'D:\OpenText\SystemCenter'
            )
            if ($result.ContentServerDir) {
                $otRoot = Split-Path (Split-Path $result.ContentServerDir -Parent) -Parent
                $scCandidates += Join-Path $otRoot 'SystemCenter'
                $scCandidates += Join-Path (Split-Path $result.ContentServerDir -Parent) 'SystemCenter'
            }

            $scFolder = $null
            foreach ($c in $scCandidates) {
                if (Test-Path $c -PathType Container) {
                    $scFolder = $c
                    break
                }
            }

            if ($scFolder) {
                $result.AgentInstallPath = $scFolder
                $items = Get-ChildItem $scFolder -Recurse -ErrorAction SilentlyContinue

                if ($items) {
                    # Save archive one level above the SystemCenter folder with timestamp
                    $parentDir   = Split-Path (Split-Path $scFolder -Parent) -Parent
                    $folderName  = Split-Path $scFolder -Leaf
                    $archivePath = Join-Path $parentDir "${folderName}_$(Get-Date -Format 'yyyy-MM-dd_HHmmss').zip"

                    try {
                        Compress-Archive -Path $scFolder -DestinationPath $archivePath -Force -ErrorAction Stop
                        $result.Errors.Add("INFO: Compressed '$scFolder' to '$archivePath'.")

                        # Backup rotation — keep only 2 most recent archives
                        $existingBackups = Get-ChildItem -Path $parentDir -Filter "${folderName}_*.zip" -ErrorAction SilentlyContinue |
                            Sort-Object CreationTime
                        $excess = $existingBackups.Count - 2
                        if ($excess -gt 0) {
                            $existingBackups | Select-Object -First $excess | ForEach-Object {
                                Remove-Item $_.FullName -Force -ErrorAction SilentlyContinue
                                $result.Errors.Add("INFO: Removed old backup '$($_.Name)'.")
                            }
                        }

                        # Delete contents but leave the folder itself
                        Get-ChildItem $scFolder -Recurse -ErrorAction SilentlyContinue |
                            Sort-Object FullName -Descending |
                            ForEach-Object {
                                Remove-Item $_.FullName -Force -Recurse -ErrorAction SilentlyContinue
                            }
                        $result.Errors.Add("INFO: Contents of '$scFolder' deleted after compression.")
                    } catch {
                        $result.Errors.Add("ERROR: Failed to compress '$scFolder': $_")
                    }
                } else {
                    $result.Errors.Add("INFO: SystemCenter folder found at '$scFolder' but it is already empty. No action taken.")
                }
            } else {
                $result.AgentInstallPath = 'NOT FOUND'
                $result.Errors.Add("INFO: No SystemCenter installation folder found on this host.")
            }
        }

    } catch {
        $result.Errors.Add("ERROR during audit: $_")
    }

    return $result
}
#endregion

#region Main
if (-not (Test-Path $logDir)) { New-Item -ItemType Directory -Path $logDir -Force | Out-Null }

$startTime = Get-Date
Write-Log "---------------- SCOM AGENT AUDIT STARTED ----------------" -Color Cyan
Write-Log "Started  : $($startTime.ToString('yyyy-MM-dd HH:mm:ss'))" -Color Gray
Write-Log "Log file : $localLogPath" -Color Gray
Write-Log "CSV file : $csvPath"      -Color Gray

$serverGroups, $totalEntries = Parse-ServersFile -Path $configFile

if ($totalEntries -eq 0) {
    Write-Log "ERROR: No valid server entries found in $configFile" -Level 'ERROR' -Color Red
    exit 1
}

Write-Log "Servers  : $totalEntries across $($serverGroups.Keys.Count) zone(s)" -Color Gray
Write-Log -Spacer

# --- Queue parallel audit jobs ---
Write-Log "Queuing audit jobs (max $maxParallelJobs parallel)..." -Color Yellow

$jobs = [System.Collections.Generic.List[pscustomobject]]::new()

foreach ($group in $serverGroups.Keys) {
    foreach ($fqdn in $serverGroups[$group]) {
        while ((Get-Job -State Running).Count -ge $maxParallelJobs) { Start-Sleep -Milliseconds 500 }

        $job = Invoke-Command -ComputerName $fqdn `
            -ScriptBlock $auditScript `
            -AsJob -ErrorAction SilentlyContinue
        $job.Name = $fqdn

        $jobs.Add([pscustomobject]@{
            Job          = $job
            ComputerName = $fqdn
            GroupName    = $group
        })
    }
}

Write-Log "All $($jobs.Count) job(s) queued. Waiting for completion..." -Color Yellow
$jobs | ForEach-Object { $_.Job } | Wait-Job | Out-Null
Write-Log "All jobs finished. Aggregating results." -Color Yellow
Write-Log -Spacer

# --- Collect results ---
$allResults = [System.Collections.Generic.List[pscustomobject]]::new()
$prevGroup  = $null

foreach ($entry in ($jobs | Sort-Object GroupName, ComputerName)) {

    if ($entry.GroupName -ne $prevGroup) {
        Write-Log -Spacer
        Write-Log "╔══════════════════════════════════════════════════════════╗" -Color Magenta
        Write-Log "║  ZONE: $($entry.GroupName.PadRight(50))║" -Color Magenta
        Write-Log "╚══════════════════════════════════════════════════════════╝" -Color Magenta
        Write-Log -Spacer
        $prevGroup = $entry.GroupName
    }

    if ($entry.Job.State -ne 'Completed') {
        $err    = $entry.Job.ChildJobs[0].Error | Select-Object -First 1
        $errMsg = if ($err) { $err.Exception.Message } else { "Unreachable or access denied." }
        Write-Log "--- [$($entry.GroupName)] $($entry.ComputerName) ---" -Color Cyan
        Write-Log "  FAILED to connect: $errMsg" -Level 'ERROR' -Color Red

        $allResults.Add([pscustomobject]@{
            Zone                  = $entry.GroupName
            ComputerName          = $entry.ComputerName
            ContentServerInstance = 'N/A'
            ContentServerDir      = 'N/A'
            AgentServiceName      = 'N/A'
            AgentDisplayName      = 'N/A'
            AgentStatus           = 'UNREACHABLE'
            AgentStartType        = 'N/A'
            AgentVersion          = 'N/A'
            AgentInstallPath      = 'N/A'
            AgentExePath          = 'N/A'
            AgentDataPath         = 'N/A'
            AgentConfigPath       = 'N/A'
            AgentAccountName      = 'N/A'
            AgentPID              = 'N/A'
            LogPath               = 'N/A'
            PatchConnectOK        = 'N/A'
            LocalhostFailures     = 'N/A'
            Errors                = $errMsg
        })
        continue
    }

    $r      = $entry.Job | Receive-Job
    $r.Zone = $entry.GroupName

    $instanceLabel = if ($r.ContentServerInstance) { " | Instance: $($r.ContentServerInstance)" } else { '' }
    Write-Log "--- [$($entry.GroupName)] $($entry.ComputerName)$instanceLabel ---" -Color Cyan

    $r.Errors    | ForEach-Object { Write-Log "  $_" -Level 'WARN' -Color Yellow }
    $r.LogErrors | ForEach-Object { Write-Log "  $_" -Level 'WARN' -Color Yellow }

    $agentColor = switch ($r.AgentStatus) {
        'Running'       { 'Green'  }
        'Stopped'       { 'Red'    }
        'NOT INSTALLED' { 'Yellow' }
        default         { 'Gray'   }
    }
    $patchColor = if ($r.PatchConnectOK  -match '^\d+$' -and [int]$r.PatchConnectOK  -gt 0) { 'Green' } else { 'Red' }
    $localColor = if ($r.LocalhostFailures -match '^\d+$' -and [int]$r.LocalhostFailures -gt 0) { 'Red' } else { 'Green' }

    Write-Log "  Content Server Instance        : $($r.ContentServerInstance)"  -Color Gray
    Write-Log "  Content Server Dir             : $($r.ContentServerDir)"       -Color Gray
    Write-Log "  Agent Service Name             : $($r.AgentServiceName)"       -Color Gray
    Write-Log "  Agent Display Name             : $($r.AgentDisplayName)"       -Color Gray
    Write-Log "  Agent Status                   : $($r.AgentStatus)"            -Color $agentColor
    Write-Log "  Agent Start Type               : $($r.AgentStartType)"         -Color Gray
    Write-Log "  Agent Version                  : $($r.AgentVersion)"           -Color Gray
    Write-Log "  Agent Install Path             : $($r.AgentInstallPath)"       -Color Gray
    Write-Log "  Agent Exe Path                 : $($r.AgentExePath)"           -Color Gray
    Write-Log "  Agent Data Path                : $($r.AgentDataPath)"          -Color Gray
    Write-Log "  Agent Config Path              : $($r.AgentConfigPath)"        -Color Gray
    Write-Log "  Agent Account                  : $($r.AgentAccountName)"       -Color Gray
    Write-Log "  Agent PID                      : $($r.AgentPID)"               -Color Gray
    Write-Log "  Log Path                       : $($r.LogPath)"                -Color Gray
    Write-Log "  patch.dacs.dla.mil:443 OK hits : $($r.PatchConnectOK)"         -Color $patchColor
    Write-Log "  localhost:8888 Failures        : $($r.LocalhostFailures)"      -Color $localColor
    Write-Log -Spacer

    $allResults.Add([pscustomobject]@{
        Zone                  = $r.Zone
        ComputerName          = $r.ComputerName
        ContentServerInstance = $r.ContentServerInstance
        ContentServerDir      = $r.ContentServerDir
        AgentServiceName      = $r.AgentServiceName
        AgentDisplayName      = $r.AgentDisplayName
        AgentStatus           = $r.AgentStatus
        AgentStartType        = $r.AgentStartType
        AgentVersion          = $r.AgentVersion
        AgentInstallPath      = $r.AgentInstallPath
        AgentExePath          = $r.AgentExePath
        AgentDataPath         = $r.AgentDataPath
        AgentConfigPath       = $r.AgentConfigPath
        AgentAccountName      = $r.AgentAccountName
        AgentPID              = $r.AgentPID
        LogPath               = $r.LogPath
        PatchConnectOK        = $r.PatchConnectOK
        LocalhostFailures     = $r.LocalhostFailures
        Errors                = (($r.Errors + $r.LogErrors) -join ' | ')
    })
}

$jobs | ForEach-Object { $_.Job | Remove-Job -Force }

# --- Summary Report ---
Write-Log -Spacer
Write-Log "========== AUDIT SUMMARY ==========" -Color Cyan

$total        = $allResults.Count
$reachable    = $allResults | Where-Object { $_.AgentStatus -ne 'UNREACHABLE' }
$unreachable  = $allResults | Where-Object { $_.AgentStatus -eq 'UNREACHABLE' }
$running      = $allResults | Where-Object { $_.AgentStatus -eq 'Running' }
$stopped      = $allResults | Where-Object { $_.AgentStatus -eq 'Stopped' }
$notInstalled = $allResults | Where-Object { $_.AgentStatus -eq 'NOT INSTALLED' }
$patchOK      = $allResults | Where-Object { $_.PatchConnectOK    -match '^\d+$' -and [int]$_.PatchConnectOK    -gt 0 }
$patchFail    = $allResults | Where-Object { $_.PatchConnectOK    -match '^\d+$' -and [int]$_.PatchConnectOK    -eq 0 }
$localFail    = $allResults | Where-Object { $_.LocalhostFailures -match '^\d+$' -and [int]$_.LocalhostFailures -gt 0 }
$logMissing   = $allResults | Where-Object { $_.PatchConnectOK    -eq 'LOG NOT FOUND' }

Write-Log "  Total servers evaluated          : $total"                -Color Gray
Write-Log "  Reachable                        : $($reachable.Count)"   -Color Gray
Write-Log "  Unreachable                      : $($unreachable.Count)" -Color $(if ($unreachable.Count  -gt 0) { 'Red'    } else { 'Green' })
Write-Log -Spacer
Write-Log "  Agent Running                    : $($running.Count)"      -Color $(if ($running.Count -eq $reachable.Count) { 'Green' } else { 'Yellow' })
Write-Log "  Agent Stopped                    : $($stopped.Count)"      -Color $(if ($stopped.Count      -gt 0) { 'Red'    } else { 'Green' })
Write-Log "  Agent Not Installed              : $($notInstalled.Count)" -Color $(if ($notInstalled.Count -gt 0) { 'Yellow' } else { 'Green' })
Write-Log -Spacer
Write-Log "  patch.dacs.dla.mil:443 OK hits   : $($patchOK.Count)"     -Color $(if ($patchOK.Count -eq $reachable.Count) { 'Green' } else { 'Yellow' })
Write-Log "  patch.dacs.dla.mil:443 No hits   : $($patchFail.Count)"   -Color $(if ($patchFail.Count    -gt 0) { 'Red'    } else { 'Green' })
Write-Log "  localhost:8888 Failures          : $($localFail.Count)"   -Color $(if ($localFail.Count    -gt 0) { 'Red'    } else { 'Green' })
Write-Log "  Log file not found               : $($logMissing.Count)"  -Color $(if ($logMissing.Count   -gt 0) { 'Yellow' } else { 'Green' })

# Version breakdown
Write-Log -Spacer
Write-Log "  Version breakdown:" -Color Gray
$allResults | Where-Object { $_.AgentVersion -and $_.AgentVersion -ne 'N/A' } |
    Group-Object AgentVersion | Sort-Object Name |
    ForEach-Object { Write-Log "    $($_.Name) — $($_.Count) server(s)" -Color Gray }

# Servers needing attention
$attention = $allResults | Where-Object {
    $_.AgentStatus -ne 'Running' -or
    ($_.LocalhostFailures -match '^\d+$' -and [int]$_.LocalhostFailures -gt 0) -or
    ($_.PatchConnectOK    -match '^\d+$' -and [int]$_.PatchConnectOK    -eq 0)
}
if ($attention.Count -gt 0) {
    Write-Log -Spacer
    Write-Log "  Servers requiring attention:" -Color Yellow
    foreach ($s in $attention) {
        $reasons = [System.Collections.Generic.List[string]]::new()
        if ($s.AgentStatus -ne 'Running') { $reasons.Add("Agent: $($s.AgentStatus)") }
        if ($s.LocalhostFailures -match '^\d+$' -and [int]$s.LocalhostFailures -gt 0) {
            $reasons.Add("localhost:8888 failures: $($s.LocalhostFailures)")
        }
        if ($s.PatchConnectOK -match '^\d+$' -and [int]$s.PatchConnectOK -eq 0) {
            $reasons.Add("No patch.dacs.dla.mil:443 hits")
        }
        Write-Log "    $($s.ComputerName) [$($s.Zone)] — $($reasons -join ' | ')" -Color Red
    }
}

Write-Log -Spacer

# --- Export CSV ---
$allResults | Export-Csv -Path $csvPath -NoTypeInformation -Encoding UTF8
Write-Log "CSV exported : $csvPath" -Color Green

$endTime = Get-Date
$dur     = $endTime - $startTime
Write-Log "========================================" -Color Cyan
Write-Log "Completed : $($endTime.ToString('yyyy-MM-dd HH:mm:ss'))" -Color Cyan
Write-Log "Duration  : $($dur.ToString('mm\:ss'))"                  -Color Cyan
Write-Log "========================================" -Color Cyan
Write-Log "Log saved : $localLogPath" -Color Green
Write-Log "CSV saved : $csvPath"      -Color Green
Write-Log "---------------- SCOM AGENT AUDIT FINISHED ----------------"
#endregion
