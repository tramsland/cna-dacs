#Requires -Version 5.1
#Requires -RunAsAdministrator
#==================================================================================
#
#        SCRIPT: OTSysCenter_Update_Step1.ps1
#
#        DESCRIPTION:
#        Step 1 of the OpenText System Center Agent remote update process.
#        For each server in servers.txt:
#          1. Discovers the OTSsystemCenterAgent service and install directory
#          2. Identifies the installed version using all available methods
#             (FileVersionInfo on exe, version files in install dir, WMI
#              Win32_Product) and reports which method(s) returned useful data
#          3. Stops the service gracefully
#          4. Backs up the install directory as a timestamped zip at the
#             same level as the install directory
#
#        Runs against all servers in parallel (up to $maxParallelJobs at once).
#        Requires WinRM access and local admin rights on each target.
#
#        servers.txt format:
#          [Zone Name]
#          server1.domain.com
#          server2.domain.com
#
#          [Another Zone]
#          server3.domain.com
#
#        Lines starting with # and blank lines are ignored.
#
#        Local execution:
#        If servers.txt contains the hostname of the machine running this
#        script (matched by COMPUTERNAME, FQDN, or 'localhost'), that server
#        is processed in-process rather than via Invoke-Command, avoiding a
#        WinRM loopback which requires CredSSP or explicit credentials.
#
#==================================================================================

#region Configuration

$configFile      = Join-Path $PSScriptRoot 'servers.txt'
$logDir          = 'C:\Logs'
$maxParallelJobs = 5
$maxBackups      = 3
$svcStopTimeout  = 60   # seconds
$svcName         = 'OTSsystemCenterAgent'

$localLogPath = Join-Path $logDir "OTSysCenter_Step1_$(Get-Date -Format 'yyyyMMdd_HHmmss').log"

#endregion

#region Bootstrap

if (-not (Test-Path $configFile)) {
    Write-Host "ERROR: servers.txt not found at: $configFile" -ForegroundColor Red
    Write-Host "Create a servers.txt file in the same directory as this script." -ForegroundColor Yellow
    exit 1
}

if (-not (Test-Path $logDir)) {
    New-Item -ItemType Directory -Path $logDir -Force | Out-Null
}

#endregion

#region Helpers

function Write-Log {
    param(
        [string]$Message,
        [string]$Level = 'INFO',
        [string]$Color = 'White',
        [switch]$Spacer
    )
    if ($Spacer) {
        Add-Content -Path $localLogPath -Value ''
        Write-Host ''
        return
    }
    $entry = "[$Level] - $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') - $Message"
    Write-Host $entry -ForegroundColor $Color
    Add-Content -Path $localLogPath -Value $entry
}

function Parse-ServersFile {
    param([string]$Path)
    $groups  = [ordered]@{}
    $current = 'Ungrouped'
    $count   = 0
    foreach ($line in (Get-Content $Path)) {
        $t = $line.Trim()
        if ($t -match '^\s*$' -or $t -match '^\s*#') { continue }
        if ($t -match '^\[(.+)\]$') {
            $current = $Matches[1].Trim()
            if (-not $groups.Contains($current)) {
                $groups[$current] = [System.Collections.Generic.List[string]]::new()
            }
            continue
        }
        if (-not $groups.Contains($current)) {
            $groups[$current] = [System.Collections.Generic.List[string]]::new()
        }
        $groups[$current].Add($t)
        $count++
    }
    return $groups, $count
}

function Test-IsLocalhost {
    param([string]$Name)
    # Match against short name, FQDN, and common loopback aliases
    $localNames = @(
        $env:COMPUTERNAME,
        "$($env:COMPUTERNAME).$($env:USERDNSDOMAIN)".TrimEnd('.'),
        [System.Net.Dns]::GetHostEntry('').HostName,
        'localhost',
        '127.0.0.1',
        '::1'
    ) | Where-Object { $_ } | ForEach-Object { $_.ToLower().TrimEnd('.') }

    return $localNames -contains $Name.ToLower().TrimEnd('.')
}

#endregion

#region Remote Script Block
# Runs on each target server via Invoke-Command.
# Returns a structured result object that the orchestrator logs and stores.

$remoteBlock = {
    param(
        [string]$SvcName,
        [int]$StopTimeoutSec,
        [int]$MaxBackups
    )

    $hostname = $env:COMPUTERNAME

    # ── Result object ────────────────────────────────────────────────────────
    $result = [pscustomobject]@{
        Hostname        = $hostname
        ServiceFound    = $false
        InstallDir      = $null
        ExePath         = $null

        # Version detection — one entry per method attempted
        VersionResults  = [System.Collections.Generic.List[pscustomobject]]::new()
        BestVersion     = $null
        BestVersionFrom = $null

        ServiceWasRunning = $false
        ServiceStopped    = $false
        BackupPath        = $null
        BackupSuccess     = $false

        Messages        = [System.Collections.Generic.List[string]]::new()
        Warnings        = [System.Collections.Generic.List[string]]::new()
        Errors          = [System.Collections.Generic.List[string]]::new()
    }

    function Add-Msg  { param($m) $result.Messages.Add("($hostname) $m") }
    function Add-Warn { param($m) $result.Warnings.Add("($hostname) WARN: $m") }
    function Add-Err  { param($m) $result.Errors.Add("($hostname) ERROR: $m") }

    # ── Step 1: Locate the service ───────────────────────────────────────────
    $svc = Get-Service -Name $SvcName -ErrorAction SilentlyContinue
    if (-not $svc) {
        Add-Err "Service '$SvcName' not found on this host."
        return $result
    }

    $result.ServiceFound    = $true
    $result.ServiceWasRunning = ($svc.Status -eq 'Running')
    Add-Msg "Service '$SvcName' found. Status: $($svc.Status)"

    # ── Step 2: Resolve install directory from service PathName ──────────────
    try {
        $cimSvc = Get-CimInstance -ClassName Win32_Service `
                    -Filter "Name='$SvcName'" -ErrorAction Stop

        if ($cimSvc -and $cimSvc.PathName) {
            # Strip surrounding quotes and any trailing arguments
            $exeRaw = $cimSvc.PathName -replace '^"([^"]+)".*$', '$1' `
                                       -replace '^([^\s]+\.exe).*$', '$1'
            $result.ExePath    = $exeRaw
            $result.InstallDir = Split-Path $exeRaw -Parent
            Add-Msg "Install directory resolved: $($result.InstallDir)"
        } else {
            Add-Warn "Win32_Service PathName is empty for '$SvcName'."
        }
    }
    catch {
        Add-Warn "CIM query failed resolving install dir: $_"
    }

    # ── Step 3: Version detection — all methods ───────────────────────────────
    #
    # Method A: FileVersionInfo on the service executable
    # Most reliable when the exe is a native Windows binary with a version resource.
    #
    if ($result.ExePath -and (Test-Path $result.ExePath)) {
        try {
            $fvi = [System.Diagnostics.FileVersionInfo]::GetVersionInfo($result.ExePath)
            $ver = $fvi.FileVersion
            if (-not $ver) { $ver = $fvi.ProductVersion }
            $result.VersionResults.Add([pscustomobject]@{
                Method  = 'FileVersionInfo (exe)'
                Version = if ($ver) { $ver.Trim() } else { $null }
                Source  = $result.ExePath
                Success = [bool]$ver
                Note    = if ($ver) { "FileDescription: $($fvi.FileDescription)" } else { 'No version resource in exe' }
            })
            Add-Msg "FileVersionInfo: $ver"
        }
        catch {
            $result.VersionResults.Add([pscustomobject]@{
                Method  = 'FileVersionInfo (exe)'
                Version = $null
                Source  = $result.ExePath
                Success = $false
                Note    = "Exception: $_"
            })
        }
    }
    else {
        $result.VersionResults.Add([pscustomobject]@{
            Method  = 'FileVersionInfo (exe)'
            Version = $null
            Source  = $result.ExePath
            Success = $false
            Note    = if ($result.ExePath) { 'Exe path not accessible' } else { 'Exe path not resolved' }
        })
    }

    #
    # Method B: Version/manifest files in the install directory
    # OT products often ship version.txt, version.properties, manifest.xml,
    # *.version, or build.properties alongside the executable.
    #
    if ($result.InstallDir -and (Test-Path $result.InstallDir)) {
        $versionFilePatterns = @(
            'version.txt', 'version.properties', 'version.xml',
            'build.properties', 'manifest.xml', 'agent.properties',
            '*.version', '*.ver', '*.build'
        )

        $foundFiles = foreach ($pattern in $versionFilePatterns) {
            Get-ChildItem -Path $result.InstallDir -Filter $pattern `
                -Recurse -Depth 2 -ErrorAction SilentlyContinue
        }

        if ($foundFiles) {
            foreach ($vf in ($foundFiles | Select-Object -Unique)) {
                try {
                    $content = Get-Content $vf.FullName -Raw -ErrorAction Stop

                    # Try common key=value patterns first
                    $extracted = $null
                    foreach ($pattern in @(
                        '(?im)^version\s*[=:]\s*(.+)$',
                        '(?im)^product\.version\s*[=:]\s*(.+)$',
                        '(?im)^build\.version\s*[=:]\s*(.+)$',
                        '(?im)^agent\.version\s*[=:]\s*(.+)$',
                        '(?im)<version>([^<]+)</version>'
                    )) {
                        if ($content -match $pattern) {
                            $extracted = $Matches[1].Trim()
                            break
                        }
                    }

                    # If no pattern matched, use first non-blank line as a fallback
                    if (-not $extracted) {
                        $firstLine = ($content -split "`n" |
                                      Where-Object { $_.Trim() -ne '' } |
                                      Select-Object -First 1)
                        if ($firstLine -and $firstLine.Trim().Length -lt 60) {
                            $extracted = $firstLine.Trim()
                        }
                    }

                    $result.VersionResults.Add([pscustomobject]@{
                        Method  = 'Version file'
                        Version = $extracted
                        Source  = $vf.FullName
                        Success = [bool]$extracted
                        Note    = "File: $($vf.Name)"
                    })
                    Add-Msg "Version file '$($vf.Name)': $extracted"
                }
                catch {
                    $result.VersionResults.Add([pscustomobject]@{
                        Method  = 'Version file'
                        Version = $null
                        Source  = $vf.FullName
                        Success = $false
                        Note    = "Read error: $_"
                    })
                }
            }
        }
        else {
            $result.VersionResults.Add([pscustomobject]@{
                Method  = 'Version file'
                Version = $null
                Source  = $result.InstallDir
                Success = $false
                Note    = 'No recognised version files found in install directory (depth 2)'
            })
            Add-Warn "No version files found under $($result.InstallDir)"
        }
    }
    else {
        $result.VersionResults.Add([pscustomobject]@{
            Method  = 'Version file'
            Version = $null
            Source  = $result.InstallDir
            Success = $false
            Note    = if ($result.InstallDir) { 'Install directory not accessible' } else { 'Install directory not resolved' }
        })
    }

    #
    # Method C: WMI Win32_Product
    # Slowest method — triggers an MSI consistency check on every installed
    # product. Included as a fallback; useful when the exe has no version
    # resource and no version files are present.
    #
    try {
        $products = Get-CimInstance -ClassName Win32_Product -ErrorAction Stop |
                    Where-Object { $_.Name -like '*System Center*' -or
                                   $_.Name -like '*OTSsystemCenter*' -or
                                   $_.Name -like '*OpenText*Agent*' }
        if ($products) {
            foreach ($p in $products) {
                $result.VersionResults.Add([pscustomobject]@{
                    Method  = 'Win32_Product'
                    Version = $p.Version
                    Source  = "Name: $($p.Name)  InstallLocation: $($p.InstallLocation)"
                    Success = [bool]$p.Version
                    Note    = "IdentifyingNumber: $($p.IdentifyingNumber)"
                })
                Add-Msg "Win32_Product match: '$($p.Name)' version $($p.Version)"
            }
        }
        else {
            $result.VersionResults.Add([pscustomobject]@{
                Method  = 'Win32_Product'
                Version = $null
                Source  = 'Win32_Product query'
                Success = $false
                Note    = 'No products matched System Center / OTSsystemCenter / OpenText Agent'
            })
            Add-Warn 'Win32_Product: no matching product found.'
        }
    }
    catch {
        $result.VersionResults.Add([pscustomobject]@{
            Method  = 'Win32_Product'
            Version = $null
            Source  = 'Win32_Product query'
            Success = $false
            Note    = "Query failed: $_"
        })
    }

    # ── Determine best version ────────────────────────────────────────────────
    # Priority: FileVersionInfo > version file > Win32_Product
    $best = $result.VersionResults |
            Where-Object { $_.Success -and $_.Version } |
            Select-Object -First 1
    if ($best) {
        $result.BestVersion     = $best.Version
        $result.BestVersionFrom = $best.Method
        Add-Msg "Best version: $($result.BestVersion) (from $($result.BestVersionFrom))"
    }
    else {
        Add-Warn 'Version could not be determined by any method.'
    }

    # ── Step 4: Stop the service ─────────────────────────────────────────────
    if ($svc.Status -eq 'Running') {
        try {
            Add-Msg "Stopping service '$SvcName'..."
            Stop-Service -Name $SvcName -Force -ErrorAction Stop
            $svc.WaitForStatus('Stopped', [TimeSpan]::FromSeconds($StopTimeoutSec))
            $result.ServiceStopped = $true
            Add-Msg "Service '$SvcName' stopped successfully."
        }
        catch [System.ServiceProcess.TimeoutException] {
            Add-Err "Timed out waiting for '$SvcName' to stop after ${StopTimeoutSec}s."
            return $result
        }
        catch {
            Add-Err "Failed to stop '$SvcName': $_"
            return $result
        }
    }
    else {
        Add-Msg "Service '$SvcName' was already stopped — no stop action needed."
        $result.ServiceStopped = $true   # treat as ready to backup
    }

    # ── Step 5: Backup the install directory ─────────────────────────────────
    if (-not $result.InstallDir) {
        Add-Err 'Cannot backup — install directory not resolved.'
        return $result
    }

    if (-not (Test-Path $result.InstallDir -PathType Container)) {
        Add-Err "Install directory '$($result.InstallDir)' does not exist on $hostname."
        return $result
    }

    $parentDir  = Split-Path $result.InstallDir -Parent
    $folderName = Split-Path $result.InstallDir -Leaf
    $timestamp  = Get-Date -Format 'yyyy-MM-dd_HHmmss'
    $zipPath    = Join-Path $parentDir "${folderName}_${timestamp}.zip"

    try {
        Add-Msg "Compressing '$($result.InstallDir)' → '$zipPath'..."
        Compress-Archive -Path $result.InstallDir -DestinationPath $zipPath -Force
        $result.BackupPath    = $zipPath
        $result.BackupSuccess = $true
        Add-Msg "Backup completed: $zipPath"
    }
    catch {
        Add-Err "Compression failed: $_"
        return $result
    }

    # ── Backup rotation ───────────────────────────────────────────────────────
    try {
        $existing = Get-ChildItem -Path $parentDir -Filter "${folderName}_*.zip" |
                    Sort-Object CreationTime
        $excess = $existing.Count - $MaxBackups
        if ($excess -gt 0) {
            Add-Msg "Rotating backups: removing $excess old zip(s), keeping $MaxBackups."
            $existing | Select-Object -First $excess | ForEach-Object {
                Remove-Item $_.FullName -Force
                Add-Msg "Deleted old backup: $($_.Name)"
            }
        }
        else {
            Add-Msg "$($existing.Count) backup(s) present — no rotation needed (max $MaxBackups)."
        }
    }
    catch {
        Add-Warn "Backup rotation encountered an error: $_"
    }

    return $result
}

#endregion

#region Main

$startTime = Get-Date
Write-Log '===============================================================' -Color Cyan
Write-Log "  OTSysCenter_Update_Step1 — $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" -Color Cyan
Write-Log '===============================================================' -Color Cyan
Write-Log "Log       : $localLogPath" -Color Gray
Write-Log "Service   : $svcName" -Color Gray
Write-Log "MaxJobs   : $maxParallelJobs" -Color Gray
Write-Log "MaxBackups: $maxBackups" -Color Gray
Write-Log -Spacer

# Parse servers.txt
$serverGroups, $totalServers = Parse-ServersFile -Path $configFile

if ($totalServers -eq 0) {
    Write-Log 'ERROR: No valid server entries found in servers.txt.' -Level 'ERROR' -Color Red
    exit 1
}

Write-Log "Servers   : $totalServers across $($serverGroups.Keys.Count) zone(s)" -Color Gray
Write-Log -Spacer

# Queue parallel jobs — local server runs in-process, remotes via Invoke-Command
Write-Log 'Queuing jobs...' -Color Yellow
$jobs      = [System.Collections.Generic.List[pscustomobject]]::new()
$localJobs = [System.Collections.Generic.List[pscustomobject]]::new()

foreach ($group in $serverGroups.Keys) {
    foreach ($fqdn in $serverGroups[$group]) {

        if (Test-IsLocalhost -Name $fqdn) {
            # ── Local execution — run scriptblock in-process ──────────────────
            # WinRM loopback requires CredSSP or explicit creds; skip it entirely.
            Write-Log "  LOCAL [$group] $fqdn — running in-process" -Color Yellow

            try {
                $r = & $remoteBlock $svcName $svcStopTimeout $maxBackups
            }
            catch {
                $r = [pscustomobject]@{
                    Hostname        = $env:COMPUTERNAME
                    ServiceFound    = $false
                    InstallDir      = $null
                    ExePath         = $null
                    VersionResults  = [System.Collections.Generic.List[pscustomobject]]::new()
                    BestVersion     = $null
                    BestVersionFrom = $null
                    ServiceWasRunning = $false
                    ServiceStopped  = $false
                    BackupPath      = $null
                    BackupSuccess   = $false
                    Messages        = [System.Collections.Generic.List[string]]::new()
                    Warnings        = [System.Collections.Generic.List[string]]::new()
                    Errors          = [System.Collections.Generic.List[string]]@("In-process execution threw: $_")
                }
            }

            $localJobs.Add([pscustomobject]@{
                Result = $r
                FQDN   = $fqdn
                Group  = $group
                IsLocal = $true
            })

        } else {
            # ── Remote execution ──────────────────────────────────────────────
            # Throttle — wait if at capacity
            while ((Get-Job -State Running).Count -ge $maxParallelJobs) {
                Start-Sleep -Milliseconds 500
            }

            Write-Log "  Queuing [$group] $fqdn" -Color Gray

            $job = Invoke-Command -ComputerName $fqdn `
                       -ScriptBlock $remoteBlock `
                       -ArgumentList $svcName, $svcStopTimeout, $maxBackups `
                       -AsJob
            $job.Name = $fqdn

            $jobs.Add([pscustomobject]@{
                Job     = $job
                FQDN    = $fqdn
                Group   = $group
                IsLocal = $false
            })
        }
    }
}

Write-Log -Spacer
if ($jobs.Count -gt 0) {
    Write-Log "Waiting for $($jobs.Count) remote job(s) to complete..." -Color Yellow
    $jobs | ForEach-Object { $_.Job } | Wait-Job | Out-Null
}
if ($localJobs.Count -gt 0) {
    Write-Log "$($localJobs.Count) local job(s) already complete." -Color Yellow
}
Write-Log 'All jobs finished. Aggregating results...' -Color Yellow

# Merge local and remote into a single list for uniform result processing
$allEntries = [System.Collections.Generic.List[pscustomobject]]::new()
foreach ($lj in $localJobs) { $allEntries.Add($lj) }
foreach ($rj in $jobs)      { $allEntries.Add($rj) }

# Collect and display results
$summary   = [System.Collections.Generic.List[pscustomobject]]::new()
$prevGroup = $null

foreach ($entry in ($allEntries | Sort-Object Group, FQDN)) {

    if ($entry.Group -ne $prevGroup) {
        Write-Log -Spacer
        Write-Log '########################################' -Color Magenta
        Write-Log "# Zone: $($entry.Group)"                -Color Magenta
        Write-Log '########################################' -Color Magenta
        $prevGroup = $entry.Group
    }

    $localTag = if ($entry.IsLocal) { ' [LOCAL]' } else { '' }
    Write-Log "--- $($entry.FQDN)$localTag ---" -Color Cyan

    # Resolve result object — local jobs carry it directly, remote jobs via Receive-Job
    if ($entry.IsLocal) {
        $r = $entry.Result
    } else {
        # Check for remoting-level failure (unreachable, auth denied, etc.)
        if ($entry.Job.State -ne 'Completed') {
            $errMsg = $entry.Job.ChildJobs[0].Error |
                      Select-Object -First 1 |
                      ForEach-Object { $_.Exception.Message }
            if (-not $errMsg) { $errMsg = 'Unreachable or access denied' }
            Write-Log "  REMOTING FAILED: $errMsg" -Level 'ERROR' -Color Red
            $summary.Add([pscustomobject]@{
                FQDN           = $entry.FQDN
                Group          = $entry.Group
                Overall        = 'REMOTING FAILED'
                Version        = 'N/A'
                VersionFrom    = 'N/A'
                ServiceStopped = $false
                BackupPath     = 'N/A'
                Error          = $errMsg
            })
            $entry.Job | Remove-Job -Force
            continue
        }
        $r = $entry.Job | Receive-Job
    }

    # Messages
    foreach ($m in $r.Messages) {
        $color = switch -Regex ($m) {
            'ERROR'     { 'Red'    }
            'WARN'      { 'Yellow' }
            'stopped|completed|backup|version|resolved' { 'Green' }
            default     { 'Gray'   }
        }
        Write-Log "  $m" -Color $color
    }
    foreach ($w in $r.Warnings) { Write-Log "  $w" -Level 'WARN'  -Color Yellow }
    foreach ($e in $r.Errors)   { Write-Log "  $e" -Level 'ERROR' -Color Red    }

    # Version detection table
    if ($r.VersionResults.Count -gt 0) {
        Write-Log '  Version detection results:' -Color Gray
        foreach ($vr in $r.VersionResults) {
            $tick  = if ($vr.Success) { '[OK]  ' } else { '[----]' }
            $color = if ($vr.Success) { 'Green' } else { 'DarkGray' }
            Write-Log ("  {0} {1,-30} Version: {2,-20} Source: {3}" -f `
                $tick, $vr.Method, $(if ($vr.Version) { $vr.Version } else { '(none)' }), $vr.Note) `
                -Color $color
        }
    }

    # Overall outcome
    $overallOK = $r.ServiceFound -and $r.ServiceStopped -and $r.BackupSuccess
    $overall   = if ($overallOK) { 'SUCCESS' } else { 'PARTIAL/FAILED' }
    $oColor    = if ($overallOK) { 'Green'   } else { 'Red' }

    Write-Log ("  RESULT: {0} | Version: {1} (from {2}) | Stopped: {3} | Backup: {4}" -f `
        $overall,
        $(if ($r.BestVersion)     { $r.BestVersion }     else { 'unknown' }),
        $(if ($r.BestVersionFrom) { $r.BestVersionFrom } else { 'N/A'     }),
        $r.ServiceStopped,
        $(if ($r.BackupPath)      { $r.BackupPath }      else { 'none'    })
    ) -Color $oColor

    $summary.Add([pscustomobject]@{
        FQDN           = $entry.FQDN
        Group          = $entry.Group
        Overall        = $overall
        Version        = if ($r.BestVersion)     { $r.BestVersion }     else { 'unknown' }
        VersionFrom    = if ($r.BestVersionFrom) { $r.BestVersionFrom } else { 'N/A'     }
        ServiceStopped = $r.ServiceStopped
        BackupPath     = if ($r.BackupPath)      { $r.BackupPath }      else { 'none'    }
        Error          = ($r.Errors -join '; ')
    })

    if (-not $entry.IsLocal) { $entry.Job | Remove-Job -Force }
}

# Final summary table
Write-Log -Spacer
Write-Log '===============================================================' -Color Cyan
Write-Log '  STEP 1 SUMMARY' -Color Cyan
Write-Log '===============================================================' -Color Cyan

$colW = @(40, 8, 20, 10, 10, 50)
$hdr  = '{0,-40} {1,-8} {2,-20} {3,-10} {4,-10} {5}' -f `
        'Server', 'Result', 'Version', 'SvcStop', 'Backup', 'Backup path / Error'
Write-Log $hdr -Color White
Write-Log ('-' * 140) -Color DarkGray

foreach ($s in ($summary | Sort-Object Group, FQDN)) {
    $line = '{0,-40} {1,-8} {2,-20} {3,-10} {4,-10} {5}' -f `
        $s.FQDN,
        $s.Overall,
        $s.Version,
        $s.ServiceStopped,
        $(if ($s.BackupPath -ne 'none' -and $s.BackupPath -ne 'N/A') { 'Yes' } else { 'No' }),
        $(if ($s.Error) { $s.Error } else { $s.BackupPath })
    $color = if ($s.Overall -eq 'SUCCESS') { 'Green' } else { 'Red' }
    Write-Log $line -Color $color
}

$endTime = Get-Date
$dur     = $endTime - $startTime
Write-Log -Spacer
Write-Log "Completed : $($endTime.ToString('yyyy-MM-dd HH:mm:ss'))" -Color Cyan
Write-Log "Duration  : $($dur.ToString('mm\:ss'))"                  -Color Cyan
Write-Log "Log saved : $localLogPath"                                -Color Green
Write-Log '===============================================================' -Color Cyan

#endregion
