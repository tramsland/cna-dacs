#==================================================================================
#
#   SCRIPT: systemcenteragent_update.ps1
#
#   DESCRIPTION:
#   Local upgrade procedure for the OpenText System Center Agent.
#
#   SEQUENCE:
#     1.  Stop dependent services (OTSystemCenterAgent, Tomcat, CS Admin, CS)
#     2.  Compress install directory to a timestamped backup zip
#     3.  Uninstall current agent via msiexec
#     4.  Empty the install directory
#     5.  Install new agent from locally staged MSI
#     6.  Restore configuration.conf.ini from backup zip to install root
#     7.  Copy conf.ini from localhost subfolder to install root
#     8.  Start services in reverse stop order
#
#   EXPECTED FOLDER LAYOUT:
#     C:\DLA-failsafe\SystemCenter\
#     └── systemcenteragent_update.ps1    <- this file (no pre-staged MSI needed)
#
#   PATHS (edit $Config below if your environment differs):
#     Install dir  : E:\Customers\dacs\shared\systemcenteragent
#     Localhost dir: E:\Customers\dacs\shared\systemcenteragent\localhost
#     Backup dir   : E:\Customers\dacs\shared\   (parent of install dir)
#     Log dir      : C:\Logs
#
#   REQUIREMENTS:
#     - PowerShell 5.1 or later
#     - Run as Administrator
#     - Network access to patch.dacs.dla.mil (internal patch server)
#
#==================================================================================

#region Bootstrap
$principal = [Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()
if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Host "[ERROR] Must be run as Administrator." -ForegroundColor Red
    exit 1
}
#endregion

#region Configuration
$Config = [pscustomobject]@{

    # --- Paths ---
    InstallDir    = 'E:\Customers\dacs\shared\systemcenteragent'
    LocalhostDir  = 'E:\Customers\dacs\shared\systemcenteragent\localhost'
    LogDir        = 'C:\Logs'

    # --- MSI download from internal patch server ---
    MsiUrl        = 'https://patch.dacs.dla.mil/downloadAgent/?ostype=win&filetype=installer'
    MsiName       = 'OpenText_SystemCenter_Agent.msi'
    # MSI is downloaded to a temp folder at runtime — no pre-staging required

    # --- MSI install parameters ---
    MsiInstallDir = 'E:\Customers\Shared\DACS\SystemCenter'
    ServerName    = 'patch.dacs.dla.mil'
    HttpPort      = '443'

    # --- Config files to restore/copy ---
    RestoreFile   = 'configuration.conf.ini'   # restored from backup zip to install root
    CopyFile      = 'conf.ini'                 # copied from localhost\configuration\ dir to install root

    # --- Service stop order (restart is reversed automatically) ---
    # {INSTANCE} and {TOMCAT} are resolved dynamically at runtime
    ServiceOrder  = @('OTSystemCenterAgent', '{TOMCAT}', '{INSTANCE}Admin', '{INSTANCE}')

    # --- Timeouts ---
    StopTimeoutSec  = 60
    StartTimeoutSec = 60
}
#endregion

#region Logging
if (-not (Test-Path $Config.LogDir)) {
    New-Item -ItemType Directory -Path $Config.LogDir -Force | Out-Null
}
$LogPath = Join-Path $Config.LogDir "SystemCenterAgentUpdate_$(Get-Date -Format 'yyyyMMdd_HHmmss').log"

function Write-Log {
    param(
        [string]$Message,
        [string]$Level = 'INFO',
        [switch]$Spacer
    )
    if ($Spacer) {
        Add-Content -Path $LogPath -Value ''
        Write-Host ''
        return
    }
    $color = switch ($Level) {
        'OK'    { 'Green'  }
        'WARN'  { 'Yellow' }
        'ERROR' { 'Red'    }
        'HEAD'  { 'Cyan'   }
        default { 'White'  }
    }
    $entry = "[$Level] - $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') - $Message"
    Write-Host $entry -ForegroundColor $color
    Add-Content -Path $LogPath -Value $entry
}
#endregion

#region Service Helpers
function Get-ResolvedServices {
    # Dynamically resolve {INSTANCE} (Content Server) and {TOMCAT} service names
    $allSvcs = Get-CimInstance -ClassName Win32_Service -ErrorAction Stop

    $csSvc = $allSvcs | Where-Object {
        $_.Description -like '*Content Server*' -and
        $_.Description -notlike '*Content Server Admin*'
    } | Select-Object -First 1

    $tomcatSvc = $allSvcs | Where-Object {
        $_.DisplayName -like '*Apache*Tomcat*'
    } | Select-Object -First 1

    $instanceName = if ($csSvc)     { $csSvc.Name }     else { $null }
    $tomcatName   = if ($tomcatSvc) { $tomcatSvc.Name } else { $null }

    if (-not $instanceName) { Write-Log "Content Server service not found — {INSTANCE} entries will be skipped." 'WARN' }
    if (-not $tomcatName)   { Write-Log "Tomcat service not found — {TOMCAT} entry will be skipped."            'WARN' }

    $resolved = $Config.ServiceOrder | ForEach-Object {
        switch ($_) {
            '{TOMCAT}'   { if ($tomcatName)   { $tomcatName } }
            '{INSTANCE}' { if ($instanceName) { $instanceName } }
            default      {
                $_ -replace [regex]::Escape('{INSTANCE}'), ($instanceName ?? '')
            }
        }
    } | Where-Object { $_ -and $_.Trim() -ne '' }

    return $resolved
}

function Wait-ServiceState {
    param([string]$Name, [string]$TargetState, [int]$TimeoutSec, [string]$ActionLabel)
    $svc     = Get-Service -Name $Name -ErrorAction Stop
    $timeout = [TimeSpan]::FromSeconds($TimeoutSec)
    try {
        $svc.WaitForStatus($TargetState, $timeout)
        Write-Log "Service '$Name' $ActionLabel." 'OK'
    }
    catch [System.ServiceProcess.TimeoutException] {
        throw "Timed out waiting for '$Name' to reach '$TargetState' after ${TimeoutSec}s."
    }
}

function Stop-Services {
    param([string[]]$Names)
    $stopped = [System.Collections.Generic.List[string]]::new()
    foreach ($name in $Names) {
        $svc = Get-Service -Name $name -ErrorAction SilentlyContinue
        if (-not $svc) {
            Write-Log "Service '$name' not found — skipping." 'WARN'
            continue
        }
        if ($svc.Status -eq 'Running') {
            Write-Log "Stopping '$name'..."
            Stop-Service -Name $name -Force -ErrorAction Stop
            Wait-ServiceState -Name $name -TargetState 'Stopped' `
                -TimeoutSec $Config.StopTimeoutSec -ActionLabel 'stopped'
            $stopped.Add($name)
        } else {
            Write-Log "Service '$name' already stopped." 'WARN'
        }
    }
    return ,$stopped   # return as array
}

function Start-Services {
    param([string[]]$Names)
    # Restart in reverse order
    $reversed = [System.Linq.Enumerable]::Reverse($Names)
    foreach ($name in $reversed) {
        $svc = Get-Service -Name $name -ErrorAction SilentlyContinue
        if (-not $svc) {
            Write-Log "Service '$name' not found during restart — skipping." 'WARN'
            continue
        }
        try {
            Write-Log "Starting '$name'..."
            Start-Service -Name $name -ErrorAction Stop
            Wait-ServiceState -Name $name -TargetState 'Running' `
                -TimeoutSec $Config.StartTimeoutSec -ActionLabel 'started'
        }
        catch {
            Write-Log "ERROR starting '$name': $_" 'ERROR'
        }
    }
}
#endregion

#region Main
$startTime = Get-Date
Write-Log "================ SYSTEM CENTER AGENT UPDATE STARTED ================" 'HEAD'
Write-Log "Host      : $env:COMPUTERNAME"
Write-Log "Started   : $($startTime.ToString('yyyy-MM-dd HH:mm:ss'))"
Write-Log "Log       : $LogPath"
Write-Log -Spacer

$stoppedServices = @()

try {

    # -------------------------------------------------------------------------
    # Pre-flight: verify install directory exists
    # -------------------------------------------------------------------------
    if (-not (Test-Path $Config.InstallDir)) {
        throw "Install directory not found: $($Config.InstallDir)"
    }
    Write-Log "Install dir found: $($Config.InstallDir)" 'OK'
    Write-Log -Spacer

    # -------------------------------------------------------------------------
    # Pre-flight: download MSI from internal patch server
    # -------------------------------------------------------------------------
    Write-Log "Pre-flight: Downloading MSI from internal patch server..." 'HEAD'
    $msiTemp = Join-Path $env:TEMP "SCA_download_$(Get-Date -Format 'yyyyMMdd_HHmmss')"
    New-Item -ItemType Directory -Path $msiTemp -Force | Out-Null
    $msiPath = Join-Path $msiTemp $Config.MsiName

    Write-Log "Source : $($Config.MsiUrl)"
    Write-Log "Dest   : $msiPath"
    try {
        (New-Object System.Net.WebClient).DownloadFile($Config.MsiUrl, $msiPath)
    }
    catch {
        throw "MSI download failed: $_"
    }
    if (-not (Test-Path $msiPath) -or (Get-Item $msiPath).Length -eq 0) {
        throw "Downloaded MSI is missing or empty: $msiPath"
    }
    Write-Log "MSI downloaded successfully ($([math]::Round((Get-Item $msiPath).Length / 1MB, 2)) MB)." 'OK'
    Write-Log -Spacer

    # -------------------------------------------------------------------------
    # Phase 1 — Discover and stop services
    # -------------------------------------------------------------------------
    Write-Log "Phase 1: Stopping services..." 'HEAD'
    $serviceNames    = Get-ResolvedServices
    Write-Log "Service order: $($serviceNames -join ' -> ')"
    $stoppedServices = Stop-Services -Names $serviceNames
    Write-Log "All target services stopped." 'OK'
    Write-Log -Spacer

    # -------------------------------------------------------------------------
    # Phase 2 — Backup install directory
    # -------------------------------------------------------------------------
    Write-Log "Phase 2: Backing up install directory..." 'HEAD'
    $backupDir  = Split-Path $Config.InstallDir -Parent
    $backupName = "$(Split-Path $Config.InstallDir -Leaf)_backup_$(Get-Date -Format 'yyyyMMdd_HHmmss').zip"
    $backupPath = Join-Path $backupDir $backupName

    Write-Log "Compressing '$($Config.InstallDir)' -> '$backupPath'..."
    Compress-Archive -Path $Config.InstallDir -DestinationPath $backupPath -Force
    Write-Log "Backup created: $backupPath" 'OK'
    Write-Log -Spacer

    # -------------------------------------------------------------------------
    # Phase 3 — Uninstall current agent
    # -------------------------------------------------------------------------
    Write-Log "Phase 3: Uninstalling current agent..." 'HEAD'

    # Find the installed product by name to get its ProductCode
    $installed = Get-CimInstance -ClassName Win32_Product |
                 Where-Object { $_.Name -like '*System Center*' -or $_.Name -like '*OTS*' } |
                 Select-Object -First 1

    if ($installed) {
        Write-Log "Found installed product: '$($installed.Name)'  Code: $($installed.IdentifyingNumber)"
        $uninstallLog = Join-Path $Config.LogDir "sc_agent_uninstall_$(Get-Date -Format 'yyyyMMdd_HHmmss').log"
        $uninstallArgs = "/qn /l*vx `"$uninstallLog`" /x `"$($installed.IdentifyingNumber)`""
        Write-Log "Running: msiexec.exe $uninstallArgs"
        $proc = Start-Process 'msiexec.exe' -ArgumentList $uninstallArgs -Wait -PassThru
        if ($proc.ExitCode -ne 0) {
            throw "Uninstall failed with exit code $($proc.ExitCode). See: $uninstallLog"
        }
        Write-Log "Uninstall completed (exit 0)." 'OK'
    } else {
        Write-Log "No matching installed product found via Win32_Product — skipping MSI uninstall." 'WARN'
        Write-Log "If the agent was installed another way, manual uninstall may be required." 'WARN'
    }
    Write-Log -Spacer

    # -------------------------------------------------------------------------
    # Phase 4 — Empty the install directory
    # -------------------------------------------------------------------------
    Write-Log "Phase 4: Emptying install directory..." 'HEAD'
    Get-ChildItem -Path $Config.InstallDir -Force -ErrorAction SilentlyContinue |
        ForEach-Object {
            Remove-Item $_.FullName -Recurse -Force -ErrorAction Stop
            Write-Log "  Removed: $($_.Name)"
        }
    Write-Log "Install directory emptied." 'OK'
    Write-Log -Spacer

    # -------------------------------------------------------------------------
    # Phase 5 — Install new agent from staged MSI
    # -------------------------------------------------------------------------
    Write-Log "Phase 5: Installing new agent..." 'HEAD'
    $installLog  = Join-Path $Config.LogDir "sc_agent_install_$(Get-Date -Format 'yyyyMMdd_HHmmss').log"
    $installArgs = "/qn /l*vx `"$installLog`" /i `"$msiPath`" " +
                   "HTTP_PORT_NUMBER=`"$($Config.HttpPort)`" " +
                   "SERVER_NAME=`"$($Config.ServerName)`" " +
                   "INSTALLDIR=`"$($Config.MsiInstallDir)`""

    Write-Log "Running: msiexec.exe $installArgs"
    $proc = Start-Process 'msiexec.exe' -ArgumentList $installArgs -Wait -PassThru
    if ($proc.ExitCode -ne 0) {
        throw "Install failed with exit code $($proc.ExitCode). See: $installLog"
    }
    Write-Log "Install completed (exit 0)." 'OK'
    Write-Log "Install log: $installLog"
    Write-Log -Spacer

    # -------------------------------------------------------------------------
    # Phase 6 — Restore configuration.conf.ini from backup zip
    # -------------------------------------------------------------------------
    Write-Log "Phase 6: Restoring '$($Config.RestoreFile)' from backup..." 'HEAD'

    # Extract only the target file from the zip into a temp folder, then move it
    $tempExtract = Join-Path $env:TEMP "SCA_restore_$(Get-Date -Format 'yyyyMMdd_HHmmss')"
    New-Item -ItemType Directory -Path $tempExtract -Force | Out-Null

    Add-Type -AssemblyName System.IO.Compression.FileSystem
    $zip = [System.IO.Compression.ZipFile]::OpenRead($backupPath)
    try {
        # Match the file anywhere inside the zip (handles nested paths)
        $entry = $zip.Entries | Where-Object {
            $_.Name -ieq $Config.RestoreFile
        } | Select-Object -First 1

        if (-not $entry) {
            throw "'$($Config.RestoreFile)' not found inside backup zip: $backupPath"
        }

        $extractDest = Join-Path $tempExtract $Config.RestoreFile
        [System.IO.Compression.ZipFileExtensions]::ExtractToFile($entry, $extractDest, $true)
    }
    finally {
        $zip.Dispose()
    }

    $restoreDest = Join-Path $Config.InstallDir $Config.RestoreFile
    Move-Item -Path (Join-Path $tempExtract $Config.RestoreFile) -Destination $restoreDest -Force
    Remove-Item $tempExtract -Recurse -Force -ErrorAction SilentlyContinue

    Write-Log "Restored '$($Config.RestoreFile)' -> '$restoreDest'" 'OK'
    Write-Log -Spacer

    # -------------------------------------------------------------------------
    # Phase 7 — Copy conf.ini from localhost folder to install root
    # -------------------------------------------------------------------------
    Write-Log "Phase 7: Copying '$($Config.CopyFile)' from localhost folder..." 'HEAD'

    $confSource = Join-Path $Config.LocalhostDir "configuration\$($Config.CopyFile)"
    $confDest   = Join-Path $Config.InstallDir   $Config.CopyFile

    if (-not (Test-Path $confSource)) {
        throw "'$($Config.CopyFile)' not found at expected source: $confSource"
    }

    Copy-Item -Path $confSource -Destination $confDest -Force
    Write-Log "Copied '$confSource' -> '$confDest'" 'OK'
    Write-Log -Spacer

}
catch {
    Write-Log "FATAL ERROR: $_" 'ERROR'
    Write-Log "Update aborted. Services will still be restarted if they were stopped." 'ERROR'
    Write-Log -Spacer
}
finally {

    # -------------------------------------------------------------------------
    # Phase 8 — Restart services (always runs, even on error)
    # -------------------------------------------------------------------------
    Write-Log "Phase 8: Restarting services..." 'HEAD'
    if ($stoppedServices.Count -gt 0) {
        Start-Services -Names $stoppedServices
    } else {
        Write-Log "No services were recorded as stopped — nothing to restart." 'WARN'
    }

    # Clean up downloaded MSI temp folder
    if ($msiTemp -and (Test-Path $msiTemp)) {
        Remove-Item $msiTemp -Recurse -Force -ErrorAction SilentlyContinue
        Write-Log "Temp MSI folder removed." 'OK'
    }

    $endTime = Get-Date
    $dur     = $endTime - $startTime
    Write-Log -Spacer
    Write-Log "========================================" 'HEAD'
    Write-Log "Completed : $($endTime.ToString('yyyy-MM-dd HH:mm:ss'))" 'HEAD'
    Write-Log "Duration  : $($dur.ToString('mm\:ss'))" 'HEAD'
    Write-Log "========================================" 'HEAD'
    Write-Log "Log saved : $LogPath" 'OK'
    Write-Log "================ SYSTEM CENTER AGENT UPDATE FINISHED ================" 'HEAD'
}
#endregion
