#==================================================================================
#
#   SCRIPT: Launch-CNA-DACS.ps1
#
#   DESCRIPTION:
#   Interactive launcher for CNA-DACS maintenance scripts.
#   Must be run from C:\DLA-failsafe\patching\ on the admin workstation.
#
#   EXPECTED FOLDER LAYOUT (on admin workstation and staged to each server):
#
#     C:\DLA-failsafe\patching\
#     ├── Launch-CNA-DACS.ps1              <- this file
#     ├── servers.txt                      <- one FQDN per line, zone headers optional
#     ├── Backup\
#     │   └── backup.ps1
#     ├── SystemCenter\
#     │   └── systemcenteragent_update.ps1
#     └── TomcatUpgrade\
#         ├── tomcatupgrade.ps1
#         └── NewVersion\                  <- Tomcat build files staged here
#
#   STAGE operation copies to each server in servers.txt:
#     \\server\e$\DLA-failsafe\patching\Launch-CNA-DACS.ps1   (this script)
#     \\server\e$\DLA-failsafe\patching\TomcatUpgrade\        (full folder, overwrite)
#
#   SELECTION EXAMPLES:
#     1          Backup only
#     2          SystemCenter only
#     3          TomcatUpgrade only
#     1,3        Backup then TomcatUpgrade
#     2,3        SystemCenter then TomcatUpgrade
#     1,2,3      All three in sequence (same as A)
#     A          Run all available scripts in sequence
#     S          Stage software to all servers in servers.txt
#     Q          Quit
#
#   REQUIREMENTS:
#     - PowerShell 5.1 or later
#     - Run as Administrator
#     - Admin share access (\\server\e$) to all target servers
#
#==================================================================================

#region Bootstrap — must run as Administrator
$principal = [Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()
if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Host ""
    Write-Host "  [ERROR] This launcher must be run as Administrator." -ForegroundColor Red
    Write-Host "          Right-click PowerShell and choose 'Run as Administrator'." -ForegroundColor Yellow
    Write-Host ""
    pause
    exit 1
}
#endregion

#region Configuration
# Execution directory — launcher must live here
$RootDir = "C:\DLA-failsafe\patching"

# Remote destination base path — server name is inserted between \\ and \e$
$RemoteBase = "e$\DLA-failsafe\patching"

# Items to copy during staging (relative to $RootDir)
# Each entry: Name shown in output, relative source path, type (File or Folder)
$StageItems = @(
    [pscustomobject]@{ Label = 'Launcher script'; RelPath = 'Launch-CNA-DACS.ps1'; Type = 'File'   }
    [pscustomobject]@{ Label = 'TomcatUpgrade';   RelPath = 'TomcatUpgrade';        Type = 'Folder' }
)

$ScriptDefs = [ordered]@{
    'Backup'        = [pscustomobject]@{ SubFolder = 'Backup';        FileName = 'backup.ps1' }
    'SystemCenter'  = [pscustomobject]@{ SubFolder = 'SystemCenter';  FileName = 'systemcenteragent_update.ps1' }
    'TomcatUpgrade' = [pscustomobject]@{ SubFolder = 'TomcatUpgrade'; FileName = 'tomcatupgrade.ps1' }
}

$ScriptDescriptions = [ordered]@{
    'Backup'        = 'Content Server Backup  — stops services, compresses CS directory, rotates old backups, restarts services'
    'SystemCenter'  = 'System Center Update   — manages OTSystemCenterAgent alongside CS/Tomcat service lifecycle'
    'TomcatUpgrade' = 'Tomcat Upgrade         — pre-flight checks, parallel deployment, version verification, rollback support'
}

$LogDir = "C:\Logs"
#endregion

#region Helpers
function Write-Header {
    param([string]$Text)
    $line = '=' * 70
    Write-Host ""
    Write-Host $line           -ForegroundColor Cyan
    Write-Host ("  " + $Text) -ForegroundColor Cyan
    Write-Host $line           -ForegroundColor Cyan
    Write-Host ""
}

function Write-Status {
    param([string]$Message, [string]$Level = 'INFO')
    $ts    = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $color = switch ($Level) {
        'OK'    { 'Green'  }
        'WARN'  { 'Yellow' }
        'ERROR' { 'Red'    }
        default { 'White'  }
    }
    Write-Host "  [$Level] $ts - $Message" -ForegroundColor $color
}

function Resolve-ScriptPath {
    param([string]$Key)
    $def      = $ScriptDefs[$Key]
    $fullPath = Join-Path $RootDir (Join-Path $def.SubFolder $def.FileName)
    if (Test-Path $fullPath) { return $fullPath }
    Write-Status "Script not found: $fullPath" 'ERROR'
    Write-Host   "  Expected: $RootDir\$($def.SubFolder)\$($def.FileName)" -ForegroundColor Yellow
    return $null
}

function Get-ServerList {
    # Returns a flat list of FQDNs from servers.txt, stripping zone headers and comments
    $serversFile = Join-Path $RootDir "servers.txt"
    if (-not (Test-Path $serversFile)) {
        Write-Status "servers.txt not found at: $serversFile" 'ERROR'
        return $null
    }
    $servers = Get-Content $serversFile | ForEach-Object { $_.Trim() } |
               Where-Object { $_ -ne '' -and $_ -notmatch '^\s*#' -and $_ -notmatch '^\[' }
    if ($servers.Count -eq 0) {
        Write-Status "No server entries found in servers.txt." 'ERROR'
        return $null
    }
    return $servers
}

function Show-Menu {
    Write-Header "CNA-DACS Script Launcher  |  $RootDir"

    Write-Host "  Available scripts:" -ForegroundColor White
    Write-Host ""

    $keys = @($ScriptDefs.Keys)
    for ($i = 0; $i -lt $keys.Count; $i++) {
        $key      = $keys[$i]
        $def      = $ScriptDefs[$key]
        $fullPath = Join-Path $RootDir (Join-Path $def.SubFolder $def.FileName)
        $status   = if (Test-Path $fullPath) { "[READY]  " } else { "[MISSING]" }
        $color    = if (Test-Path $fullPath) { "Yellow"    } else { "DarkGray"  }
        Write-Host ("  [{0}] {1}  {2}" -f ($i + 1), $status, $ScriptDescriptions[$key]) -ForegroundColor $color
    }

    Write-Host ""

    # Stage option — show what will be copied and to where
    $stageReady = $true
    foreach ($item in $StageItems) {
        $src = Join-Path $RootDir $item.RelPath
        if (-not (Test-Path $src)) { $stageReady = $false; break }
    }
    $stageStatus = if ($stageReady) { "[READY]  " } else { "[PARTIAL]" }
    $stageColor  = if ($stageReady) { "Cyan"      } else { "Yellow"    }
    Write-Host ("  [S] {0}  Stage software to all servers in servers.txt" -f $stageStatus) -ForegroundColor $stageColor
    Write-Host "         Copies: Launch-CNA-DACS.ps1  +  TomcatUpgrade\" -ForegroundColor DarkGray
    Write-Host "         Dest  : \\<server>\e`$\DLA-failsafe\patching\"   -ForegroundColor DarkGray

    Write-Host ""
    Write-Host "  [A]  Run ALL available scripts in sequence" -ForegroundColor Magenta
    Write-Host "  [Q]  Quit"                                  -ForegroundColor Gray
    Write-Host ""
    Write-Host "  Enter a number, or any combination separated by commas or spaces:" -ForegroundColor White
    Write-Host "    1        Backup only"                     -ForegroundColor DarkGray
    Write-Host "    2,3      SystemCenter then TomcatUpgrade" -ForegroundColor DarkGray
    Write-Host "    1 3      Backup then TomcatUpgrade"       -ForegroundColor DarkGray
    Write-Host "    1,2,3    All three in sequence"           -ForegroundColor DarkGray
    Write-Host ""
}

function Resolve-SelectionTokens {
    param([string]$RawInput)
    $keys   = @($ScriptDefs.Keys)
    $tokens = $RawInput -split '[,\s]+' | Where-Object { $_ -ne '' }
    $chosen = [System.Collections.Generic.List[string]]::new()
    $bad    = [System.Collections.Generic.List[string]]::new()

    foreach ($token in $tokens) {
        $index = 0
        if ([int]::TryParse($token, [ref]$index) -and $index -ge 1 -and $index -le $keys.Count) {
            $key = $keys[$index - 1]
            if (-not $chosen.Contains($key)) { $chosen.Add($key) }
        } else {
            $bad.Add($token)
        }
    }

    if ($bad.Count -gt 0) {
        Write-Host ""
        Write-Host ("  Invalid entry: '{0}'  — use numbers 1-{1}, A, S, or Q." -f ($bad -join ', '), $keys.Count) -ForegroundColor Red
        return $null
    }
    return ,$chosen
}

function Invoke-SelectedScript {
    param([string]$Key)

    $scriptPath = Resolve-ScriptPath -Key $Key
    if (-not $scriptPath) {
        Write-Host ""
        Write-Host "  Press any key to continue..." -ForegroundColor Gray
        $null = $Host.UI.RawUI.ReadKey('NoEcho,IncludeKeyDown')
        return
    }

    $scriptDir = Split-Path $scriptPath -Parent
    Write-Header "Running: $Key"
    Write-Status "Script : $scriptPath" 'INFO'
    Write-Status "WorkDir: $scriptDir"  'INFO'
    Write-Host ""

    try {
        Push-Location $scriptDir
        & $scriptPath
        Write-Host ""
        Write-Status "$Key completed." 'OK'
    }
    catch {
        Write-Host ""
        Write-Status "$Key encountered an unhandled error: $_" 'ERROR'
    }
    finally {
        Pop-Location
    }

    Write-Host ""
    Write-Host "  Press any key to return to the menu..." -ForegroundColor Gray
    $null = $Host.UI.RawUI.ReadKey('NoEcho,IncludeKeyDown')
}

function Invoke-StageSoftware {
    Write-Header "Stage Software to Servers"

    # Validate source items exist before touching any server
    $missing = $StageItems | Where-Object { -not (Test-Path (Join-Path $RootDir $_.RelPath)) }
    if ($missing) {
        foreach ($m in $missing) {
            Write-Status "Source not found: $(Join-Path $RootDir $m.RelPath)" 'ERROR'
        }
        Write-Host ""
        Write-Host "  Staging aborted — fix missing source items and retry." -ForegroundColor Red
        Write-Host ""
        Write-Host "  Press any key to return to the menu..." -ForegroundColor Gray
        $null = $Host.UI.RawUI.ReadKey('NoEcho,IncludeKeyDown')
        return
    }

    $servers = Get-ServerList
    if (-not $servers) {
        Write-Host ""
        Write-Host "  Press any key to return to the menu..." -ForegroundColor Gray
        $null = $Host.UI.RawUI.ReadKey('NoEcho,IncludeKeyDown')
        return
    }

    Write-Status "Servers  : $($servers.Count) target(s) from servers.txt" 'INFO'
    Write-Status "Source   : $RootDir" 'INFO'
    Write-Status "Dest     : \\<server>\$RemoteBase" 'INFO'
    Write-Host ""
    Write-Host "  Items to copy:" -ForegroundColor White
    foreach ($item in $StageItems) {
        Write-Host ("    {0,-20} {1}" -f $item.Type, $item.RelPath) -ForegroundColor DarkGray
    }
    Write-Host ""

    $pass = 0
    $fail = 0

    foreach ($server in $servers) {
        $remoteDest = "\\$server\$RemoteBase"
        Write-Status "[$server] Connecting to $remoteDest ..." 'INFO'

        # Test admin share reachability
        if (-not (Test-Path "\\$server\e$")) {
            Write-Status "[$server] Cannot reach \\$server\e$ — skipping." 'ERROR'
            $fail++
            continue
        }

        # Ensure destination folder exists
        try {
            if (-not (Test-Path $remoteDest)) {
                New-Item -ItemType Directory -Path $remoteDest -Force | Out-Null
                Write-Status "[$server] Created destination folder." 'OK'
            }
        }
        catch {
            Write-Status "[$server] Failed to create destination folder: $_" 'ERROR'
            $fail++
            continue
        }

        # Copy each staged item
        $serverOk = $true
        foreach ($item in $StageItems) {
            $src  = Join-Path $RootDir $item.RelPath
            $dest = Join-Path $remoteDest $item.RelPath

            try {
                if ($item.Type -eq 'File') {
                    Copy-Item -Path $src -Destination $dest -Force
                    Write-Status "[$server] Copied file : $($item.RelPath)" 'OK'
                }
                elseif ($item.Type -eq 'Folder') {
                    # Ensure destination subfolder exists then mirror contents
                    if (-not (Test-Path $dest)) {
                        New-Item -ItemType Directory -Path $dest -Force | Out-Null
                    }
                    Copy-Item -Path "$src\*" -Destination $dest -Recurse -Force
                    Write-Status "[$server] Copied folder: $($item.RelPath)" 'OK'
                }
            }
            catch {
                Write-Status "[$server] Failed to copy $($item.RelPath): $_" 'ERROR'
                $serverOk = $false
            }
        }

        if ($serverOk) { $pass++ } else { $fail++ }
    }

    Write-Host ""
    Write-Host ("  ----------------------------------------") -ForegroundColor Cyan
    Write-Host ("  Staging complete — Success: {0}   Failed: {1}   Total: {2}" -f $pass, $fail, ($pass + $fail)) -ForegroundColor Cyan
    Write-Host ("  ----------------------------------------") -ForegroundColor Cyan
    Write-Host ""
    Write-Host "  Press any key to return to the menu..." -ForegroundColor Gray
    $null = $Host.UI.RawUI.ReadKey('NoEcho,IncludeKeyDown')
}
#endregion

#region Startup checks
if (-not (Test-Path $RootDir)) {
    Write-Host ""
    Write-Host "  [ERROR] Root directory not found: $RootDir" -ForegroundColor Red
    Write-Host "  This launcher must be run from C:\DLA-failsafe\patching\" -ForegroundColor Yellow
    Write-Host ""
    pause
    exit 1
}

if (-not (Test-Path $LogDir)) { New-Item -ItemType Directory -Path $LogDir -Force | Out-Null }

$serversFile = Join-Path $RootDir "servers.txt"
if (-not (Test-Path $serversFile)) {
    Write-Host ""
    Write-Host "  [WARN] servers.txt not found at: $serversFile" -ForegroundColor Yellow
    Write-Host "  Required by Backup and Stage operations (one FQDN per line)." -ForegroundColor Yellow
    Write-Host ""
    Start-Sleep -Seconds 2
}
#endregion

#region Main Loop
:MainLoop while ($true) {
    Clear-Host
    Show-Menu

    $raw = (Read-Host "  Enter selection").Trim().ToUpper()

    switch ($raw) {

        'Q' {
            Write-Host ""
            Write-Host "  Exiting launcher." -ForegroundColor Gray
            Write-Host ""
            break MainLoop
        }

        'A' {
            foreach ($key in $ScriptDefs.Keys) {
                if (Resolve-ScriptPath -Key $key) {
                    Invoke-SelectedScript -Key $key
                } else {
                    Write-Status "Skipping $key — script file not found." 'WARN'
                }
            }
        }

        'S' {
            Invoke-StageSoftware
        }

        default {
            $selected = Resolve-SelectionTokens -RawInput $raw

            if ($null -eq $selected) {
                Start-Sleep -Seconds 2
            } elseif ($selected.Count -eq 0) {
                Write-Host ""
                Write-Host "  No valid selection. Enter numbers 1-3, a combination, A, S, or Q." -ForegroundColor Red
                Start-Sleep -Seconds 2
            } else {
                foreach ($key in $selected) {
                    Invoke-SelectedScript -Key $key
                }
            }
        }
    }
}
#endregion
