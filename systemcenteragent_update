#Requires -RunAsAdministrator
<#
.SYNOPSIS
    Stops, backs up, uninstalls, reinstalls, and restarts the OTSystemCenterAgent service.

.DESCRIPTION
    1.  Stops the OTSystemCenterAgent service
    2.  Reads the service's installation directory
    3.  Creates a timestamped backup of that directory
    4.  Keeps only the 2 most recent backups, deleting older ones
    5.  Uninstalls the current agent (via msiexec)
    6.  Clears all contents from the install directory
    7.  Downloads and installs the latest agent to the same directory
    8.  Restores the localcerts directory from the backup into the new install root
    9.  Backs up the new installation's configuration\config.ini
    10. Copies localcerts\config.ini into the configuration directory
    11. Starts the service

    Directory layout expected under the install root:
        <InstallDir>\
            configuration\     <- contains config.ini
            localcerts\        <- contains config.ini to promote

.NOTES
    Must be run as Administrator.
    Tested against PowerShell 5.1.
#>

# ─── Configuration ────────────────────────────────────────────────────────────
$ServiceName       = "OTSystemCenterAgent"
$ServerName        = "patch.dacs.dla.mil"
$HttpPort          = "443"
$InstallerUrl      = "https://" + $ServerName + ":/downloadAgent/?ostype=win&filetype=installer"
$InstallerName     = "OpenText_SystemCenter_Agent.msi"
$LogName           = "sc_agent_install.log"
$MaxBackups        = 2
$LocalCertsDirName = "localcerts"
$ConfigDirName     = "configuration"
$ConfigFileName    = "config.ini"
$WorkDir           = "C:\DLA-Failsafe\"
# ──────────────────────────────────────────────────────────────────────────────

# ─── Validate working directory ──────────────────────────────────────────────
if (-not (Test-Path -Path $WorkDir)) {
    Write-Host ("[ERROR] Working directory '" + $WorkDir + "' does not exist. Create it and re-run.")
    exit 1
}

function Write-Log {
    param([string]$Message, [string]$Level = "INFO")
    $ts    = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $entry = "[" + $ts + "] [" + $Level + "] " + $Message
    Write-Host $entry
    Add-Content -Path (Join-Path $PSScriptRoot "OTSystemCenterAgent_Update.log") -Value $entry
}

# ─── Step 1: Get service and resolve install directory ────────────────────────
Write-Log "Looking up service: $ServiceName"

$svc = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue
if (-not $svc) {
    Write-Log ("Service '" + $ServiceName + "' not found. Aborting.") "ERROR"
    exit 1
}

# Pull the binary path from WMI to find the install directory
$wmiSvc = Get-CimInstance -ClassName Win32_Service -Filter ("Name='" + $ServiceName + "'")
if (-not $wmiSvc) {
    Write-Log ("Could not query WMI for service '" + $ServiceName + "'. Aborting.") "ERROR"
    exit 1
}

# PathName may look like: "C:\Program Files\OpenText\SystemCenter\Agent\OTAgent.exe" -args
$rawPath    = $wmiSvc.PathName -replace '^"([^"]+)".*$', '$1'   # strip quotes & args
$rawPath    = $rawPath -replace '^([^ ]+).*$', '$1'              # handle unquoted path
$InstallDir = Split-Path -Parent $rawPath

if (-not (Test-Path -Path $InstallDir)) {
    Write-Log ("Resolved install directory '" + $InstallDir + "' does not exist. Aborting.") "ERROR"
    exit 1
}

Write-Log ("Install directory resolved to: " + $InstallDir)

# Derive key paths from the install directory
$LocalCertsDir    = Join-Path $InstallDir $LocalCertsDirName
$ConfigDir        = Join-Path $InstallDir $ConfigDirName
$ConfigFile       = Join-Path $ConfigDir $ConfigFileName
$LocalCertsConfig = Join-Path $LocalCertsDir $ConfigFileName

Write-Log ("Configuration directory : " + $ConfigDir)
Write-Log ("localcerts directory    : " + $LocalCertsDir)

# ─── Step 2: Stop the service ─────────────────────────────────────────────────
Write-Log "Stopping service: $ServiceName"
try {
    Stop-Service -Name $ServiceName -Force -ErrorAction Stop
    Write-Log "Service stopped successfully."
} catch {
    Write-Log ("Failed to stop service: " + $_.Exception.Message) "ERROR"
    exit 1
}

# ─── Step 3: Back up the install directory ────────────────────────────────────
$dirName    = Split-Path -Leaf $InstallDir
$parentDir  = Split-Path -Parent $InstallDir
$timestamp  = Get-Date -Format "yyyyMMdd_HHmmss"
$backupName = $dirName + "_" + $timestamp
$backupPath = Join-Path $parentDir $backupName

Write-Log ("Creating backup: " + $backupPath)
try {
    Copy-Item -Path $InstallDir -Destination $backupPath -Recurse -Force -ErrorAction Stop
    Write-Log "Backup created successfully."
} catch {
    Write-Log ("Backup failed: " + $_.Exception.Message) "ERROR"
    Start-Service -Name $ServiceName -ErrorAction SilentlyContinue
    exit 1
}

# ─── Step 4: Prune old backups (keep only the 2 most recent) ─────────────────
Write-Log ("Pruning old backups (keeping " + $MaxBackups + " most recent)...")
$escapedDirName  = [regex]::Escape($dirName)
$backupPattern   = "^" + $escapedDirName + "_\d{8}_\d{6}$"
$existingBackups = Get-ChildItem -Path $parentDir -Directory |
    Where-Object { $_.Name -match $backupPattern } |
    Sort-Object -Property Name -Descending

if ($existingBackups.Count -gt $MaxBackups) {
    $toDelete = $existingBackups | Select-Object -Skip $MaxBackups
    foreach ($old in $toDelete) {
        Write-Log ("Deleting old backup: " + $old.FullName)
        Remove-Item -Path $old.FullName -Recurse -Force -ErrorAction SilentlyContinue
    }
}

# ─── Step 5: Uninstall current agent ─────────────────────────────────────────
Write-Log "Uninstalling current OTSystemCenterAgent..."

$uninstallRoots = @(
    "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall",
    "HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall"
)

$productCode = $null
foreach ($root in $uninstallRoots) {
    $found = Get-ChildItem -Path $root -ErrorAction SilentlyContinue |
        Get-ItemProperty -ErrorAction SilentlyContinue |
        Where-Object { $_.DisplayName -match "OpenText.*SystemCenter.*Agent|OTSystemCenter" } |
        Select-Object -First 1
    if ($found) {
        $productCode = $found.PSChildName
        break
    }
}

if ($productCode) {
    Write-Log ("Found product code: " + $productCode + " - running uninstall...")
    $proc = Start-Process -FilePath "msiexec.exe" -ArgumentList ("/qn /x " + $productCode) -Wait -PassThru
    if ($proc.ExitCode -ne 0) {
        Write-Log ("Uninstall returned exit code " + $proc.ExitCode + ". Continuing anyway.") "WARN"
    } else {
        Write-Log "Uninstall completed successfully."
    }
} else {
    Write-Log "No matching product found in registry. Skipping uninstall step." "WARN"
}

# ─── Step 6: Clear the install directory contents ────────────────────────────
# The directory itself is preserved so INSTALLDIR points to the same path.
# All files and subfolders inside are removed for a clean install.
Write-Log ("Clearing install directory contents: " + $InstallDir)
try {
    Get-ChildItem -Path $InstallDir -Force |
        Remove-Item -Recurse -Force -ErrorAction Stop
    Write-Log "Install directory cleared successfully."
} catch {
    Write-Log ("Failed to clear install directory: " + $_.Exception.Message) "ERROR"
    exit 1
}

# ─── Step 7: Download and install the new agent ───────────────────────────────
$installerPath = Join-Path $WorkDir $InstallerName
$logPath       = Join-Path $WorkDir $LogName

Write-Log ("Downloading installer from " + $InstallerUrl + " ...")
try {
    $webClient = New-Object System.Net.WebClient
    $webClient.DownloadFile($InstallerUrl, $installerPath)
    Write-Log ("Download complete: " + $installerPath)
} catch {
    Write-Log ("Download failed: " + $_.Exception.Message) "ERROR"
    exit 1
}

Write-Log ("Installing agent to: " + $InstallDir + " (log: " + $logPath + ") ...")
$installArgs = "/qn /l*vx `"" + $logPath + "`" /i `"" + $installerPath + "`" INSTALLDIR=`"" + $InstallDir + "`" HTTP_PORT_NUMBER=`"" + $HttpPort + "`" SERVER_NAME=`"" + $ServerName + "`""
$proc = Start-Process -FilePath "msiexec.exe" -ArgumentList $installArgs -WorkingDirectory $WorkDir -Wait -PassThru

if ($proc.ExitCode -ne 0) {
    Write-Log ("Installation failed with exit code " + $proc.ExitCode + ". Check log: " + $logPath) "ERROR"
    exit 1
}
Write-Log "Installation completed successfully."

# ─── Step 8: Restore localcerts from backup ───────────────────────────────────
# Source is the backup copy taken in Step 3, guaranteeing the pre-wipe content.
$localCertsBackup = Join-Path $backupPath $LocalCertsDirName

if (Test-Path -Path $localCertsBackup) {
    Write-Log ("Restoring '" + $LocalCertsDirName + "' from backup to: " + $LocalCertsDir)
    try {
        Copy-Item -Path $localCertsBackup -Destination $LocalCertsDir -Recurse -Force -ErrorAction Stop
        Write-Log ("'" + $LocalCertsDirName + "' restored successfully.")
    } catch {
        Write-Log ("Failed to restore '" + $LocalCertsDirName + "': " + $_.Exception.Message) "WARN"
    }
} else {
    Write-Log ("'" + $LocalCertsDirName + "' not found in backup (" + $localCertsBackup + "). Skipping restore.") "WARN"
}

# ─── Step 9: Back up new install config.ini, then apply localcerts config.ini ─
# The restored localcerts\config.ini is the authoritative config for this host.
# Before overwriting, the installer-generated config.ini is preserved with a
# timestamp so it can be referenced if needed.

if (-not (Test-Path -Path $LocalCertsConfig)) {
    Write-Log ("'" + $LocalCertsDirName + "\" + $ConfigFileName + "' not found at '" + $LocalCertsConfig + "'. Skipping config replacement.") "WARN"
} elseif (-not (Test-Path -Path $ConfigDir)) {
    Write-Log ("Configuration directory '" + $ConfigDir + "' does not exist in new install. Skipping config replacement.") "WARN"
} else {
    # Back up the installer-generated config.ini before overwriting
    if (Test-Path -Path $ConfigFile) {
        $configBackup = $ConfigFile + "_" + $timestamp + ".bak"
        Write-Log ("Backing up new install " + $ConfigFileName + " to: " + $configBackup)
        try {
            Copy-Item -Path $ConfigFile -Destination $configBackup -Force -ErrorAction Stop
            Write-Log ($ConfigFileName + " backed up successfully.")
        } catch {
            Write-Log ("Failed to back up " + $ConfigFileName + ": " + $_.Exception.Message) "WARN"
        }
    } else {
        Write-Log ("No " + $ConfigFileName + " found in '" + $ConfigDir + "' - skipping backup, copying anyway.") "WARN"
    }

    # Copy localcerts\config.ini into the configuration directory
    Write-Log ("Copying '" + $LocalCertsDirName + "\" + $ConfigFileName + "' to: " + $ConfigFile)
    try {
        Copy-Item -Path $LocalCertsConfig -Destination $ConfigFile -Force -ErrorAction Stop
        Write-Log ($ConfigFileName + " replaced successfully.")
    } catch {
        Write-Log ("Failed to copy " + $ConfigFileName + " from '" + $LocalCertsDirName + "': " + $_.Exception.Message) "ERROR"
        exit 1
    }
}

# ─── Step 10: Start the service ──────────────────────────────────────────────
Write-Log "Starting service: $ServiceName"
try {
    Start-Service -Name $ServiceName -ErrorAction Stop
    Write-Log "Service started successfully."
} catch {
    Write-Log ("Failed to start service: " + $_.Exception.Message) "ERROR"
    exit 1
}

Write-Log "OTSystemCenterAgent update complete."
