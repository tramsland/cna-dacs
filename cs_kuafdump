# =============================================================================
# Get-OTCSUsersAndGroups.ps1
# OpenText Content Server 26.1 - Export Users, Groups & Memberships
# PowerShell 5.1 compatible
# =============================================================================

# -----------------------------------------------------------------------------
# CONFIGURATION - Update these values before running
# -----------------------------------------------------------------------------
$Config = @{
    BaseUrl      = "https://yourserver/otcs/cs.exe"   # Base OTCS URL
    Username     = "admin"                             # OTCS username
    SkipSSLCheck = $false                              # Set $true for self-signed certs
    OutputFolder = "C:\OTCS_Export"                    # Folder for CSV output
    PageSize     = 100                                 # Results per page (max 100)
}

# -----------------------------------------------------------------------------
# SECURE PASSWORD PROMPT
# -----------------------------------------------------------------------------
$securePassword  = Read-Host -Prompt "Enter password for '$($Config.Username)'" -AsSecureString
$credential      = New-Object System.Management.Automation.PSCredential($Config.Username, $securePassword)
$Config.Password = $credential.GetNetworkCredential().Password

# -----------------------------------------------------------------------------
# SSL BYPASS (only activates if SkipSSLCheck = $true)
# -----------------------------------------------------------------------------
if ($Config.SkipSSLCheck) {
    Write-Host "[SSL] Bypassing SSL certificate validation..." -ForegroundColor Yellow
    Add-Type @"
using System.Net;
using System.Security.Cryptography.X509Certificates;
public class TrustAllCerts : ICertificatePolicy {
    public bool CheckValidationResult(
        ServicePoint srvPoint, X509Certificate certificate,
        WebRequest request, int certificateProblem) { return true; }
}
"@
    [System.Net.ServicePointManager]::CertificatePolicy = New-Object TrustAllCerts
    [System.Net.ServicePointManager]::SecurityProtocol  = [System.Net.SecurityProtocolType]::Tls12
}

# -----------------------------------------------------------------------------
# HELPERS
# -----------------------------------------------------------------------------

function Write-Log {
    param([string]$Message, [string]$Level = "INFO")
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $color = switch ($Level) {
        "INFO"    { "Cyan"   }
        "SUCCESS" { "Green"  }
        "WARN"    { "Yellow" }
        "ERROR"   { "Red"    }
        default   { "White"  }
    }
    Write-Host "[$timestamp][$Level] $Message" -ForegroundColor $color
}

function Get-ResponseBody {
    # Reads the raw body from a failed WebException for better error detail
    param($Exception)
    try {
        $stream = $Exception.Response.GetResponseStream()
        $reader = New-Object System.IO.StreamReader($stream)
        return $reader.ReadToEnd()
    } catch { return "(unable to read response body)" }
}

function Invoke-OTCSRequest {
    param(
        [string]$Uri,
        [string]$Method  = "GET",
        [hashtable]$Headers,
        [hashtable]$Body  = $null
    )
    try {
        $params = @{
            Uri         = $Uri
            Method      = $Method
            Headers     = $Headers
            ErrorAction = "Stop"
        }
        if ($Body) {
            $params.Body        = $Body
            $params.ContentType = "application/x-www-form-urlencoded"
        }
        return Invoke-RestMethod @params
    }
    catch {
        $statusCode = $_.Exception.Response.StatusCode.value__
        $body       = Get-ResponseBody $_.Exception
        Write-Log "API call failed [$statusCode]: $Uri" "ERROR"
        Write-Log "  Response body: $body" "ERROR"
        return $null
    }
}

function Get-PropValue {
    # Safely navigate nested OTCS response shapes:
    #   results[].data.properties  (v2 standard)
    #   results[].data             (v2 flat)
    #   item directly              (v1)
    param($Item)
    if ($Item.PSObject.Properties["data"]) {
        $d = $Item.data
        if ($d.PSObject.Properties["properties"]) { return $d.properties }
        return $d
    }
    if ($Item.PSObject.Properties["properties"]) { return $Item.properties }
    return $Item
}

function Ensure-OutputFolder {
    param([string]$Path)
    if (-not (Test-Path $Path)) {
        New-Item -ItemType Directory -Path $Path -Force | Out-Null
        Write-Log "Created output folder: $Path" "INFO"
    }
}

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------

function Get-OTCSTicket {
    param([hashtable]$Config)
    Write-Log "Authenticating as '$($Config.Username)' on $($Config.BaseUrl)" "INFO"

    $uri  = "$($Config.BaseUrl)/api/v1/auth"
    $body = @{ username = $Config.Username; password = $Config.Password }

    try {
        $response = Invoke-RestMethod -Uri $uri -Method POST -Body $body -ErrorAction Stop
        if ($response.ticket) {
            Write-Log "Authentication successful." "SUCCESS"
            return $response.ticket
        }
        Write-Log "Auth response had no ticket. Response: $($response | ConvertTo-Json -Depth 3)" "ERROR"
        return $null
    }
    catch {
        $statusCode = $_.Exception.Response.StatusCode.value__
        $body       = Get-ResponseBody $_.Exception
        Write-Log "Authentication failed [$statusCode]: $($_.Exception.Message)" "ERROR"
        Write-Log "  Response body: $body" "ERROR"
        return $null
    }
}

# -----------------------------------------------------------------------------
# DATA RETRIEVAL
# -----------------------------------------------------------------------------

function Get-OTCSUsers {
    param([hashtable]$Headers, [string]$BaseUrl, [int]$PageSize)
    Write-Log "--- Retrieving Users ---" "INFO"

    $allUsers = @()
    $page     = 1

    do {
        # where_type=0 → Users only
        $uri      = "$BaseUrl/api/v2/members?where_type=0&limit=$PageSize&page=$page"
        Write-Log "  GET $uri" "INFO"
        $response = Invoke-OTCSRequest -Uri $uri -Headers $Headers
        if (-not $response) { break }

        $items = if ($response.results) { $response.results }
                 elseif ($response.data) { $response.data }
                 else { $null }

        if (-not $items -or $items.Count -eq 0) {
            Write-Log "  No more users on page $page." "INFO"
            break
        }

        foreach ($item in $items) {
            $p = Get-PropValue $item
            $allUsers += [PSCustomObject]@{
                ID           = $p.id
                LoginName    = $p.name
                DisplayName  = $p.display_name
                FirstName    = $p.first_name
                LastName     = $p.last_name
                Email        = $p.business_email
                GroupID      = $p.group_id
                Enabled      = if ($null -ne $p.deleted) { -not $p.deleted } else { $true }
                CreatedDate  = $p.create_date
                ModifiedDate = $p.modify_date
            }
        }

        Write-Log "  Page $page : $($items.Count) users (running total: $($allUsers.Count))" "INFO"
        if ($items.Count -lt $PageSize) { break }
        $page++

    } while ($true)

    Write-Log "Total users: $($allUsers.Count)" "SUCCESS"
    return $allUsers
}

function Get-OTCSGroups {
    param([hashtable]$Headers, [string]$BaseUrl, [int]$PageSize)
    Write-Log "--- Retrieving Groups ---" "INFO"

    $allGroups = @()
    $page      = 1

    do {
        # where_type=1 → Groups only
        $uri      = "$BaseUrl/api/v2/members?where_type=1&limit=$PageSize&page=$page"
        Write-Log "  GET $uri" "INFO"
        $response = Invoke-OTCSRequest -Uri $uri -Headers $Headers
        if (-not $response) { break }

        $items = if ($response.results) { $response.results }
                 elseif ($response.data) { $response.data }
                 else { $null }

        if (-not $items -or $items.Count -eq 0) {
            Write-Log "  No more groups on page $page." "INFO"
            break
        }

        foreach ($item in $items) {
            $p = Get-PropValue $item
            $allGroups += [PSCustomObject]@{
                ID           = $p.id
                Name         = $p.name
                DisplayName  = $p.display_name
                CreatedDate  = $p.create_date
                ModifiedDate = $p.modify_date
            }
        }

        Write-Log "  Page $page : $($items.Count) groups (running total: $($allGroups.Count))" "INFO"
        if ($items.Count -lt $PageSize) { break }
        $page++

    } while ($true)

    Write-Log "Total groups: $($allGroups.Count)" "SUCCESS"
    return $allGroups
}

function Get-OTCSGroupMemberships {
    param([hashtable]$Headers, [string]$BaseUrl, [array]$Groups, [int]$PageSize)
    Write-Log "--- Retrieving Group Memberships for $($Groups.Count) groups ---" "INFO"

    $allMemberships = @()

    foreach ($group in $Groups) {
        Write-Log "  Group: '$($group.Name)' (ID: $($group.ID))" "INFO"
        $page = 1

        do {
            $uri      = "$BaseUrl/api/v2/members/$($group.ID)/members?limit=$PageSize&page=$page"
            $response = Invoke-OTCSRequest -Uri $uri -Headers $Headers
            if (-not $response) { break }

            $items = if ($response.results) { $response.results }
                     elseif ($response.data) { $response.data }
                     else { $null }

            if (-not $items -or $items.Count -eq 0) { break }

            foreach ($member in $items) {
                $p          = Get-PropValue $member
                $memberType = if ($p.type -eq 1) { "Group" } else { "User" }

                $allMemberships += [PSCustomObject]@{
                    GroupID     = $group.ID
                    GroupName   = $group.Name
                    MemberID    = $p.id
                    MemberName  = $p.name
                    MemberType  = $memberType
                    DisplayName = $p.display_name
                    Email       = $p.business_email
                }
            }

            if ($items.Count -lt $PageSize) { break }
            $page++

        } while ($true)
    }

    Write-Log "Total membership records: $($allMemberships.Count)" "SUCCESS"
    return $allMemberships
}

# -----------------------------------------------------------------------------
# OUTPUT
# -----------------------------------------------------------------------------

function Write-ConsoleReport {
    param([array]$Users, [array]$Groups, [array]$Memberships)

    Write-Host ""
    Write-Host "================================================================" -ForegroundColor Magenta
    Write-Host "  OPENTEXT CONTENT SERVER - USERS & GROUPS REPORT"               -ForegroundColor Magenta
    Write-Host "  Generated: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')"          -ForegroundColor Magenta
    Write-Host "================================================================" -ForegroundColor Magenta

    Write-Host ""
    Write-Host "--- USERS ($($Users.Count) total) ---" -ForegroundColor Yellow
    $Users | Format-Table -AutoSize -Property ID, LoginName, DisplayName, Email, Enabled

    Write-Host ""
    Write-Host "--- GROUPS ($($Groups.Count) total) ---" -ForegroundColor Yellow
    $Groups | Format-Table -AutoSize -Property ID, Name, DisplayName

    Write-Host ""
    Write-Host "--- GROUP MEMBERSHIPS ($($Memberships.Count) total) ---" -ForegroundColor Yellow
    $Memberships | Format-Table -AutoSize -Property GroupName, MemberName, MemberType, DisplayName, Email

    Write-Host "================================================================" -ForegroundColor Magenta
}

function Export-ToCSV {
    param([array]$Users, [array]$Groups, [array]$Memberships, [string]$OutputFolder)

    $ts          = Get-Date -Format "yyyyMMdd_HHmmss"
    $usersFile   = Join-Path $OutputFolder "Users_$ts.csv"
    $groupsFile  = Join-Path $OutputFolder "Groups_$ts.csv"
    $membersFile = Join-Path $OutputFolder "GroupMemberships_$ts.csv"

    $Users       | Export-Csv -Path $usersFile   -NoTypeInformation -Encoding UTF8
    $Groups      | Export-Csv -Path $groupsFile  -NoTypeInformation -Encoding UTF8
    $Memberships | Export-Csv -Path $membersFile -NoTypeInformation -Encoding UTF8

    Write-Log "CSV exports:" "SUCCESS"
    Write-Log "  Users       -> $usersFile"   "SUCCESS"
    Write-Log "  Groups      -> $groupsFile"  "SUCCESS"
    Write-Log "  Memberships -> $membersFile" "SUCCESS"
}

# -----------------------------------------------------------------------------
# MAIN
# -----------------------------------------------------------------------------

Write-Log "========================================" "INFO"
Write-Log " OpenText Content Server 26.1 Export"    "INFO"
Write-Log " Target: $($Config.BaseUrl)"              "INFO"
Write-Log "========================================" "INFO"

Ensure-OutputFolder -Path $Config.OutputFolder

# Step 1 - Authenticate
$ticket = Get-OTCSTicket -Config $Config
if (-not $ticket) {
    Write-Log "Cannot continue without a valid ticket. Check credentials and URL." "ERROR"
    exit 1
}
$headers = @{ "OTCSTicket" = $ticket }

# Step 2 - Users
$users = Get-OTCSUsers -Headers $headers -BaseUrl $Config.BaseUrl -PageSize $Config.PageSize

# Step 3 - Groups
$groups = Get-OTCSGroups -Headers $headers -BaseUrl $Config.BaseUrl -PageSize $Config.PageSize

# Step 4 - Memberships
$memberships = @()
if ($groups.Count -gt 0) {
    $memberships = Get-OTCSGroupMemberships -Headers $headers -BaseUrl $Config.BaseUrl -Groups $groups -PageSize $Config.PageSize
}

# Step 5 - Console report
Write-ConsoleReport -Users $users -Groups $groups -Memberships $memberships

# Step 6 - CSV export
Export-ToCSV -Users $users -Groups $groups -Memberships $memberships -OutputFolder $Config.OutputFolder

Write-Log "Export complete!" "SUCCESS"
