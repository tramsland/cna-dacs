# =============================================================================
# Get-OTCSUsersAndGroups.ps1
# OpenText Content Server 26.1 - Export Users, Groups & Memberships
# PowerShell 5.1 compatible
# =============================================================================

# -----------------------------------------------------------------------------
# CONFIGURATION - Update these values before running
# -----------------------------------------------------------------------------
$Config = @{
    BaseUrl         = "https://yourserver/otcs/cs.exe"   # Base OTCS URL
    Username        = "admin"                              # OTCS username
    SkipSSLCheck    = $false                               # Set $true for self-signed certs
    OutputFolder    = "C:\OTCS_Export"                     # Folder for CSV output
    PageSize        = 100                                  # Results per page (max 100)
}

# -----------------------------------------------------------------------------
# SECURE PASSWORD PROMPT
# -----------------------------------------------------------------------------
$securePassword = Read-Host -Prompt "Enter password for '$($Config.Username)'" -AsSecureString
$credential     = New-Object System.Management.Automation.PSCredential($Config.Username, $securePassword)
$Config.Password = $credential.GetNetworkCredential().Password

# -----------------------------------------------------------------------------
# SSL BYPASS (only activates if SkipSSLCheck = $true)
# -----------------------------------------------------------------------------
if ($Config.SkipSSLCheck) {
    Write-Host "[SSL] Bypassing SSL certificate validation..." -ForegroundColor Yellow
    Add-Type @"
using System.Net;
using System.Security.Cryptography.X509Certificates;
public class TrustAllCerts : ICertificatePolicy {
    public bool CheckValidationResult(
        ServicePoint srvPoint, X509Certificate certificate,
        WebRequest request, int certificateProblem) { return true; }
}
"@
    [System.Net.ServicePointManager]::CertificatePolicy = New-Object TrustAllCerts
    [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.SecurityProtocolType]::Tls12
}

# -----------------------------------------------------------------------------
# HELPER FUNCTIONS
# -----------------------------------------------------------------------------

function Write-Log {
    param([string]$Message, [string]$Level = "INFO")
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $color = switch ($Level) {
        "INFO"    { "Cyan" }
        "SUCCESS" { "Green" }
        "WARN"    { "Yellow" }
        "ERROR"   { "Red" }
        default   { "White" }
    }
    Write-Host "[$timestamp][$Level] $Message" -ForegroundColor $color
}

function Invoke-OTCSRequest {
    param(
        [string]$Uri,
        [string]$Method = "GET",
        [hashtable]$Headers,
        [hashtable]$Body = $null
    )
    try {
        $params = @{
            Uri         = $Uri
            Method      = $Method
            Headers     = $Headers
            ContentType = "application/x-www-form-urlencoded"
            ErrorAction = "Stop"
        }
        if ($Body) { $params.Body = $Body }

        $response = Invoke-RestMethod @params
        return $response
    }
    catch {
        $statusCode = $_.Exception.Response.StatusCode.value__
        Write-Log "API call failed [$statusCode]: $Uri - $($_.Exception.Message)" "ERROR"
        return $null
    }
}

function Get-OTCSTicket {
    param([hashtable]$Config)

    Write-Log "Authenticating to Content Server: $($Config.BaseUrl)" "INFO"

    $authUri  = "$($Config.BaseUrl)/api/v1/auth"
    $authBody = @{
        username = $Config.Username
        password = $Config.Password
    }

    try {
        $response = Invoke-RestMethod -Uri $authUri -Method POST -Body $authBody -ErrorAction Stop
        if ($response.ticket) {
            Write-Log "Authentication successful. Ticket obtained." "SUCCESS"
            return $response.ticket
        }
        else {
            Write-Log "Authentication response received but no ticket found." "ERROR"
            return $null
        }
    }
    catch {
        Write-Log "Authentication failed: $($_.Exception.Message)" "ERROR"
        return $null
    }
}

function Get-AllPages {
    <#
    .SYNOPSIS
        Handles paged API responses, iterating until all records are retrieved.
    #>
    param(
        [string]$BaseUri,
        [hashtable]$Headers,
        [int]$PageSize = 100
    )

    $allResults = @()
    $page = 1

    do {
        $pagedUri = "$BaseUri&limit=$PageSize&page=$page"
        Write-Log "  Fetching page $page from: $pagedUri" "INFO"
        $response = Invoke-OTCSRequest -Uri $pagedUri -Headers $Headers

        if (-not $response) { break }

        # Handle both v1 and v2 response shapes
        if ($response.data) {
            $items = $response.data
        }
        elseif ($response.results) {
            $items = $response.results
        }
        else {
            break
        }

        if ($items.Count -eq 0) { break }

        $allResults += $items
        Write-Log "  Page $page returned $($items.Count) records (total so far: $($allResults.Count))" "INFO"

        # If fewer results than page size, we're done
        if ($items.Count -lt $PageSize) { break }

        $page++

    } while ($true)

    return $allResults
}

function Ensure-OutputFolder {
    param([string]$Path)
    if (-not (Test-Path $Path)) {
        New-Item -ItemType Directory -Path $Path -Force | Out-Null
        Write-Log "Created output folder: $Path" "INFO"
    }
}

# -----------------------------------------------------------------------------
# MAIN DATA RETRIEVAL FUNCTIONS
# -----------------------------------------------------------------------------

function Get-OTCSUsers {
    param([hashtable]$Headers, [string]$BaseUrl, [int]$PageSize)

    Write-Log "Retrieving all users..." "INFO"

    $uri = "$BaseUrl/api/v2/members?where_type=0&$"   # type 0 = users
    # Use search endpoint for users
    $uri = "$BaseUrl/api/v2/members?where_type=0&fields=properties&"

    $allUsers = @()
    $page = 1

    do {
        $pagedUri = "$BaseUrl/api/v2/members?where_type=0&fields=properties&limit=$PageSize&page=$page"
        $response = Invoke-OTCSRequest -Uri $pagedUri -Headers $Headers

        if (-not $response) { break }

        $items = if ($response.results) { $response.results } elseif ($response.data) { $response.data } else { $null }
        if (-not $items -or $items.Count -eq 0) { break }

        foreach ($item in $items) {
            $props = if ($item.data.properties) { $item.data.properties } else { $item }
            $allUsers += [PSCustomObject]@{
                ID           = $props.id
                LoginName    = $props.name
                DisplayName  = $props.display_name
                FirstName    = $props.first_name
                LastName     = $props.last_name
                Email        = $props.business_email
                Department   = $props.group_id
                Type         = "User"
                Enabled      = -not $props.deleted
                CreatedDate  = $props.create_date
                ModifiedDate = $props.modify_date
            }
        }

        Write-Log "  Users page $page : $($items.Count) records" "INFO"
        if ($items.Count -lt $PageSize) { break }
        $page++

    } while ($true)

    Write-Log "Total users retrieved: $($allUsers.Count)" "SUCCESS"
    return $allUsers
}

function Get-OTCSGroups {
    param([hashtable]$Headers, [string]$BaseUrl, [int]$PageSize)

    Write-Log "Retrieving all groups..." "INFO"

    $allGroups = @()
    $page = 1

    do {
        $pagedUri = "$BaseUrl/api/v2/members?where_type=1&fields=properties&limit=$PageSize&page=$page"
        $response = Invoke-OTCSRequest -Uri $pagedUri -Headers $Headers

        if (-not $response) { break }

        $items = if ($response.results) { $response.results } elseif ($response.data) { $response.data } else { $null }
        if (-not $items -or $items.Count -eq 0) { break }

        foreach ($item in $items) {
            $props = if ($item.data.properties) { $item.data.properties } else { $item }
            $allGroups += [PSCustomObject]@{
                ID           = $props.id
                Name         = $props.name
                DisplayName  = $props.display_name
                Type         = "Group"
                CreatedDate  = $props.create_date
                ModifiedDate = $props.modify_date
            }
        }

        Write-Log "  Groups page $page : $($items.Count) records" "INFO"
        if ($items.Count -lt $PageSize) { break }
        $page++

    } while ($true)

    Write-Log "Total groups retrieved: $($allGroups.Count)" "SUCCESS"
    return $allGroups
}

function Get-OTCSGroupMemberships {
    param(
        [hashtable]$Headers,
        [string]$BaseUrl,
        [array]$Groups,
        [int]$PageSize
    )

    Write-Log "Retrieving group memberships for $($Groups.Count) groups..." "INFO"

    $allMemberships = @()

    foreach ($group in $Groups) {
        Write-Log "  Getting members of group: '$($group.Name)' (ID: $($group.ID))" "INFO"

        $page = 1
        do {
            $uri = "$BaseUrl/api/v2/members/$($group.ID)/members?fields=properties&limit=$PageSize&page=$page"
            $response = Invoke-OTCSRequest -Uri $uri -Headers $Headers

            if (-not $response) { break }

            $items = if ($response.results) { $response.results } elseif ($response.data) { $response.data } else { $null }
            if (-not $items -or $items.Count -eq 0) { break }

            foreach ($member in $items) {
                $props = if ($member.data.properties) { $member.data.properties } else { $member }
                $memberType = if ($props.type -eq 1) { "Group" } else { "User" }

                $allMemberships += [PSCustomObject]@{
                    GroupID      = $group.ID
                    GroupName    = $group.Name
                    MemberID     = $props.id
                    MemberName   = $props.name
                    MemberType   = $memberType
                    DisplayName  = $props.display_name
                    Email        = $props.business_email
                }
            }

            if ($items.Count -lt $PageSize) { break }
            $page++

        } while ($true)
    }

    Write-Log "Total membership records retrieved: $($allMemberships.Count)" "SUCCESS"
    return $allMemberships
}

# -----------------------------------------------------------------------------
# OUTPUT FUNCTIONS
# -----------------------------------------------------------------------------

function Write-ConsoleReport {
    param(
        [array]$Users,
        [array]$Groups,
        [array]$Memberships
    )

    Write-Host ""
    Write-Host "================================================================" -ForegroundColor Magenta
    Write-Host "  OPENTEXT CONTENT SERVER - USERS & GROUPS REPORT" -ForegroundColor Magenta
    Write-Host "  Generated: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" -ForegroundColor Magenta
    Write-Host "================================================================" -ForegroundColor Magenta

    Write-Host ""
    Write-Host "--- USERS ($($Users.Count) total) ---" -ForegroundColor Yellow
    $Users | Format-Table -AutoSize -Property ID, LoginName, DisplayName, Email, Enabled

    Write-Host ""
    Write-Host "--- GROUPS ($($Groups.Count) total) ---" -ForegroundColor Yellow
    $Groups | Format-Table -AutoSize -Property ID, Name, DisplayName

    Write-Host ""
    Write-Host "--- GROUP MEMBERSHIPS ($($Memberships.Count) total) ---" -ForegroundColor Yellow
    $Memberships | Format-Table -AutoSize -Property GroupName, MemberName, MemberType, DisplayName, Email

    Write-Host "================================================================" -ForegroundColor Magenta
}

function Export-ToCSV {
    param(
        [array]$Users,
        [array]$Groups,
        [array]$Memberships,
        [string]$OutputFolder
    )

    $timestamp    = Get-Date -Format "yyyyMMdd_HHmmss"
    $usersFile    = Join-Path $OutputFolder "Users_$timestamp.csv"
    $groupsFile   = Join-Path $OutputFolder "Groups_$timestamp.csv"
    $membersFile  = Join-Path $OutputFolder "GroupMemberships_$timestamp.csv"

    $Users       | Export-Csv -Path $usersFile   -NoTypeInformation -Encoding UTF8
    $Groups      | Export-Csv -Path $groupsFile  -NoTypeInformation -Encoding UTF8
    $Memberships | Export-Csv -Path $membersFile -NoTypeInformation -Encoding UTF8

    Write-Log "CSV files exported:" "SUCCESS"
    Write-Log "  Users       -> $usersFile" "SUCCESS"
    Write-Log "  Groups      -> $groupsFile" "SUCCESS"
    Write-Log "  Memberships -> $membersFile" "SUCCESS"
}

# -----------------------------------------------------------------------------
# MAIN EXECUTION
# -----------------------------------------------------------------------------

Write-Log "Starting OpenText Content Server export..." "INFO"
Write-Log "Target: $($Config.BaseUrl)" "INFO"

# Ensure output folder exists
Ensure-OutputFolder -Path $Config.OutputFolder

# Step 1: Authenticate
$ticket = Get-OTCSTicket -Config $Config
if (-not $ticket) {
    Write-Log "Cannot proceed without a valid authentication ticket. Exiting." "ERROR"
    exit 1
}

$headers = @{ "OTCSTicket" = $ticket }

# Step 2: Get all users
$users = Get-OTCSUsers -Headers $headers -BaseUrl $Config.BaseUrl -PageSize $Config.PageSize

# Step 3: Get all groups
$groups = Get-OTCSGroups -Headers $headers -BaseUrl $Config.BaseUrl -PageSize $Config.PageSize

# Step 4: Get group memberships
$memberships = @()
if ($groups.Count -gt 0) {
    $memberships = Get-OTCSGroupMemberships -Headers $headers -BaseUrl $Config.BaseUrl -Groups $groups -PageSize $Config.PageSize
}

# Step 5: Output to console
Write-ConsoleReport -Users $users -Groups $groups -Memberships $memberships

# Step 6: Export to CSV
Export-ToCSV -Users $users -Groups $groups -Memberships $memberships -OutputFolder $Config.OutputFolder

Write-Log "Export complete!" "SUCCESS"
