<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <handlers>
            <clear />
            <add name="ReadyDocs-Proxy" path="/demo/readydocs/*" verb="*"
                 type="System.Web.Handlers.TransferRequestHandler"
                 preCondition="integratedMode,runtimeVersionv4.0"/>
            <add name="BonCode-Tomcat-WC-Handler" path="*" verb="*"
                 type="BonCodeIIS.BonCodeCallHandler"
                 modules="ManagedPipelineHandler"
                 scriptProcessor=""
                 resourceType="Unspecified"
                 requireAccess="Script"
                 allowPathInfo="false"
                 preCondition="integratedMode"
                 responseBufferLimit="4194304" />
        </handlers>
        <httpProtocol>
            <customHeaders>
                <remove name="Strict-Transport-Security" />
                <remove name="X-Powered-By" />
                <add name="Strict-Transport-Security" value="max-age=31536000" />
            </customHeaders>
        </httpProtocol>
        <security>
            <requestFiltering allowDoubleEscaping="true">
                <requestLimits maxAllowedContentLength="2147483648" maxUrl="8192" maxQueryString="4096" />
                <verbs allowUnlisted="false" />
            </requestFiltering>
        </security>
        <urlCompression doStaticCompression="false" doDynamicCompression="false" />
        <caching enabled="false" enableKernelCache="true" />
        <staticContent>
            <clientCache cacheControlMode="DisableCache" />
        </staticContent>
        <rewrite>
            <outboundRules>
                <remove name="SSL Coockies" />
                <rule name="SSL Coockies" preCondition="Not SSL Cookie" enabled="true">
                    <match serverVariable="RESPONSE_Set_Cookie" pattern=".*" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="true" />
                    <action type="Rewrite" value="{R:0} ;secure" />
                </rule>
                <preConditions>
                    <preCondition name="Not SSL Cookie">
                        <add input="{RESPONSE_Set_Cookie}" pattern="." />
                        <add input="{RESPONSE_Set_Cookie}" pattern=";secure" negate="true" />
                    </preCondition>
                </preConditions>
            </outboundRules>
            <rules>
                <clear />
                <rule name="Reroute Readydocs" stopProcessing="true">
                    <match url="^demo/readydocs/(.*)" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Rewrite"
                            url="http://AZASVWSR046.public.dla.mil:13200/readydocs/{R:1}" />
                </rule>
                <rule name="Block All HTTP 1.0 Calls" enabled="false" stopProcessing="true">
                    <match url="*" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
                        <add input="{SERVER_PROTOCOL}" pattern="HTTP/1.0" />
                    </conditions>
                    <action type="AbortRequest" />
                </rule>
                <rule name="Root Hit Redirect" stopProcessing="true">
                    <match url="^$" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Redirect" url="/portal/" />
                </rule>
                <rule name="Blocking UpDirectory URLS" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions logicalGrouping="MatchAny" trackAllCaptures="false">
                        <add input="{UNENCODED_URL}" pattern="\.\." />
                    </conditions>
                    <action type="CustomResponse" statusCode="403"
                            statusReason="Forbidden: Access is denied. We dont allow .. in URL paths"
                            statusDescription="You do not have permission to view this directory or page using the credentials that you supplied. Please try again" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
    <system.web>
        <customErrors mode="Off" />
        <httpRuntime requestValidationMode="2.0" maxUrlLength="8192"
                     requestPathInvalidCharacters="" executionTimeout="7200"
                     maxRequestLength="2147483647" />
        <sessionState timeout="40" />
    </system.web>
</configuration>
