#Requires -Version 5.1
<#
.SYNOPSIS
    Remotely deploys a new Apache Tomcat version to one or more Windows servers
    via WinRM, with pre-flight validation, backup, rollback, and optional
    per-server pause for staged cluster rollouts.

.DESCRIPTION
    Compatible with Windows PowerShell 5.1. Run as Administrator.

    WORKFLOW
    --------
    Phase 1 - Pre-flight (serial):
        - Detects target version by running NewVersion\bin\version.bat locally
        - Renames protected config files in NewVersion\conf to *.new
        - Pings each server and tests WinRM connectivity
        - Enumerates Tomcat services and install directories
        - Skips servers already on the target version
        - Prompts operator to continue if warnings or errors are found

    Phase 2 - Deployment (serial with optional -Cluster pause):
        - Stops the Tomcat service
        - Compresses the existing install directory to a .zip backup
        - Stages new version files to a temp directory
        - Merges staged files into the install directory
        - Starts the service and verifies the deployed version
        - With -Cluster: pauses between each server with Continue/Rollback/Quit

    Phase 3 - Rollback (interactive):
        - For each failed deployment, offers:
            [1] Roll back this server only
            [2] Roll back this and all remaining failures automatically
            [3] Skip rollback for this server

    servers.txt format:
        - One FQDN or hostname per line
        - Lines starting with # are comments and are skipped
        - Zone heading lines such as [ZONE-A] are skipped automatically

.PARAMETER NewVersionPath
    Path to the folder containing the new Tomcat build to deploy.
    Must contain bin\, lib\, and conf\ subdirectories.
    Defaults to a NewVersion subfolder in the same directory as this script.

.PARAMETER ServersFile
    Path to a text file listing target servers, one per line.
    Defaults to servers.txt in the same directory as this script.

.PARAMETER Cluster
    Switch. When present, inserts an interactive pause after each server is
    updated. Operator can press ENTER to continue, R to roll back all
    completed servers and exit, or Q to quit without rollback.

.PARAMETER Credential
    PSCredential used for WinRM connections to remote servers.

.EXAMPLE
    # Deploy to all servers in servers.txt
    .\Invoke-TomcatUpgrade.ps1

.EXAMPLE
    # Deploy with a per-server pause between each node
    .\Invoke-TomcatUpgrade.ps1 -Cluster

.EXAMPLE
    # Deploy with explicit credentials
    $cred = Get-Credential
    .\Invoke-TomcatUpgrade.ps1 -Credential $cred
#>

#region Parameters
param(
    [string]$NewVersionPath = (Join-Path $PSScriptRoot "NewVersion"),
    [string]$ServersFile    = (Join-Path $PSScriptRoot "servers.txt"),
    [switch]$Cluster,
    [System.Management.Automation.PSCredential]$Credential
)
#endregion Parameters

# Candidate install directories when service registry path is unavailable
$ServiceMapCandidates = @(
    "E:\Customers\dacs\shared\tomcat10",
    "E:\Customers\dacs\shared\tomcat9",
    "E:\Customers\dacs\shared\tomcat85",
    "E:\Customers\dacs\shared\tomcat"
)

#region Helper functions

function Write-Status {
    param(
        [string]$Msg,
        [string]$Color = "White"
    )
    $ts = Get-Date -Format "HH:mm:ss"
    Write-Host ("[$ts] $Msg") -ForegroundColor $Color
}

function Write-Log {
    param(
        [string]$Msg,
        [string]$Level  = "INFO",
        [string]$Server = ""
    )
    $ts     = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $prefix = if ($Server) { "[$Server] " } else { "" }
    $line   = "[$ts] [$Level] $prefix$Msg"
    $color  = switch ($Level) {
        "ERROR" { "Red"    }
        "WARN"  { "Yellow" }
        "OK"    { "Green"  }
        default { "Cyan"   }
    }
    Write-Host $line -ForegroundColor $color
    Add-Content -Path $script:LogFile -Value $line -ErrorAction SilentlyContinue
}

# Fallback-safe single-key prompt.
# Returns one uppercase char: "C"/"N" (continue/Enter), "R" (rollback all), "Q" (quit).
# Works in interactive consoles, VS Code, SSH sessions, and WinRM.
# NOTE: $input is a reserved automatic variable in PS 5.1 -- never use it here.
function Read-OperatorChoice {
    try {
        if ($null -ne $Host.UI.RawUI -and $Host.Name -ne 'ServerRemoteHost') {
            $key = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
            return $key.Character.ToString().ToUpper()
        }
    }
    catch {
        # RawUI not available in this host -- fall through to Read-Host
    }
    $rawInput = (Read-Host "  Enter choice (ENTER=Continue, R=Rollback all, Q=Quit)").Trim().ToUpper()
    if ([string]::IsNullOrEmpty($rawInput)) { return "C" }
    return $rawInput.Substring(0, 1)
}

# Show a per-server pause banner when -Cluster is specified.
# Returns: "C" (continue), "R" (rollback all), or "Q" (quit)
function Invoke-ServerPause {
    param(
        [string]$CompletedServer,
        [string]$NextServer,
        [int]   $ServerNum,
        [int]   $TotalServers
    )

    $nextLabel = if ($NextServer) { $NextServer } else { "(last server)" }

    Write-Host ""
    Write-Host "+-----------------------------------------------------+" -ForegroundColor Yellow
    Write-Host ("| CLUSTER PAUSE -- server $ServerNum of $TotalServers complete").PadRight(53) + "|" -ForegroundColor Yellow
    Write-Host ("| Done : $CompletedServer").PadRight(53) + "|" -ForegroundColor Yellow
    Write-Host ("| Next : $nextLabel").PadRight(53) + "|" -ForegroundColor Yellow
    Write-Host "+-----------------------------------------------------+" -ForegroundColor Yellow
    Write-Host "|  [ENTER] Continue   [R] Rollback all   [Q] Quit    |" -ForegroundColor Yellow
    Write-Host "+-----------------------------------------------------+" -ForegroundColor Yellow
    Write-Host ""

    return Read-OperatorChoice
}

# Open a PSSession for the given computer.
# Sets $script:isLocal and $script:session.
# Returns $true on success, $false on failure.
function Open-TargetSession {
    param([string]$ComputerName)

    $localNames = @(
        "localhost",
        "127.0.0.1",
        "::1",
        $env:COMPUTERNAME,
        "$($env:COMPUTERNAME).$($env:USERDNSDOMAIN)"
    )
    $script:isLocal = $localNames -contains $ComputerName
    $script:session = $null

    if ($script:isLocal) {
        Write-Status "  Running locally (no PSSession needed)." -Color Gray
        return $true
    }

    try {
        $script:session = New-PSSession -ComputerName $ComputerName @sessionParams
        return $true
    }
    catch {
        Write-Status "  ERROR: Could not open PSSession to $ComputerName -- $_" -Color Red
        return $false
    }
}

# Close and null the current PSSession.
function Close-TargetSession {
    if ($script:session) {
        Remove-PSSession $script:session -ErrorAction SilentlyContinue
        $script:session = $null
    }
}

# Dispatch a scriptblock locally or into the current PSSession.
function Invoke-Targeted {
    param(
        [scriptblock]$ScriptBlock,
        [object[]]$ArgumentList
    )
    if ($script:isLocal) {
        return Invoke-Command -ScriptBlock $ScriptBlock -ArgumentList $ArgumentList
    }
    else {
        return Invoke-Command -Session $script:session -ScriptBlock $ScriptBlock -ArgumentList $ArgumentList
    }
}

#endregion Helper functions

#region Admin check

$currentPrincipal = [Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()
if (-not $currentPrincipal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Host "[ERROR] This script must be run as Administrator." -ForegroundColor Red
    exit 1
}

#endregion Admin check

#region Initialise log file

$script:LogFile = Join-Path $PSScriptRoot ("TomcatUpgrade_" + (Get-Date -Format "yyyyMMdd_HHmmss") + ".log")
Write-Log "Log file: $($script:LogFile)"

#endregion Initialise log file

#region WinRM session params

$sessionParams = @{ ErrorAction = "Stop" }
if ($Credential) { $sessionParams["Credential"] = $Credential }

#endregion WinRM session params

#region Validate inputs

if (-not (Test-Path $ServersFile)) {
    Write-Log "Servers file not found: $ServersFile" "ERROR"
    exit 1
}
if (-not (Test-Path $NewVersionPath)) {
    Write-Log "NewVersionPath not found: $NewVersionPath" "ERROR"
    exit 1
}

# Parse servers.txt -- skip blank lines, # comments, and [ZONE-X] headings
$servers = @(
    Get-Content $ServersFile |
    Where-Object { ($_ -notmatch '^\s*$') -and ($_ -notmatch '^\s*#') } |
    Where-Object { $_ -notmatch '^\s*\[.*\]\s*$' } |
    ForEach-Object { $_.Trim() } |
    Where-Object { $_ -ne '' }
)

if ($servers.Count -eq 0) {
    Write-Log "No servers found in $ServersFile" "ERROR"
    exit 1
}

Write-Log "=== Tomcat Upgrade ===" "INFO"
Write-Log "Servers     : $($servers.Count)" "INFO"
Write-Log "Source      : $NewVersionPath" "INFO"
Write-Log "Cluster mode: $(if ($Cluster) { 'ON' } else { 'OFF' })" "INFO"
Write-Log ""

#endregion Validate inputs

# =============================================================================
# SCRIPTBLOCK: Enumerate Tomcat services and resolve install directories.
# PS 5.1 REMOTING NOTE: passed as [string] and reconstructed with ::Create().
# =============================================================================

$enumSvcsDef = {
    param(
        [string[]]$Candidates
    )

    $svcs = @(Get-Service -Name "*Tomcat*" -ErrorAction SilentlyContinue)
    if ($svcs.Count -eq 0) {
        $svcs = @(Get-Service -DisplayName "*Apache Tomcat*" -ErrorAction SilentlyContinue)
    }

    $results  = New-Object 'System.Collections.Generic.List[System.Management.Automation.PSObject]'
    $seenDirs = New-Object 'System.Collections.Generic.HashSet[string]' (
        [System.StringComparer]::OrdinalIgnoreCase
    )

    foreach ($svc in $svcs) {
        $installDir  = $null
        $regPath     = "HKLM:\SYSTEM\CurrentControlSet\Services\$($svc.Name)"
        $props       = Get-ItemProperty -Path $regPath -ErrorAction SilentlyContinue
        $imagePath   = $props.ImagePath
        $description = $props.Description

        # Method 1: derive install dir from service ImagePath
        if ($imagePath) {
            $exePath    = $imagePath.Trim('"').Split(" ")[0]
            $tomcatRoot = Split-Path (Split-Path $exePath -Parent) -Parent
            if ((Test-Path (Join-Path $tomcatRoot "bin")) -and
                (Test-Path (Join-Path $tomcatRoot "lib"))) {
                $installDir = $tomcatRoot
            }
        }

        # Method 2: candidate path fallback
        if (-not $installDir) {
            foreach ($c in $Candidates) {
                if ((Test-Path (Join-Path $c "bin")) -and
                    (Test-Path (Join-Path $c "lib"))) {
                    $installDir = $c
                    break
                }
            }
        }

        if (-not $installDir) { continue }

        $normalizedDir = $installDir.TrimEnd("\").ToLower()
        if ($seenDirs.Contains($normalizedDir)) { continue }
        $null = $seenDirs.Add($normalizedDir)

        # Read installed version by running bin\version.bat on the target
        # version.bat outputs "Server version: Apache Tomcat/X.Y.Z"
        $installedVersion = $null
        $versionBat = Join-Path $installDir "bin\version.bat"
        if (Test-Path $versionBat) {
            try {
                $savedCH = $env:CATALINA_HOME
                $env:CATALINA_HOME = $installDir
                $verOutput = & cmd.exe /c `"$versionBat`" 2>&1
                $env:CATALINA_HOME = $savedCH

                $verLine = $verOutput |
                    Where-Object { $_ -match "Server version" } |
                    Select-Object -First 1
                if ($verLine) {
                    $m = [regex]::Match($verLine, "(\d+\.\d+\.\d+)")
                    if ($m.Success) { $installedVersion = $m.Groups[1].Value }
                }
            }
            catch { }
        }

        # Extract version from Description field as secondary reference
        $descVersion = $null
        if ($description) {
            $dm = [regex]::Match($description, "(\d+\.\d+\.\d+)")
            if ($dm.Success) { $descVersion = $dm.Groups[1].Value }
        }

        $results.Add([PSCustomObject]@{
            Name             = $svc.Name
            DisplayName      = $svc.DisplayName
            Description      = $description
            DescVersion      = $descVersion
            Status           = $svc.Status.ToString()
            InstallDir       = $installDir
            NormalizedDir    = $normalizedDir
            InstalledVersion = $installedVersion
        })
    }

    return $results
}

$enumSvcsStr = $enumSvcsDef.ToString()

# =============================================================================
# PHASE 1 -- PRE-FLIGHT
# =============================================================================

Write-Log "========== Phase 1: Pre-flight ==========" "INFO"

# ---- Detect target version by running NewVersion\bin\version.bat locally ---
# version.bat outputs a block that includes "Server version: Apache Tomcat/X.Y.Z"
$newVersion = $null
$targetVersionBat = Join-Path $NewVersionPath "bin\version.bat"

if (Test-Path $targetVersionBat) {
    Write-Log "Running version.bat from NewVersion to detect target version..." "INFO"
    try {
        # Set CATALINA_HOME so version.bat resolves correctly
        $env:CATALINA_HOME = $NewVersionPath
        $verOutput = & cmd.exe /c `"$targetVersionBat`" 2>&1
        $env:CATALINA_HOME = $null

        $verLine = $verOutput |
            Where-Object { $_ -match "Server version" } |
            Select-Object -First 1

        if ($verLine) {
            $m = [regex]::Match($verLine, "(\d+\.\d+\.\d+)")
            if ($m.Success) {
                $newVersion = $m.Groups[1].Value
                Write-Log "Target version: $newVersion (from version.bat)" "OK"
            }
        }

        if (-not $newVersion) {
            Write-Log "version.bat ran but version string not found in output." "WARN"
            Write-Log "version.bat output: $($verOutput -join '; ')" "WARN"
        }
    }
    catch {
        Write-Log "version.bat execution failed: $_" "WARN"
    }
}
else {
    Write-Log "version.bat not found at $targetVersionBat -- cannot determine target version." "ERROR"
    exit 1
}

if (-not $newVersion) {
    Write-Log "Could not determine target Tomcat version from version.bat. Aborting." "ERROR"
    exit 1
}

Write-Log "Target deployment version: $newVersion" "INFO"

# ---- Rename protected config files in NewVersion\conf -----------------------
$confPath = Join-Path $NewVersionPath "conf"
if (-not (Test-Path $confPath)) {
    Write-Log "NewVersion\conf not found -- protected file rename skipped." "WARN"
}
else {
    $protectedFiles = @("web.xml", "server.xml", "tomcat-users.xml", "tomcat-users.xsd")
    $renamed = 0
    foreach ($file in $protectedFiles) {
        $filePath = Join-Path $confPath $file
        if (Test-Path $filePath) {
            try {
                Rename-Item -Path $filePath -NewName ($file + ".new") -ErrorAction Stop
                Write-Log "Renamed '$file' -> '$file.new' in NewVersion\conf." "WARN"
                $renamed++
            }
            catch {
                Write-Log "Failed to rename '$file' in NewVersion\conf: $_" "ERROR"
            }
        }
    }
    if ($renamed -eq 0) {
        Write-Log "NewVersion\conf -- no protected config files found (OK)." "OK"
    }
}

# ---- Per-server connectivity and service checks -----------------------------
$pfPass = 0
$pfWarn = 0
$pfFail = 0

# deployTargets: list of PSCustomObject { Server; SvcName; InstallDir; NormalizedDir; InstalledVersion }
$deployTargets = New-Object 'System.Collections.Generic.List[System.Management.Automation.PSObject]'
# Track unique server::dir keys to avoid duplicates
$seenKeys = New-Object 'System.Collections.Generic.HashSet[string]' (
    [System.StringComparer]::OrdinalIgnoreCase
)

foreach ($ComputerName in $servers) {

    Write-Log "--- $ComputerName ---" "INFO"

    # Ping check (skip for localhost)
    $opened = Open-TargetSession -ComputerName $ComputerName
    if (-not $opened) {
        Write-Log "Cannot open session to $ComputerName -- skipping." "ERROR" $ComputerName
        $pfFail++
        continue
    }

    # Enumerate services
    $svcList = $null
    try {
        $enumFn  = [scriptblock]::Create($enumSvcsStr)
        $svcList = Invoke-Targeted -ScriptBlock $enumFn -ArgumentList @(,$ServiceMapCandidates)
    }
    catch {
        Write-Log "Could not enumerate services: $_" "WARN" $ComputerName
        $pfWarn++
        Close-TargetSession
        continue
    }

    Close-TargetSession

    if (-not $svcList -or $svcList.Count -eq 0) {
        Write-Log "No Tomcat services detected -- server will be skipped." "WARN" $ComputerName
        $pfWarn++
        continue
    }

    Write-Log "Found $($svcList.Count) Tomcat service(s)." "OK" $ComputerName

    foreach ($entry in $svcList) {
        $key = ($ComputerName + "::" + $entry.NormalizedDir).ToLower()

        if ($seenKeys.Contains($key)) {
            Write-Log "Duplicate install dir $($entry.InstallDir) -- skipping." "WARN" $ComputerName
            $pfWarn++
            continue
        }

        # Service running check
        if ($entry.Status -ne "Running") {
            Write-Log "Service $($entry.Name) is NOT Running (Status: $($entry.Status))." "WARN" $ComputerName
            $pfWarn++
        }
        else {
            Write-Log "Service $($entry.Name) is Running." "OK" $ComputerName
            $pfPass++
        }

        # Version comparison -- skip if already on target
        if ($newVersion -and $entry.InstalledVersion -and ($entry.InstalledVersion -eq $newVersion)) {
            Write-Log "Already on version $newVersion at $($entry.InstallDir) -- skipping." "WARN" $ComputerName
            $pfWarn++
            continue
        }

        if ($newVersion -and $entry.InstalledVersion) {
            Write-Log "Will upgrade $($entry.InstallDir) : $($entry.InstalledVersion) -> $newVersion" "OK" $ComputerName
        }
        elseif ($newVersion -and -not $entry.InstalledVersion) {
            Write-Log "Could not detect installed version at $($entry.InstallDir) -- will deploy anyway." "WARN" $ComputerName
            $pfWarn++
        }

        $null = $seenKeys.Add($key)
        $deployTargets.Add([PSCustomObject]@{
            Server           = $ComputerName
            SvcName          = $entry.Name
            InstallDir       = $entry.InstallDir
            NormalizedDir    = $entry.NormalizedDir
            InstalledVersion = $entry.InstalledVersion
        })
        $pfPass++
    }
}

Write-Log "Pre-flight complete -- Pass: $pfPass  Warn: $pfWarn  Fail: $pfFail" "INFO"

# ---- Operator prompt if issues detected -------------------------------------
if ($pfFail -gt 0 -or $pfWarn -gt 0) {
    $issueLines = @(Get-Content $script:LogFile |
        Where-Object { $_ -match "\[(ERROR|WARN)\]" })

    Write-Host ""
    Write-Host "  +============================================================+" -ForegroundColor Yellow
    Write-Host "  | Pre-flight issues:                                         |" -ForegroundColor Yellow
    Write-Host "  +============================================================+" -ForegroundColor Yellow
    foreach ($line in $issueLines) {
        $c = if ($line -match "\[ERROR\]") { "Red" } else { "Yellow" }
        Write-Host "  $line" -ForegroundColor $c
    }
    Write-Host "  +============================================================+" -ForegroundColor Yellow
    Write-Host ""

    if ($pfFail -gt 0) {
        Write-Host "  $pfFail ERROR(s) and $pfWarn WARNING(s) found." -ForegroundColor Red
        Write-Host "  Errors may cause deployment failures or data loss." -ForegroundColor Red
        Write-Host ""
        $ans = Read-Host "  Continue deployment despite errors? (y/N)"
        if ($ans.Trim() -notmatch "^[Yy]$") {
            Write-Log "Deployment aborted by operator." "WARN"
            exit 1
        }
        Write-Log "Operator chose to continue despite $pfFail error(s)." "WARN"
    }
    else {
        Write-Host "  $pfWarn WARNING(s) found." -ForegroundColor Yellow
        Write-Host ""
        $ans = Read-Host "  Continue deployment? (y/N)"
        if ($ans.Trim() -notmatch "^[Yy]$") {
            Write-Log "Deployment aborted by operator." "WARN"
            exit 1
        }
        Write-Log "Operator chose to continue with $pfWarn warning(s)." "WARN"
    }
}
else {
    Write-Log "All pre-flight checks passed." "OK"
}

if ($deployTargets.Count -eq 0) {
    Write-Log "No servers require deployment. Exiting." "OK"
    exit 0
}

Write-Log "========== Phase 1 complete ==========" "OK"

# =============================================================================
# DEPLOY SCRIPTBLOCK
# Runs on the target server (locally or via PSSession).
# Receives all parameters as primitive types -- no scriptblock objects.
# Returns a PSCustomObject result.
# =============================================================================

$deployScript = {
    param(
        [string]  $SvcName,
        [string]  $InstallDir,
        [string]  $NewVersionStagedPath,   # Path already staged on the target (see below)
        [string]  $BackupRoot,             # Parent dir for the .zip backup
        [string]  $NewVersion              # Expected version string (may be empty)
    )

    $log = New-Object 'System.Collections.Generic.List[string]'
    function Write-Log {
        param([string]$m)
        $log.Add($m)
        Write-Host $m
    }

    $result = [PSCustomObject]@{
        Success          = $false
        BackupPath       = $null
        DeployedVersion  = $null
        Log              = $log
        Error            = $null
    }

    # ---- Stop service -------------------------------------------------------
    Write-Log "Stopping service: $SvcName"
    try {
        Stop-Service -Name $SvcName -Force -ErrorAction Stop
        $timeout = 60
        $elapsed = 0
        while ($elapsed -lt $timeout) {
            $st = (Get-Service -Name $SvcName -ErrorAction SilentlyContinue).Status
            if ($st -eq "Stopped") { break }
            Start-Sleep -Seconds 2
            $elapsed += 2
        }
        $finalStatus = (Get-Service -Name $SvcName -ErrorAction SilentlyContinue).Status
        if ($finalStatus -ne "Stopped") {
            throw "Service did not stop within $timeout seconds. Status: $finalStatus"
        }
        Write-Log "Service stopped."
    }
    catch {
        $result.Error = "Stop failed: $_"
        return $result
    }

    # ---- Backup -------------------------------------------------------------
    $timestamp         = Get-Date -Format "yyyyMMdd_HHmmss"
    $backupPath        = Join-Path $BackupRoot ($SvcName + "_backup_" + $timestamp + ".zip")
    $result.BackupPath = $backupPath

    Write-Log "Backing up $InstallDir to $backupPath ..."
    try {
        if (-not (Test-Path $InstallDir)) { throw "Install directory not found: $InstallDir" }
        Compress-Archive -Path (Join-Path $InstallDir "*") -DestinationPath $backupPath -Force
        Write-Log "Backup created: $backupPath"
    }
    catch {
        $result.Error = "Backup failed: $_"
        # Attempt to restart before returning so service is not left stopped
        Start-Service -Name $SvcName -ErrorAction SilentlyContinue
        return $result
    }

    # ---- Merge new version --------------------------------------------------
    Write-Log "Merging new version from $NewVersionStagedPath into $InstallDir ..."
    try {
        if (-not (Test-Path $NewVersionStagedPath)) {
            throw "Staged path not found: $NewVersionStagedPath"
        }
        Copy-Item -Path (Join-Path $NewVersionStagedPath "*") `
                  -Destination $InstallDir -Recurse -Force
        Write-Log "Merge complete."
    }
    catch {
        $result.Error = "Merge failed: $_"
        Write-Log "ERROR: $($result.Error) -- attempting service restart before returning."
        Start-Service -Name $SvcName -ErrorAction SilentlyContinue
        return $result
    }

    # ---- Start service ------------------------------------------------------
    Write-Log "Starting service: $SvcName"
    try {
        Start-Service -Name $SvcName -ErrorAction Stop
        $timeout = 60
        $elapsed = 0
        while ($elapsed -lt $timeout) {
            $st = (Get-Service -Name $SvcName -ErrorAction SilentlyContinue).Status
            if ($st -eq "Running") { break }
            Start-Sleep -Seconds 2
            $elapsed += 2
        }
        $finalStatus = (Get-Service -Name $SvcName -ErrorAction SilentlyContinue).Status
        if ($finalStatus -ne "Running") {
            throw "Service did not reach Running state within $timeout seconds. Status: $finalStatus"
        }
        Write-Log "Service running."
    }
    catch {
        $result.Error = "Start failed: $_"
        return $result
    }

    # ---- Post-deployment: verify deployed version via version.bat -----------
    $versionBat = Join-Path $InstallDir "bin\version.bat"
    if (Test-Path $versionBat) {
        try {
            $savedCH = $env:CATALINA_HOME
            $env:CATALINA_HOME = $InstallDir
            $verOutput = & cmd.exe /c `"$versionBat`" 2>&1
            $env:CATALINA_HOME = $savedCH

            $verLine = $verOutput |
                Where-Object { $_ -match "Server version" } |
                Select-Object -First 1
            if ($verLine) {
                $m = [regex]::Match($verLine, "(\d+\.\d+\.\d+)")
                if ($m.Success) { $result.DeployedVersion = $m.Groups[1].Value }
            }
        }
        catch {
            Write-Log "WARNING: version.bat check after deploy failed: $_"
        }
    }
    else {
        Write-Log "WARNING: version.bat not found at $versionBat -- post-deploy version check skipped."
    }

    if ($NewVersion -and $result.DeployedVersion) {
        if ($result.DeployedVersion -eq $NewVersion) {
            Write-Log "Deployed jar version confirmed: $($result.DeployedVersion)"
        }
        else {
            Write-Log "WARNING: jar version $($result.DeployedVersion) does not match expected $NewVersion."
        }
    }

    # ---- Update service description in registry -----------------------------
    if ($NewVersion) {
        $shortVer      = ($NewVersion -split "\.")[0..1] -join "."
        $canonicalDesc = "Apache Tomcat $shortVer Server - https://tomcat.apache.org/"
        try {
            $regPath = "HKLM:\SYSTEM\CurrentControlSet\Services\$SvcName"
            Set-ItemProperty -Path $regPath -Name "Description" -Value $canonicalDesc -ErrorAction Stop
            Write-Log "Service description updated to: $canonicalDesc"
        }
        catch {
            Write-Log "WARNING: could not update service description: $_"
        }
    }

    $result.Success = $true
    return $result
}

# =============================================================================
# ROLLBACK SCRIPTBLOCK
# =============================================================================

$rollbackScript = {
    param(
        [string]$SvcName,
        [string]$InstallDir,
        [string]$BackupPath
    )

    $log = New-Object 'System.Collections.Generic.List[string]'
    function Write-Log {
        param([string]$m)
        $log.Add($m)
        Write-Host $m
    }

    $result = [PSCustomObject]@{
        Success = $false
        Log     = $log
        Error   = $null
    }

    # Stop service
    $svcObj = Get-Service -Name $SvcName -ErrorAction SilentlyContinue
    if ($svcObj -and $svcObj.Status -ne "Stopped") {
        Write-Log "Stopping $SvcName for rollback..."
        Stop-Service -Name $SvcName -Force -ErrorAction SilentlyContinue
        $timeout = 60; $elapsed = 0
        while ($elapsed -lt $timeout) {
            if ((Get-Service -Name $SvcName -ErrorAction SilentlyContinue).Status -eq "Stopped") { break }
            Start-Sleep -Seconds 2; $elapsed += 2
        }
    }

    # Validate backup
    if (-not $BackupPath -or -not (Test-Path $BackupPath)) {
        $result.Error = "Backup archive not found at '$BackupPath' -- manual restore required."
        return $result
    }

    # Clear install dir and restore from backup
    Write-Log "Restoring $InstallDir from $BackupPath ..."
    try {
        if (Test-Path $InstallDir) {
            Remove-Item (Join-Path $InstallDir "*") -Recurse -Force -ErrorAction Stop
        }
        Expand-Archive -Path $BackupPath -DestinationPath $InstallDir -Force
        Write-Log "Restore complete."
    }
    catch {
        $result.Error = "Restore failed: $_"
        return $result
    }

    # Restart service
    Write-Log "Starting $SvcName after rollback..."
    try {
        Start-Service -Name $SvcName -ErrorAction Stop
        $timeout = 60; $elapsed = 0
        while ($elapsed -lt $timeout) {
            if ((Get-Service -Name $SvcName -ErrorAction SilentlyContinue).Status -eq "Running") { break }
            Start-Sleep -Seconds 2; $elapsed += 2
        }
        $finalStatus = (Get-Service -Name $SvcName -ErrorAction SilentlyContinue).Status
        if ($finalStatus -ne "Running") {
            throw "Service did not reach Running state within $timeout seconds. Status: $finalStatus"
        }
        Write-Log "$SvcName is running after rollback."
    }
    catch {
        $result.Error = "Rollback start failed: $_"
        return $result
    }

    $result.Success = $true
    return $result
}

# =============================================================================
# PHASE 2 -- DEPLOYMENT (serial)
# New version files are copied to the remote server's TEMP first, then the
# deploy scriptblock runs on the remote side using only that staged path.
# This avoids passing large Base64 blobs and keeps remoting transport lean.
# =============================================================================

Write-Log "========== Phase 2: Deployment ($($deployTargets.Count) target(s)) ==========" "INFO"

# Accumulates results for Phase 3 rollback and final summary
$deployResults = New-Object 'System.Collections.Generic.List[System.Management.Automation.PSObject]'

$script:quitRequested    = $false
$script:rollbackAllReq   = $false

for ($di = 0; $di -lt $deployTargets.Count; $di++) {

    if ($script:quitRequested) { break }

    $target       = $deployTargets[$di]
    $ComputerName = $target.Server
    $svcName      = $target.SvcName
    $installDir   = $target.InstallDir

    Write-Log "---------------------------------------------" "INFO"
    Write-Log "Server $($di + 1)/$($deployTargets.Count) : $ComputerName  Service: $svcName" "INFO"

    $deployRecord = [PSCustomObject]@{
        Server        = $ComputerName
        SvcName       = $svcName
        InstallDir    = $installDir
        Success       = $false
        NeedsRollback = $false
        BackupPath    = $null
        Error         = $null
    }

    $opened = Open-TargetSession -ComputerName $ComputerName
    if (-not $opened) {
        $deployRecord.Error = "Could not open PSSession"
        $deployResults.Add($deployRecord)
        continue
    }

    # ---- Stage new version files to remote TEMP -----------------------------
    $timestamp     = Get-Date -Format "yyyyMMdd_HHmmss"
    $remoteTmpName = "TomcatUpgrade_" + $timestamp
    $remoteTmpPath = $null

    try {
        # Resolve TEMP path on the target
        $remoteTmpPath = Invoke-Targeted -ScriptBlock {
            param([string]$Name)
            $tmp = Join-Path $env:TEMP $Name
            if (Test-Path $tmp) { Remove-Item $tmp -Recurse -Force }
            New-Item -ItemType Directory -Path $tmp -Force | Out-Null
            return $tmp
        } -ArgumentList @($remoteTmpName)

        # Copy new version files to the remote temp
        if ($script:isLocal) {
            Copy-Item -Path (Join-Path $NewVersionPath "*") `
                      -Destination $remoteTmpPath -Recurse -Force
        }
        else {
            Copy-Item -Path (Join-Path $NewVersionPath "*") `
                      -Destination $remoteTmpPath `
                      -ToSession $script:session -Recurse -Force
        }
        Write-Log "New version staged to $remoteTmpPath on $ComputerName." "OK" $ComputerName
    }
    catch {
        Write-Log "Failed to stage files to $ComputerName : $_" "ERROR" $ComputerName
        $deployRecord.Error = "Staging failed: $_"
        $deployResults.Add($deployRecord)
        Close-TargetSession
        continue
    }

    # ---- Run deploy scriptblock on target -----------------------------------
    # BackupRoot is the parent of InstallDir -- keeps the backup alongside the install
    $backupRoot = Split-Path $installDir -Parent

    $result = Invoke-Targeted -ScriptBlock $deployScript -ArgumentList @(
        $svcName,
        $installDir,
        $remoteTmpPath,
        $backupRoot,
        $(if ($newVersion) { $newVersion } else { "" })
    )

    # Capture backup path for potential rollback
    $deployRecord.BackupPath = $result.BackupPath

    # Clean up remote temp regardless of outcome
    Invoke-Targeted -ScriptBlock {
        param([string]$p)
        if (Test-Path $p) { Remove-Item $p -Recurse -Force -ErrorAction SilentlyContinue }
    } -ArgumentList @($remoteTmpPath) | Out-Null

    Close-TargetSession

    Write-Log "" "INFO"
    if ($result.Success) {
        $verNote = if ($result.DeployedVersion) { " (v$($result.DeployedVersion))" } else { "" }
        Write-Log "=== SUCCESS : $ComputerName -- $svcName$verNote ===" "OK" $ComputerName
        Write-Log "  Backup  : $($result.BackupPath)" "INFO" $ComputerName
        $deployRecord.Success = $true
    }
    else {
        Write-Log "=== FAILED : $ComputerName -- $svcName ===" "ERROR" $ComputerName
        Write-Log "  $($result.Error)" "ERROR" $ComputerName
        $deployRecord.Error        = $result.Error
        $deployRecord.NeedsRollback = $true
    }

    Write-Log "--- Remote log ---" "INFO"
    foreach ($line in $result.Log) { Write-Log "  $line" "INFO" $ComputerName }

    $deployResults.Add($deployRecord)

    # ---- Cluster pause ------------------------------------------------------
    if ($Cluster -and -not $script:quitRequested -and -not $script:rollbackAllReq) {
        $isLast      = ($di -eq ($deployTargets.Count - 1))
        $nextSrv     = if (-not $isLast) { $deployTargets[$di + 1].Server } else { "" }
        $pauseChoice = Invoke-ServerPause `
            -CompletedServer $ComputerName `
            -NextServer      $nextSrv `
            -ServerNum       ($di + 1) `
            -TotalServers    $deployTargets.Count

        if ($pauseChoice -eq "Q") {
            Write-Log "Quit requested at cluster pause." "WARN"
            $script:quitRequested = $true
        }
        elseif ($pauseChoice -eq "R") {
            Write-Log "Rollback-all requested at cluster pause." "WARN"
            $script:rollbackAllReq = $true
        }
        # C / ENTER / anything else -- continue
    }

} # end deployment loop

Write-Log "========== Phase 2 complete ==========" "OK"

# =============================================================================
# PHASE 3 -- ROLLBACK
# =============================================================================

$failedDeployments = @($deployResults | Where-Object { $_.NeedsRollback -eq $true })
$rollbackAll       = $script:rollbackAllReq

if ($failedDeployments.Count -eq 0 -and -not $rollbackAll) {
    Write-Log "All deployments succeeded -- no rollbacks needed." "OK"
}
else {
    if ($rollbackAll) {
        # Also include successful deployments if operator chose rollback-all at pause
        $toRollback = @($deployResults | Where-Object { $_.BackupPath -ne $null })
        Write-Log "Rollback-all requested -- rolling back $($toRollback.Count) server(s)." "WARN"
    }
    else {
        $toRollback = $failedDeployments
        Write-Log "========== Phase 3: Rollback ($($toRollback.Count) failure(s)) ==========" "WARN"
    }

    $doRollbackAll = $rollbackAll

    foreach ($r in $toRollback) {

        $doRollback = $doRollbackAll

        if (-not $doRollback) {
            # Show failure detail and prompt
            $relevantErrors = @(Get-Content $script:LogFile |
                Where-Object { $_ -match "\[ERROR\]" -and $_ -match [regex]::Escape($r.Server) })

            Write-Host ""
            Write-Host "  +============================================================+" -ForegroundColor Red
            Write-Host "  | Deployment failed: $($r.Server) -- $($r.SvcName)" -ForegroundColor Red
            Write-Host "  | Install dir : $($r.InstallDir)" -ForegroundColor Red
            if ($relevantErrors.Count -gt 0) {
                Write-Host "  | Errors:" -ForegroundColor Red
                foreach ($e in $relevantErrors) { Write-Host "  |   $e" -ForegroundColor Red }
            }
            Write-Host "  +============================================================+" -ForegroundColor Red
            Write-Host ""
            Write-Host "  [1] Roll back this server only"
            Write-Host "  [2] Roll back this and all remaining failures automatically"
            Write-Host "  [3] Skip rollback for this server (leave as-is)"
            Write-Host ""
            $choice = (Read-Host "  Enter choice (1/2/3)").Trim()

            switch ($choice) {
                "1" { $doRollback = $true }
                "2" { $doRollback = $true; $doRollbackAll = $true }
                default {
                    Write-Log "Rollback skipped for $($r.Server) $($r.SvcName) by operator." "WARN"
                }
            }
        }

        if (-not $doRollback) { continue }

        Write-Log "Rolling back $($r.Server) -- $($r.SvcName) ..." "WARN" $($r.Server)

        $rbOpened = Open-TargetSession -ComputerName $r.Server
        if (-not $rbOpened) {
            Write-Log "Cannot open session for rollback -- MANUAL INTERVENTION REQUIRED." "ERROR" $r.Server
            continue
        }

        $rbResult = Invoke-Targeted -ScriptBlock $rollbackScript -ArgumentList @(
            $r.SvcName,
            $r.InstallDir,
            $r.BackupPath
        )

        Close-TargetSession

        if ($rbResult.Success) {
            Write-Log "Rollback successful -- $($r.SvcName) restored and running." "OK" $r.Server
            ($deployResults | Where-Object {
                $_.Server -eq $r.Server -and $_.SvcName -eq $r.SvcName
            }) | ForEach-Object { $_.NeedsRollback = $false; $_.Error = "ROLLED BACK" }
        }
        else {
            Write-Log "ROLLBACK FAILED -- $($rbResult.Error) -- MANUAL INTERVENTION REQUIRED." "ERROR" $r.Server
        }

        Write-Log "--- Rollback log ---" "INFO"
        foreach ($line in $rbResult.Log) { Write-Log "  $line" "INFO" $r.Server }
    }
}

# =============================================================================
# FINAL SUMMARY
# =============================================================================

Write-Log "" "INFO"
Write-Log "=======================================" "INFO"
Write-Log "  SUMMARY  ($($deployResults.Count) target(s))" "INFO"
Write-Log "=======================================" "INFO"

foreach ($row in $deployResults) {
    if ($row.Success) {
        $status = "OK"
        $color  = "Green"
        $detail = $row.BackupPath
    }
    elseif ($row.Error -eq "ROLLED BACK") {
        $status = "ROLLED BACK"
        $color  = "Yellow"
        $detail = $row.BackupPath
    }
    else {
        $status = "FAILED"
        $color  = "Red"
        $detail = $row.Error
    }
    Write-Status ("  {0,-42} [{1,-14}] [{2}]  {3}" -f `
        $row.Server, $row.SvcName, $status, $detail) -Color $color
}

Write-Log "=======================================" "INFO"
Write-Log "Log file: $($script:LogFile)" "INFO"
