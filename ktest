# =============================================================================
# Test-OTCSConnection.ps1
# OpenText Content Server 26.1 - Connection & API Diagnostics
# PowerShell 5.1 compatible
# Run this BEFORE the main export script to verify connectivity
# =============================================================================

# -----------------------------------------------------------------------------
# CONFIGURATION - Update these before running
# -----------------------------------------------------------------------------
$BaseUrl  = "https://yourserver/otcs/cs.exe"   # e.g. https://myserver/otcs/cs.exe
$Username = "admin"

# -----------------------------------------------------------------------------
# SECURE PASSWORD PROMPT
# -----------------------------------------------------------------------------
$securePassword = Read-Host -Prompt "Enter password for '$Username'" -AsSecureString
$credential     = New-Object System.Management.Automation.PSCredential($Username, $securePassword)
$Password       = $credential.GetNetworkCredential().Password

# -----------------------------------------------------------------------------
# SSL - uncomment if using self-signed cert
# -----------------------------------------------------------------------------
# Add-Type @"
