# -----------------------------------------------------------------------------
# HELPERS
# -----------------------------------------------------------------------------

function Write-Header {
    param([string]$Title)
    Write-Host ""
    Write-Host "================================================================" -ForegroundColor DarkCyan
    Write-Host "  $Title" -ForegroundColor DarkCyan
    Write-Host "================================================================" -ForegroundColor DarkCyan
}

function Write-Pass   { param([string]$Msg) Write-Host "  [PASS] $Msg" -ForegroundColor Green  }
function Write-Fail   { param([string]$Msg) Write-Host "  [FAIL] $Msg" -ForegroundColor Red    }
function Write-Info   { param([string]$Msg) Write-Host "  [INFO] $Msg" -ForegroundColor Gray   }
function Write-Trying { param([string]$Msg) Write-Host "  [....]  $Msg" -ForegroundColor Yellow }

function Get-ErrorBody {
    param($Exception)
    try {
        $stream = $Exception.Response.GetResponseStream()
        $reader = New-Object System.IO.StreamReader($stream)
        $raw    = $reader.ReadToEnd()
        if ([string]::IsNullOrWhiteSpace($raw)) { return "(empty)" }
        return $raw
    } catch { return "(unreadable)" }
}

function Invoke-Test {
    param(
        [string]$Uri,
        [string]$Method     = "GET",
        [hashtable]$Headers = @{},
        $RequestBody        = $null
    )
    $out = [PSCustomObject]@{ Success=$false; StatusCode=$null; Data=$null; ErrorBody=$null }
    try {
        $params = @{ Uri=$Uri; Method=$Method; Headers=$Headers; ErrorAction="Stop" }
        if ($null -ne $RequestBody) {
            $params.Body        = $RequestBody
            $params.ContentType = "application/x-www-form-urlencoded"
        }
        $out.Data       = Invoke-RestMethod @params
        $out.Success    = $true
        $out.StatusCode = 200
    } catch {
        $out.StatusCode = $_.Exception.Response.StatusCode.value__
        $out.ErrorBody  = Get-ErrorBody $_.Exception
    }
    return $out
}

# =============================================================================
# STEP 1 - AUTHENTICATE
# =============================================================================
Write-Header "STEP 1: Authentication"

$ticket  = $null
$authBody = @{ username = $Username; password = $Password }

Write-Trying "POST $BaseUrl/api/v1/auth"
$r = Invoke-Test -Uri "$BaseUrl/api/v1/auth" -Method POST -RequestBody $authBody

if ($r.Success -and $r.Data.ticket) {
    $ticket = $r.Data.ticket
    Write-Pass "Authenticated OK. Ticket length: $($ticket.Length)"
} else {
    Write-Fail "Authentication failed. Status: $($r.StatusCode) | Body: $($r.ErrorBody)"
    Write-Host ""
    Write-Host "Cannot continue - fix authentication first." -ForegroundColor Red
    exit 1
}

$headers = @{ "OTCSTicket" = $ticket }

# =============================================================================
# STEP 2 - FIND WORKING MEMBERS ENDPOINT
# =============================================================================
Write-Header "STEP 2: Members Endpoint Discovery"

# All endpoint candidates to try - ordered most likely to least likely
$candidates = [ordered]@{
    "v2 where_name wildcard (users)"         = "$BaseUrl/api/v2/members?where_name=*&where_type=0&limit=5"
    "v2 where_name wildcard (groups)"        = "$BaseUrl/api/v2/members?where_name=*&where_type=1&limit=5"
    "v2 where_name wildcard (no type)"       = "$BaseUrl/api/v2/members?where_name=*&limit=5"
    "v2 where_type=0 only (users)"           = "$BaseUrl/api/v2/members?where_type=0&limit=5"
    "v2 where_type=1 only (groups)"          = "$BaseUrl/api/v2/members?where_type=1&limit=5"
    "v2 no filter"                           = "$BaseUrl/api/v2/members?limit=5"
    "v1 type=0 (users)"                      = "$BaseUrl/api/v1/members?type=0&limit=5"
    "v1 type=1 (groups)"                     = "$BaseUrl/api/v1/members?type=1&limit=5"
    "v1 no filter"                           = "$BaseUrl/api/v1/members?limit=5"
    "v2 search where_name=admin"             = "$BaseUrl/api/v2/members?where_name=$Username&limit=5"
    "v1 search where_name=admin"             = "$BaseUrl/api/v1/members?where_name=$Username&limit=5"
}

$workingUsers  = $null
$workingGroups = $null

foreach ($label in $candidates.Keys) {
    $uri = $candidates[$label]
    Write-Trying "$label"
    Write-Info   "URI: $uri"

    $r = Invoke-Test -Uri $uri -Headers $headers

    if ($r.Success) {
        Write-Pass "$label -- STATUS 200"

        # Show raw response shape
        $json = $r.Data | ConvertTo-Json -Depth 4
        Write-Host ""
        Write-Host "  --- RAW RESPONSE ---" -ForegroundColor Yellow
        Write-Host $json -ForegroundColor White
        Write-Host "  --------------------" -ForegroundColor Yellow
        Write-Host ""

        # Record first working user/group endpoint
        if ($label -match "user" -and -not $workingUsers)  { $workingUsers  = $uri }
        if ($label -match "group" -and -not $workingGroups) { $workingGroups = $uri }
        if (-not $workingUsers -and -not $workingGroups)   {
            $workingUsers  = $uri
            $workingGroups = $uri -replace "where_type=0","where_type=1"
        }

    } else {
        Write-Fail "$label -- STATUS $($r.StatusCode) | Body: $($r.ErrorBody)"
    }
}

# =============================================================================
# STEP 3 - TEST GROUP MEMBERS LOOKUP
# =============================================================================
Write-Header "STEP 3: Group Members Lookup"
Write-Info "Attempting to find a group ID to test membership retrieval..."

# Try to grab any group ID from earlier results
$groupId = $null
$groupTests = @(
    "$BaseUrl/api/v2/members?where_name=*&where_type=1&limit=1",
    "$BaseUrl/api/v2/members?where_type=1&limit=1",
    "$BaseUrl/api/v1/members?type=1&limit=1"
)

foreach ($uri in $groupTests) {
    $r = Invoke-Test -Uri $uri -Headers $headers
    if ($r.Success) {
        # Try to extract a group ID from whatever shape comes back
        if ($r.Data.results -and $r.Data.results.Count -gt 0) {
            $first = $r.Data.results[0]
            if ($first.data.properties) { $groupId = $first.data.properties.id }
            elseif ($first.data)        { $groupId = $first.data.id }
            elseif ($first.id)          { $groupId = $first.id }
        } elseif ($r.Data.data -and $r.Data.data.Count -gt 0) {
            $groupId = $r.Data.data[0].id
        }
        if ($groupId) { break }
    }
}

if ($groupId) {
    Write-Info "Found group ID: $groupId - testing membership endpoint..."

    $memberTests = @(
        "$BaseUrl/api/v2/members/$groupId/members?limit=5",
        "$BaseUrl/api/v1/members/$groupId/members?limit=5"
    )

    foreach ($uri in $memberTests) {
        Write-Trying $uri
        $r = Invoke-Test -Uri $uri -Headers $headers
        if ($r.Success) {
            Write-Pass "Group members endpoint works: $uri"
            $json = $r.Data | ConvertTo-Json -Depth 4
            Write-Host $json -ForegroundColor White
        } else {
            Write-Fail "Status $($r.StatusCode) | Body: $($r.ErrorBody)"
        }
    }
} else {
    Write-Info "Could not extract a group ID - skipping membership test."
    Write-Info "This is OK if no groups exist or no endpoint worked in Step 2."
}

# =============================================================================
# SUMMARY
# =============================================================================
Write-Header "SUMMARY & RECOMMENDED SETTINGS"

Write-Host ""
if ($workingUsers) {
    Write-Host "  Recommended BaseUrl    : $BaseUrl"             -ForegroundColor Green
    Write-Host "  Working users endpoint : $workingUsers"         -ForegroundColor Green
    Write-Host "  Working groups endpoint: $workingGroups"        -ForegroundColor Green
    Write-Host ""
    Write-Host "  Paste these into Get-OTCSUsersAndGroups.ps1"   -ForegroundColor Yellow
} else {
    Write-Host "  No working members endpoint found." -ForegroundColor Red
    Write-Host "  Review the FAIL messages above and check with your OTCS admin." -ForegroundColor Yellow
    Write-Host "  Key things to verify:" -ForegroundColor Yellow
    Write-Host "    - Does your account have 'Public Access' or admin rights in OTCS?" -ForegroundColor White
    Write-Host "    - Is the REST API licensed and enabled on this server?"             -ForegroundColor White
    Write-Host "    - Is there a WAF or reverse proxy blocking certain query params?"   -ForegroundColor White
}
Write-Host ""
