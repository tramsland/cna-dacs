<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <handlers>
            <add name="BonCode-Tomcat-WC-Handler" path="*" verb="*" type="BonCodeIIS.BonCodeCallHandler" preCondition="integratedMode" />
        </handlers>
        <httpProtocol>
            <customHeaders>
                <remove name="Strict-Transport-Security" />
                <remove name="X-Powered-By" />
                <add name="Strict-Transport-Security" value="max-age=31536000" />
            </customHeaders>
        </httpProtocol>
        <security>
            <requestFiltering allowDoubleEscaping="true">
                <requestLimits maxAllowedContentLength="2147483648" maxUrl="8192" maxQueryString="4096" />
                <verbs allowUnlisted="false" />
            </requestFiltering>
        </security>
        <urlCompression doStaticCompression="false" doDynamicCompression="false" />
        <caching enabled="false" enableKernelCache="true" />
        <staticContent>
            <clientCache cacheControlMode="DisableCache" />
        </staticContent>
        <rewrite>
            <outboundRules>
                <remove name="SSL Coockies" />
                <rule name="SSL Coockies" preCondition="Not SSL Cookie" enabled="true">
                    <match serverVariable="RESPONSE_Set_Cookie" pattern=".*" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="true" />
                    <action type="Rewrite" value="{R:0} ;secure" />
                </rule>
            </outboundRules>
        </rewrite>
   </system.webServer>
   <system.web>
        <customErrors mode="Off" />
        <httpRuntime requestValidationMode="2.0" maxUrlLength="8192" requestPathInvalidCharacters="" executionTimeout="7200" maxRequestLength="2147483647" />
        <sessionState timeout="40" />
    </system.web>
</configuration>


<rewrite>
  <rules>
    <rule name="demo-readydocs-to-13200" stopProcessing="true">
      <match url="^demo/readydocs(.*)" />
      <action type="Rewrite"
              url="https://AZASVWSR046.PUBLIC.DLA.MIL:1320/demo/readydocs/{R:1}" />
    </rule>
  </rules>
</rewrite>
