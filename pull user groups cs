# ═══════════════════════════════════════════════════════════════

Write-Log "══════════════════════════════════════════════" "INFO"
Write-Log " STEP 1: COMPLETE                             " "SUCCESS"
Write-Log "══════════════════════════════════════════════" "INFO"
Write-Log "  Users extracted       : $($csUsers.Count)"        "SUCCESS"
Write-Log "  Groups extracted      : $($csGroups.Count)"       "SUCCESS"
Write-Log "  Memberships extracted : $($csMemberships.Count)"  "SUCCESS"
Write-Log "  Output folder         : $OutputPath"              "SUCCESS"
Write-Log "  Log file              : $LogFile"                  "SUCCESS"
Write-Log "══════════════════════════════════════════════" "INFO"
Write-Log "  Review CSV files then run Step 2 (OTDS Extract)" "INFO"
Write-Log "══════════════════════════════════════════════" "INFO"
