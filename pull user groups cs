# ═══════════════════════════════════════════════════════════════
# STEP 1: Extract all Users, Groups and Memberships from Content Server
# Version  : 3.0 - Secure credential prompt, CS API v2
# PS Ver   : 5.1 Compatible
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────
# Configuration
# ─────────────────────────────────────────

$CS_Host        = "https://www.stage.private.dacs.dla.mil/dcaa/cs"
$CS_UserDefault = "Admin"
$OutputPath     = ".\OTDS_Migration\Step1_CS_Extract"
$LogFile        = ".\OTDS_Migration\Step1_CS_Extract\Step1.log"
$PageLimit      = 100

# ─────────────────────────────────────────
# Setup - Create output folder
# ─────────────────────────────────────────

if (-not (Test-Path $OutputPath)) {
    New-Item -ItemType Directory -Force -Path $OutputPath | Out-Null
}

# ─────────────────────────────────────────
# Helper: Write-Log
# ─────────────────────────────────────────

function Write-Log {
    param(
        [string]$Message,
        [ValidateSet("INFO","WARN","ERROR","SUCCESS")]
        [string]$Level = "INFO"
    )
    $line = "[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] [$Level] $Message"
    Add-Content -Path $LogFile -Value $line
    switch ($Level) {
        "INFO"    { Write-Host $line -ForegroundColor Cyan }
        "WARN"    { Write-Host $line -ForegroundColor Yellow }
        "ERROR"   { Write-Host $line -ForegroundColor Red }
        "SUCCESS" { Write-Host $line -ForegroundColor Green }
    }
}

# ─────────────────────────────────────────
# Helper: Get-Credentials
# ─────────────────────────────────────────

function Get-Credentials {
    param([string]$SystemName, [string]$DefaultUser)

    Write-Host ""
    Write-Host "  [$SystemName] Enter credentials" -ForegroundColor Cyan
    Write-Host "  ─────────────────────────────────" -ForegroundColor DarkGray

    $user = Read-Host "  Username [$DefaultUser]"
    if ([string]::IsNullOrWhiteSpace($user)) { $user = $DefaultUser }

    $securePwd = Read-Host "  Password" -AsSecureString

    if ($securePwd.Length -eq 0) {
        Write-Host "  Password cannot be blank." -ForegroundColor Red
        exit 1
    }

    $plainPwd = [System.Runtime.InteropServices.Marshal]::PtrToStringAuto(
                    [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($securePwd)
                )

    Write-Host ""
    return @{ Username = $user; Password = $plainPwd }
}

# ─────────────────────────────────────────
# Helper: Invoke-CSRestCall
# ─────────────────────────────────────────

function Invoke-CSRestCall {
    param(
        [string]$Uri,
        [string]$Method = "GET",
        [hashtable]$Headers,
        [string]$Body = $null,
        [string]$Description = "API Call"
    )

    Write-Log "Calling [$Method] $Uri - $Description"

    try {
        $params = @{
            Uri     = $Uri
            Method  = $Method
            Headers = $Headers
        }

        if ($Body) {
            $params.Body        = $Body
            $params.ContentType = "application/json"
        }

        $response = Invoke-RestMethod @params
        Write-Log "[$Description] succeeded" "SUCCESS"
        return $response

    } catch [System.Net.WebException] {
        $statusCode = [int]$_.Exception.Response.StatusCode
        $statusDesc = $_.Exception.Response.StatusDescription
        Write-Log "[$Description] HTTP Error $statusCode - $statusDesc" "ERROR"
        Write-Log "URI was: $Uri" "ERROR"

        try {
            $reader  = New-Object System.IO.StreamReader($_.Exception.Response.GetResponseStream())
            $errBody = $reader.ReadToEnd()
            Write-Log "Response body: $errBody" "ERROR"
        } catch {
            Write-Log "Could not read error response body" "WARN"
        }
        return $null

    } catch {
        Write-Log "[$Description] Unexpected error: $($_.Exception.Message)" "ERROR"
        Write-Log "Stack trace: $($_.ScriptStackTrace)" "ERROR"
        return $null
    }
}

# ─────────────────────────────────────────
# Helper: Disable-SSLValidation
# ─────────────────────────────────────────

function Disable-SSLValidation {
    Write-Log "Disabling SSL validation - FOR TEST/DEV USE ONLY" "WARN"
    try {
        Add-Type @"
        using System.Net;
        using System.Security.Cryptography.X509Certificates;
        public class TrustAllCerts3 : ICertificatePolicy {
            public bool CheckValidationResult(
                ServicePoint srvPoint, X509Certificate certificate,
                WebRequest request, int certificateProblem) { return true; }
        }
"@
        [System.Net.ServicePointManager]::CertificatePolicy = New-Object TrustAllCerts3
    } catch {
        Write-Log "SSL bypass already applied: $($_.Exception.Message)" "WARN"
    }
    [System.Net.ServicePointManager]::SecurityProtocol = `
        [System.Net.SecurityProtocolType]::Tls12 -bor `
        [System.Net.SecurityProtocolType]::Tls11 -bor `
        [System.Net.SecurityProtocolType]::Tls
}

# ─────────────────────────────────────────
# Helper: Export-ToCsv
# ─────────────────────────────────────────

function Export-ToCsv {
    param(
        [array]$Data,
        [string]$FilePath,
        [string]$Description
    )
    try {
        if ($Data.Count -eq 0) {
            Write-Log "No data to export for: $Description" "WARN"
            return
        }
        $Data | Export-Csv -Path $FilePath -NoTypeInformation -Encoding UTF8
        Write-Log "Exported $($Data.Count) rows to $FilePath" "SUCCESS"
    } catch {
        Write-Log "Failed to export $Description : $($_.Exception.Message)" "ERROR"
    }
}

# ─────────────────────────────────────────
# Helper: Get-CSMembersPaged
# ─────────────────────────────────────────

function Get-CSMembersPaged {
    param(
        [string]$BaseUrl,
        [hashtable]$Headers,
        [string]$Description
    )

    $allResults = @()
    $page       = 1
    $pageTotal  = 1
    $keepGoing  = $true

    while ($keepGoing) {
        $url      = "$BaseUrl&page=$page"
        $response = Invoke-CSRestCall `
            -Uri         $url `
            -Method      "GET" `
            -Headers     $Headers `
            -Description "$Description page $page"

        if (-not $response) {
            Write-Log "Null response on page $page for $Description. Stopping." "ERROR"
            $keepGoing = $false

        } elseif (-not $response.results -or $response.results.Count -eq 0) {
            Write-Log "No results on page $page for $Description. Done." "INFO"
            $keepGoing = $false

        } else {
            if ($page -eq 1) {
                $pageTotal  = $response.collection.paging.page_total
                $totalCount = $response.collection.paging.total_count
                Write-Log "$Description — total records: $totalCount across $pageTotal pages" "INFO"
            }

            $allResults += $response.results
            Write-Log "  Page $page/$pageTotal — fetched $($response.results.Count) records (running total: $($allResults.Count))" "INFO"

            if ($page -ge $pageTotal) {
                Write-Log "Last page reached for $Description." "INFO"
                $keepGoing = $false
            } else {
                $page++
            }
        }
    }

    return $allResults
}

# ═══════════════════════════════════════════════════════════════
# START
# ═══════════════════════════════════════════════════════════════

Write-Host ""
Write-Host "  ═══════════════════════════════════════════════" -ForegroundColor DarkCyan
Write-Host "   OTDS Migration - Step 1: Content Server Extract" -ForegroundColor Cyan
Write-Host "   Version 3.0  |  PS 5.1 Compatible             " -ForegroundColor DarkGray
Write-Host "  ═══════════════════════════════════════════════" -ForegroundColor DarkCyan
Write-Host ""

# Prompt for credentials before logging starts
$csCreds = Get-Credentials -SystemName "Content Server" -DefaultUser $CS_UserDefault
$CS_User = $csCreds.Username
$CS_Pass = $csCreds.Password

Write-Log "══════════════════════════════════════════════" "INFO"
Write-Log " STEP 1: Content Server Extract - Started     " "INFO"
Write-Log "══════════════════════════════════════════════" "INFO"
Write-Log "CS Host     : $CS_Host"    "INFO"
Write-Log "CS User     : $CS_User"    "INFO"
Write-Log "Output Path : $OutputPath" "INFO"
Write-Log "Page Limit  : $PageLimit"  "INFO"

Disable-SSLValidation

# ─────────────────────────────────────────
# Authenticate
# ─────────────────────────────────────────

Write-Log "Authenticating with Content Server..." "INFO"

$authBody = @{
    username = $CS_User
    password = $CS_Pass
} | ConvertTo-Json

$authResponse = Invoke-CSRestCall `
    -Uri         "$CS_Host/api/v1/auth" `
    -Method      "POST" `
    -Headers     @{ "Content-Type" = "application/json" } `
    -Body        $authBody `
    -Description "CS Authentication"

# Clear password from memory as soon as auth is done
$CS_Pass = $null
[System.GC]::Collect()

if (-not $authResponse -or -not $authResponse.ticket) {
    Write-Log "Authentication failed. Check username and password." "ERROR"
    exit 1
}

$csTicket  = $authResponse.ticket
$csHeaders = @{
    "OTCSTicket"   = $csTicket
    "Content-Type" = "application/json"
}

Write-Log "Authentication successful. Ticket acquired." "SUCCESS"

# ─────────────────────────────────────────
# Extract Users
# ─────────────────────────────────────────

Write-Log "──────────────────────────────────────────" "INFO"
Write-Log "Extracting Users from Content Server..."    "INFO"
Write-Log "──────────────────────────────────────────" "INFO"

$csUsersRaw = Get-CSMembersPaged `
    -BaseUrl     "$CS_Host/api/v2/members?where_type=0&limit=$PageLimit" `
    -Headers     $csHeaders `
    -Description "CS Users"

Write-Log "Total CS Users extracted: $($csUsersRaw.Count)" "SUCCESS"

$csUsersFlat = $csUsersRaw | ForEach-Object {
    $p = $_.data.properties
    [PSCustomObject]@{
        CS_ID      = $p.id
        Name       = $p.name
        FirstName  = $p.first_name
        LastName   = $p.last_name
        Email      = $p.business_email
        Deleted    = $p.deleted
        Department = $p.group_id
        Title      = $p.title
    }
}

Export-ToCsv -Data $csUsersFlat -FilePath "$OutputPath\CS_Users.csv" -Description "CS Users"

# ─────────────────────────────────────────
# Extract Groups
# ─────────────────────────────────────────

Write-Log "──────────────────────────────────────────" "INFO"
Write-Log "Extracting Groups from Content Server..."   "INFO"
Write-Log "──────────────────────────────────────────" "INFO"

$csGroupsRaw = Get-CSMembersPaged `
    -BaseUrl     "$CS_Host/api/v2/members?where_type=1&limit=$PageLimit" `
    -Headers     $csHeaders `
    -Description "CS Groups"

Write-Log "Total CS Groups extracted: $($csGroupsRaw.Count)" "SUCCESS"

$csGroupsFlat = $csGroupsRaw | ForEach-Object {
    $p = $_.data.properties
    [PSCustomObject]@{
        CS_ID   = $p.id
        Name    = $p.name
        Deleted = $p.deleted
        Type    = $p.type
    }
}

Export-ToCsv -Data $csGroupsFlat -FilePath "$OutputPath\CS_Groups.csv" -Description "CS Groups"

# ─────────────────────────────────────────
# Extract Group Memberships
# ─────────────────────────────────────────

Write-Log "──────────────────────────────────────────────────" "INFO"
Write-Log "Extracting Group Memberships..."                    "INFO"
Write-Log "$($csGroupsRaw.Count) groups to process — this may take a while" "WARN"
Write-Log "──────────────────────────────────────────────────" "INFO"

$csMemberships = @()
$groupCount    = 0
$groupTotal    = $csGroupsRaw.Count
$skippedCount  = 0
$errorCount    = 0

foreach ($group in $csGroupsRaw) {
    $groupCount++
    $p         = $group.data.properties
    $groupName = $p.name
    $groupID   = $p.id

    # Skip deleted groups
    if ($p.deleted -eq $true) {
        Write-Log "[$groupCount/$groupTotal] SKIPPING deleted group: $groupName (ID: $groupID)" "WARN"
        $skippedCount++
        continue
    }

    Write-Log "[$groupCount/$groupTotal] Fetching members for: $groupName (ID: $groupID)" "INFO"

    $membersRaw = Get-CSMembersPaged `
        -BaseUrl     "$CS_Host/api/v2/members/$groupID/members?limit=$PageLimit" `
        -Headers     $csHeaders `
        -Description "Members of $groupName"

    if ($membersRaw -eq $null) {
        Write-Log "Failed to get members for group: $groupName (ID: $groupID)" "ERROR"
        $errorCount++
        continue
    }

    if ($membersRaw.Count -eq 0) {
        Write-Log "  -> Group '$groupName' has no members" "INFO"
        continue
    }

    foreach ($member in $membersRaw) {
        $mp = $member.data.properties
        $csMemberships += [PSCustomObject]@{
            GroupID    = $groupID
            GroupName  = $groupName
            MemberID   = $mp.id
            MemberName = $mp.name
            MemberType = if ($mp.type -eq 0) { "User" } else { "Group" }
            Deleted    = $mp.deleted
        }
    }

    Write-Log "  -> Added $($membersRaw.Count) members for '$groupName'" "INFO"
}

Write-Log "Total CS Memberships extracted: $($csMemberships.Count)" "SUCCESS"

Export-ToCsv -Data $csMemberships -FilePath "$OutputPath\CS_Memberships.csv" -Description "CS Memberships"

# ═══════════════════════════════════════════════════════════════
# SUMMARY
# ═══════════════════════════════════════════════════════════════

Write-Log "══════════════════════════════════════════════" "INFO"
Write-Log " STEP 1: COMPLETE                             " "SUCCESS"
Write-Log "══════════════════════════════════════════════" "INFO"
Write-Log "  Users extracted       : $($csUsersFlat.Count)"   "SUCCESS"
Write-Log "  Groups extracted      : $($csGroupsFlat.Count)"  "SUCCESS"
Write-Log "  Groups skipped        : $skippedCount"           "WARN"
Write-Log "  Groups with errors    : $errorCount"             "$(if ($errorCount -gt 0) {'WARN'} else {'SUCCESS'})"
Write-Log "  Memberships extracted : $($csMemberships.Count)" "SUCCESS"
Write-Log "  Output folder         : $OutputPath"             "SUCCESS"
Write-Log "  Log file              : $LogFile"                 "SUCCESS"
Write-Log "══════════════════════════════════════════════" "INFO"
Write-Log "  Files produced:"                                  "INFO"
Write-Log "  |-- CS_Users.csv"                                 "INFO"
Write-Log "  |-- CS_Groups.csv"                                "INFO"
Write-Log "  |-- CS_Memberships.csv"                           "INFO"
Write-Log "  +-- Step1.log"                                    "INFO"
Write-Log "══════════════════════════════════════════════" "INFO"
Write-Log "  Review CSV files then run Step 2"                 "INFO"
Write-Log "══════════════════════════════════════════════" "INFO"
